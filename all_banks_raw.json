ttps://alif.tj/ru/cards/all?rs=alif.tj_Gpay_mastercard\",\"desktopImage\":{\"documentId\":\"vjweyxph5dtca436bhz4oiuv\",\"alternativeText\":\"Карточка Alif для мгновенных переводов и удобной оплаты за рубежом – оформить карту онлайн\",\"name\":\"platinum mini banner.png\",\"width\":448,\"height\":368,\"url\":\"/uploads/platinum_mini_banner_3afddb831c.png\"},\"mobileImage\":{\"documentId\":\"lej4ktobhz1l0uyc9osp76x8\",\"alternativeText\":\"Карточка Alif для мгновенных переводов и удобной оплаты за рубежом – оформить карту онлайн\",\"name\":\"platinum mini banner mob.png\",\"width\":320,\"height\":208,\"url\":\"/uploads/platinum_mini_banner_mob_60eac3f054.png\"}},\"faq\":{\"title\":\"Ҷавоб ба саволҳои муҳим\",\"content\":[{\"id\":\"690\",\"title\":\"Кадом кортҳоро ба Google Pay пайваст карда мумкин?\",\"description\":\"<p>Танҳо кортҳои байналмиллалӣ қабул мешаванд.</p>\"},{\"id\":\"692\",\"title\":\"Оё ҳамаи соҳибони телефони Android метавонанд кортро пайваст кунанд?\",\"description\":\"<p>Барои истифодабарии Google Pay телефон бояд модули NFC дошта бошад ва системаи оператсионии он Android 5.0 ё болотар бошад.</p>\"},{\"id\":\"691\",\"title\":\"Пулро аз банкомат бе корт гирифта мешавад?\",\"description\":\"<p>Мешавад. Муҳим аст, ки дар банкомат нишонаи NFC бошад.</p><p>Телефонро фаъол кунед.<br>Ба банкомат онро наздик кунед.<br>PIN-рамзи кортро ворид намоед.<br>Дастурамале, ки дар банкомат пайдо мешавад, пайгирӣ намоед.</p>\"}]},\"locales\":[\"tg\",\"ru\",\"en\"],\"locale\":\"tg\"},\"__N_SSG\":true}"
