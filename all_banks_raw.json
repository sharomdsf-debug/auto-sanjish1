 \"APPLY_BUTTON\": \"Дархост равон кунед\",\r\n      \"DETAILS_BUTTON\": \"Маълумоти бештар\"\r\n    }\r\n  },\r\n  \"CREDIT_DETAILS\": {\r\n    \"SECTIONS\": {\r\n      \"TARIFFS_AND_CONDITIONS\": \"Тарофаҳо ва шартҳо\",\r\n      \"REQUIRED_DOCUMENTS\": \"Ҳуҷҷатҳои зарурӣ\",\r\n      \"ONLINE_APPLICATION\": \"Онлайн-дархости қарз\"\r\n    },\r\n    \"APPLICATION_FORM\": {\r\n      \"AMOUNT_LABEL\": \"Маблағи қарз\",\r\n      \"TERM_LABEL\": \"Муҳлати қарз\",\r\n      \"PRELIMINARY_CALC_DISCLAIMER\": \"Ҳама ҳисобҳо пешакӣ мебошанд ва метавонанд аз натиҷаҳои воқеӣ фарқ кунанд.\",\r\n      \"NO_WORKPLACE_DISCLAIMER\": \"Агар шумо ҷои кори доимӣ надошта бошед, метавонед ин майдонро холӣ гузоред.\",\r\n      \"FULL_NAME_PLACEHOLDER\": \"Ному насаб\",\r\n      \"PHONE_PLACEHOLDER\": \"Телефони мобилӣ\",\r\n      \"PURPOSE_PLACEHOLDER\": \"Мақсади қарз\",\r\n      \"WORKPLACE_PLACEHOLDER\": \"Ҷои кор ва суроға\",\r\n      \"OFFICE_PLACEHOLDER\": \"Офисро интихоб кунед\"\r\n    },\r\n    \"RESULTS\": {\r\n      \"MONTHLY_PAYMENT_LABEL\": \"Пардохти барзиёд\",\r\n      \"INTEREST_RATE_LABEL\": \"Меъёри фоизӣ\",\r\n      \"ONLINE_APPLICATION_INFO\": \"Дархостҳои онлайнӣ дар рӯзҳои корӣ аз соати 8:00 то 17:00 қабул ва баррасӣ мешаванд.\"\r\n    }\r\n  },\r\n  \"CONTACTS_PAGE\": {\r\n    \"TITLE\": \"Тамос\",\r\n    \"SUBTITLE\": \"Бо мо тамос гиред — мо ҳамеша дар алоқаем ва омодаи кӯмакем.\",\r\n    \"INFO_WINDOW\": {\r\n      \"PHONE_LABEL\": \"Телефон\"\r\n    }\r\n  },\r\n  \"ABOUT_US\": {\r\n    \"MAIN_TITLE\": \"ҶСК «Коммерсбонки Тоҷикистон» — яке аз бонкҳои боэътимод ва босуръат рушдкунандаи кишвар\",\r\n    \"CARDS\": {\r\n      \"MISSION\": {\r\n        \"TITLE\": \"Вазифаи мо\",\r\n        \"TEXT\": \"Мо ҳалли молиявии боэътимод, дастрас ва муосирро таъмин менамоем...\"\r\n      },\r\n      \"GOAL\": {\r\n        \"TITLE\": \"Мақсади мо\",\r\n        \"TEXT\": \"Мақсади мо — шарики боэътимод будан барои ҳар касе, ки ба суботи молиявӣ мекӯшад...\"\r\n      },\r\n      \"VISION\": {\r\n        \"TITLE\": \"Дидгоҳи мо\",\r\n        \"TEXT\": \"Пешбарандаи инноватсияҳои молиявӣ ва шарики боэътимод барои мизоҷон будан...\"\r\n      }\r\n    },\r\n    \"HISTORY\": {\r\n      \"TITLE\": \"Таърихи мо\",\r\n      \"P1\": \"Таърихи мо — ин қисса дар бораи рушд, эътимод ва талоши пайваста барои камол аст. Аз рӯзҳои аввал мо барои худ як ҳадафи равшан гузоштем: то хизматрасониҳои бонкӣ барои ҳар як шаҳрванди кишварамон дастрас, фаҳмо ва боэътимод бошанд.\",\r\n      \"P2\": \"Сафари мо соли 2006 бо таъсиси ташкилоти қарздиҳии хурд бо номи ҶДММ «Музаффарият» оғоз ёфт. Аз аввал мо ба эътимоди мизоҷон такя мекардем — бо нияти кумак ва дастгирии молиявӣ ба ҳар касе, ки ба он ниёз дошт.\",\r\n      \"P3\": \"Соли 2016 марҳилаи нави рушд фаро расид: мо ребрендинг гузаронидем ва ба ҶДММ ТҚХ «Фардо» табдил ёфтем. Ин ном рамзи орзуҳои бузург, имкониятҳои нав ва стратегияи равона ба рушди устувор гардид.\",\r\n      \"P4\": \"Соли 2017 саҳифаи тозаи таърихи мо боз шуд — мо расман мақоми бонкро гирифтем ва бо номи «Коммерсбонки Тоҷикистон» шинохта шудем. Имрӯз ин ном рамзи эътимод, устуворӣ ва пешрафти мост.\",\r\n      \"P5\": \"Аз он замон мо на танҳо рушд кардем — балки ҳамроҳи мизоҷони худ пеш рафтем. Мо пайваста навовариҳоро ҷорӣ мекунем, ҳалли рақамии муосир месозем ва мекӯшем, то ҳар як ҳамкорӣ бо бонк осон, қулай ва шаффоф бошад.\",\r\n      \"P6\": \"Яке аз самтҳои асосии стратегияи мо — рақамисозӣ аст. Мо фаъолона маҳсулотеро пешниҳод менамоем, ки хизматрасониро содда ва дастрас мегардонад: Платформаи технологии «Фаврӣ» ба шахсони воқеӣ ва ҳуқуқӣ имкон медиҳад, ки амалиёти бонкиро пурра онлайн анҷом диҳанд.\",\r\n      \"P7\": \"Мо ифтихор мекунем, ки «Коммерсбонки Тоҷикистон» имрӯз ҷузъи ҷудонашавандаи ояндаи рақамии кишвар аст — фарҳанги пардохтҳои ғайринақдиро рушд медиҳад ва хизматрасониҳои молиявиро барои ҳар як шаҳрванд дастрас месозад.\",\r\n      \"P8\": \"Имрӯз «Коммерсбонки Тоҷикистон» на танҳо як ташкилоти молиявӣ мебошад. Ин — ҳамсафари боэътимод аст, ки дар корҳои мардум, орзуҳо ва нақшаҳои онҳо ҳамроҳ аст. Мо рушди соҳибкории хурду миёнаро дастгирӣ мекунем, ба оилаҳо дар расидан ба ҳадафҳояшон кумак мерасонем ва боварӣ дорем, ки суботи молиявӣ аз эътимод оғоз меёбад.\",\r\n      \"P9\": \"Имрӯз бонк зиёда аз 60 маркази хизматрасонӣ ва 11 филиал дар саросари кишварро муттаҳид мекунад. Аммо қувваи асосии мо — дастаи мо ва мизоҷонамонанд. Мо бонкеро месозем, ки танҳо дар бораи пул нест. Мо бонкеро месозем, ки дар бораи одамон, боварӣ ва оянда аст.\"\r\n    }\r\n  },\r\n  \"CARDS_PAGE\": {\r\n    \"TITLE\": \"Кортҳои бонкӣ\"\r\n  },\r\n  \"CARD_DETAILS\": {\r\n    \"TABS\": {\r\n      \"SERVICES\": \"Хизматрасониҳо\",\r\n      \"LIMITS\": \"Маҳдудиятҳо\",\r\n      \"OPERATIONS\": \"Амалиётҳо\",\r\n      \"DOCUMENTS\": \"Ҳуҷҷатҳои муфид\"\r\n    },\r\n    \"ACCOUNTS\": {\r\n      \"TJS\": \"Ҳисоби TJS\",\r\n      \"RUB\": \"Ҳисоби RUB\",\r\n      \"USD\": \"Ҳисоби USD\"\r\n    },\r\n    \"APPLICATION_FORM\": {\r\n      \"TITLE\": \"Дархост барои корти бонкӣ\",\r\n      \"SUBTITLE\": \"Тамосҳои худро гузоред, ва мо ҳатман бо шумо тамос мегирем\",\r\n      \"PHONE_PLACEHOLDER\": \"Телефони мобилӣ\",\r\n      \"NAME_PLACEHOLDER\": \"Ному насаб\",\r\n      \"OFFICE_PLACEHOLDER\": \"Офисро интихоб кунед\"\r\n    }\r\n  },\r\n  \"CALCULATOR\": {\r\n    \"TABS\": {\r\n      \"CREDIT\": \"Қарз\",\r\n      \"DEPOSIT\": \"Амонат\",\r\n      \"CAR_PURCHASE\": \"Хариди автомобил\",\r\n      \"RASSROCHKA\": \"Насия\"\r\n    }\r\n  },\r\n  \"CALCULATORS\": {\r\n    \"COMMON\": {\r\n      \"CURRENCY\": \"Асъор\",\r\n      \"TJS\": \"Сомонӣ\",\r\n      \"USD\": \"Доллари ИМА\",\r\n      \"ANNUAL_RATE\": \"Меъёри солона\",\r\n      \"INTEREST_RATE\": \"Меъёри фоиз\",\r\n      \"MONTHS\": \"моҳ\",\r\n      \"YOUR_OFFER\": \"Пешниҳоди мо\",\r\n      \"MONTHLY_PAYMENT\": \"Пардохти ҳармоҳа\",\r\n      \"APPLY_BUTTON\": \"Дархост гузоштан\",\r\n      \"DISCLAIMER\": \"Ҳамаи ҳисоббаробаркуниҳо пешакӣ буда, метаво