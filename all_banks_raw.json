ома тугмаи \\\"Download\\\"-ро пахш кунед.\",\n  \"tawhidpayPageTextTwentyFour\": \"Бо ворид кардани рақами телефони худ сабти ном кунед\",\n  \"tawhidpayPageTextTwentyFive\": \"Табрик мекунем! Ҳама омода аст.\",\n  \"tawhidpayPageTextTwentySix\": \"Шумо метавонед барномаро истифода баред.\",\n  \"tawhidpayPageTextTwentySeven\": \"Саволҳои маъмул\",\n  \"faqPageTextOne\": \"Чӣ тавр мо ба шумо кӯмак карда метавонем?\",\n  \"faqPageTextTwo\": \"Дар ин ҷо шумо ба саволҳои худ ҷавоб хоҳед ёфт\",\n  \"faqPageTextThree\": \"Ҷустуҷӯ\",\n  \"faqPageTextFour\": \"Маблағгузорӣ\",\n  \"faqPageTextFive\": \"Амонатҳо\",\n  \"faqPageTextSix\": \"Суратҳисобҳо\",\n  \"faqPageTextSeven\": \"Кортҳо\",\n  \"faqPageTextEight\": \"Интиқоли пулӣ\",\n  \"faqPageTextNine\": \"Tawhidpay\",\n  \"faqPageTextTen\": \"Мубодилаи асъор\",\n  \"faqPageTextEleven\": \"Тавҳидбонк\",\n  \"faqPageTextTwelve\": \"Кор дар бонк\",\n  \"faqPageTextThirteen\": \"Саволу ҷавоб\",\n  \"mainBusinessTextOne\": \"Сарфа намоед то\",\n  \"mainBusinessTextTwo\": \"оид ба хизматрасонии суратҳисоби ҷорӣ\",\n  \"mainBusinessTextThree\": \"бо имконоти иловагӣ барои пардохт ва интиқол\",\n  \"mainBusinessTextFour\": \"Бештар\",\n  \"mainBusinessTextFive\": \"Аз ҳама гуна дастгоҳ кор кунед\",\n  \"mainBusinessTextSix\": \"Интернет-бонкингро дар ҳама гуна веб-браузери ва инчунин дар телефони мобилии худ истифода баред.\",\n  \"mainBusinessTextSeven\": \"Вазифаҳои муҳосибро соддатар мекунем.\",\n  \"mainBusinessTextEight\": \"Барои муҳосиби шумо пардохти маош бе ҳуҷҷатгузории ва кӯшиши иловагӣ осонтар мешавад.\",\n  \"mainBusinessTextNine\": \"Аз ҳар гӯшаи сайёра пайваста бошед.\",\n  \"mainBusinessTextTen\": \"Раванди тиҷорати худро новобаста аз ҷойгиршавии шумо назорат кунед.\",\n  \"mainBusinessTextEleven\": \"Беҳтарин аз бонк\",\n  \"mainBusinessTextTwelve\": \"Эквайринг тиҷоратӣ\",\n  \"mainBusinessTextThirteen\": \"Бо истифода аз POS терминалҳо ва рамзҳои QR ба мизоҷони худ имконоти бештари пардохт пешниҳод кунед ва фурӯшро зиёд кунед\",\n  \"mainBusinessTextFourteen\": \"Хизматрасонии ҳисоббаробаркунӣ ва кассавӣ\",\n  \"mainBusinessTextFifteen\": \"Мубодираи асъор, фармоиши суратҳисоб, интиқоли асъор ва ғайра - ҳама дар дасти шумо\",\n  \"mainBusinessTextSixteen\": \"Муробаҳаи корпоративӣ\",\n  \"mainBusinessTextSeventeen\": \"Муомилоти тиҷоратие, ки дар он бонк бевосита арзиши дороиро баён мекунад ва онро ба муштарӣ мефурӯшад, бо илова кардани фоида ё илова ба он.\",\n  \"mainBusinessTextEighteen\": \"Барои тиҷорат ҳисоби ҷорӣ кушоед\",\n  \"mainBusinessTextNineteen\": \"Дархост\",\n  \"mainBusinessTextTwenty\": \"Шакли зерро пур кунед.\",\n  \"mainBusinessTextTwentyOne\": \"Он камтар аз 2 дақиқа вақт мегирад\",\n  \"mainBusinessTextTwentyTwo\": \"Машварат\",\n  \"mainBusinessTextTwentyThree\": \"Мо ба шумо занг мезанем\",\n  \"mainBusinessTextTwentyFour\": \"ва мо ба ҳама саволҳо ҷавоб медиҳем\",\n  \"mainBusinessTextTwentyFive\": \"Кушодани суратҳисоб\",\n  \"mainBusinessTextTwentySix\": \"Ҳуҷҷатҳоро имзо кунед\",\n  \"mainBusinessTextTwentySeven\": \"ва суратҳисобро истифода баред\",\n  \"mainBusinessTextTwentyEight\": \"Машварат оид ба\",\n  \"mainBusinessTextTwentyNine\": \"маҳсулот\",\n  \"mainBusinessTextThirty\": \"Шаклро пур кунед, то мо бо шумо тамос гирем ва ҳама чизро ба шумо муфассал нақл кунем\",\n  \"mainBusinessTextThirtyOne\": \"Ном насаб\",\n  \"mainBusinessTextThirtyTwo\": \"Номи пурраи худро нависед\",\n  \"mainBusinessTextThirtyThree\": \"Ном ва насабатонро калон ҳарф занед\",\n  \"mainBusinessTextThirtyFour\": \"Рақами мобилӣ\",\n  \"mainBusinessTextThirtyFive\": \"Майдони рақами телефонро пур кунед\",\n  \"mainBusinessTextThirtySix\": \"Майдони рақами телефонро пур кунед (+992999999999)\",\n  \"mainBusinessTextThirtySeven\": \"Фиристодан \",\n  \"mainBusinessTextThirtyEight\": \"Бо пахш намудани тугмаи \",\n  \"mainBusinessTextThirtyNine\": \"Фиристодан\",\n  \"mainBusinessTextForty\": \", Ман ба шартҳои коркарди маълумоти шахсӣ розӣ ҳастам\",\n  \"mainBusinessTextFortyOne\": \"Хизматрасониҳои муфид\",\n  \"mainBusinessTextFortyTwo\": \"Барои тиҷорати шумо\",\n  \"mainBusinessTextFortyThree\": \"Бизнеси худро дар онлайн-бонкинг ва замимаи мобилӣ идора кунед.\",\n  \"mainBusinessTextFortyFour\": \"Бештар\",\n  \"mainBusinessTextFortyFive\": \"Онлайн-\",\n  \"mainBusinessTextFortySix\": \"муҳосибот\",\n  \"mainBusinessTextFortySeven\": \"Ба осонӣ ҳисоби тиҷорати худро идора кунед\",\n  \"mainBusinessTextFortyEight\": \"Гузаштан\",\n  \"mainBusinessTextFortyNine\": \"Аксияҳо ва тахфифҳо\",\n  \"mainBusinessTextFifty\": \"Пешниҳодҳои муфид барои рушди тиҷорати шумо.\",\n  \"mainBusinessTextFiftyOne\": \"Бештар\",\n  \"mainBusinessTextFiftyTwo\": \"Интернет-бонк\",\n  \"mainBusinessTextFiftyThree\": \"Ҳангоми кушодани суратҳисоб тиҷорати онлайнии худро идора кунед. Логин ва пароли шуморо тавассути SMS мефиристем.\",\n  \"mainBusinessTextFiftyFour\": \"Гузаштан\",\n  \"mainBusinessTextFiftyFive\": \"Офисҳо ва банкоматҳо\",\n  \"mainBusinessTextFiftySix\": \"Нишониҳои филиалҳо ва банкоматҳои Бонки  Тавҳидбонк, инчунин рӯйхати банкоматҳои шарик дар харита - соатҳои корӣ, рақамҳои телефон.\",\n  \"mainBusinessTextFiftySeven\": \"Гузаштан\",\n  \"mainBusinessTextFiftyEight\": \"Интернет ва бонкинги мобилӣ\",\n  \"mainBusinessTextFiftyNine\": \"Рақами телефони худро ворид кунед\",\n  \"mainBusinessTextSixty\": \"Ном ва насабатонро ворид кунед\",\n  \"businessAccountsPageTextOne\": \"Суратҳисоби ҷорӣ\",\n  \"businessAccountsPageTextTwo\": \"Интиқолҳо\",\n  \"businessAccountsPageTextThree\": \"Хизматрасонии кассавӣ\",\n  \"businessAccountsPageTextFour\": \"Дигар\",\n  \"businessAccountsPageTextFive\": \"БО МО САР КУНЕД!\",\n  \"businessAccountsPageTextSix\": \"Ҳисоби ҷорӣ кушоед ва аз тарофаҳои муфид истифода баред.\",\n  \"businessAccountsPageTextSeven\": \"Кушодани суратҳисоб\",\n  \"businessAccountsPageTextEight\": \"Имкониятҳои шумо\",\n  \"businessAccountsPageTextNine\": \"Пурнамоӣ ва гирифт\",\n  \"businessAccountsPageTextTen\": \"Тавассути кассаҳои мо пул гиред ва ҳисоби худро бо асъори гуногун ба осонӣ пур кунед.\",\n  \"businessAccountsPageTextEleven\": \"Мубодилаи асъор\",\n  \"businessAccountsPageTextTwelve\": \"Асъорҳои худро мувофиқи хоҳишатон идора кунед: сомониро ба доллар ё рубл табдил диҳед\",\n  \"businessAccountsPageTextThirteen\": \"Интиқолҳо бо 6 асъор\",\n  \"businessAccountsPageTextFourteen\": \"Бо сомонӣ, рубл, доллар, евро, дирҳам, сум ва юан пул фиристед\",\n  \"businessAccountsPageTextFifteen\": \"Тарофаҳо\",\n  \"businessAccountsPageTextSixteen\": \"хизматрасонии ҳисоббарорӣ ва кассавӣ\",\n  \"businessAccountsPageTextSeventeen\": \"Кушодан, нигоҳдорӣ ва пӯшидани суратҳисоби ҷорӣ:\",\n  \"businessAccountsPageTextEighteen\": \"Шахсони воқеӣ\",\n  \"businessAccountsPageTextNineteen\": \"Ройгон\",\n  \"businessAccountsPageTextTwenty\": \"Шахсони ҳуқуқӣ ва соҳибкорони инфиродӣ\",\n  \"businessAccountsPageTextTwentyOne\": \"50 сомонӣ\",\n  \"businessAccountsPageTextTwentyTwo\": \"Шахсони ҳуқуқӣ ва соҳибкорони инфиродӣ\",\n  \"businessAccountsPageTextTwentyThree\": \"50 сомонӣ\",\n  \"businessAccountsPageTextTwentyFour\": \"Пешниҳоди ҳисоботи суратҳисоб\",\n  \"businessAccountsPageTextTwentyFive\": \"Ройгон\",\n  \"businessAccountsPageTextTwentySix\": \"Тасдиқи бақияи ҳамаи ҳисобҳо дар шакли расмӣ\",\n  \"businessAccountsPageTextTwentySeven\": \"Ройгон\",\n  \"businessAccountsPageTextTwentyEight\": \"Чӣ тавр шарики мо шудан мумкин аст?\",\n  \"businessAccountsPageTextTwentyNine\": \"Шумо бояд ҳуҷҷатҳои зеринро пешниҳод кунед:\",\n  \"businessAccountsPageTextThirty\": \"Барои шахсони ҳуқуқӣ:\",\n  \"businessAccountsPageTextThirtyOne\": \"Шаҳодатномаи аслӣ дар бораи бақайдгирии давлатӣ (шаҳодатнома);\",\n  \"businessAccountsPageTextThirtyTwo\": \"Нусхаи аслӣ аз Феҳристи ягонаи давлатӣ (иқтибос);\",\n  \"businessAccountsPageTextThirtyThree\": \"Шакли аслӣ барои додани рақами мушаххаси андозсупоранда (РМА);\",\n  \"businessAccountsPageTextThirtyFour\": \"Шиноснома бо сабти ном ва РМА-и директор (зарур аст) ва сармуҳосиб, агар ӯ ҳуқуқи имзои 2-юм дошта бошад;\",\n  \"businessAccountsPageTextThirtyFive\": \"Нусхаи оиннома, ки бо мухри ташкилот тасдик карда шудааст (оинном);\",\n  \"businessAccountsPageTextThirtySix\": \"Нусхаи фармон дар бораи таъини директор ва сармуҳосиб (агар бошад), ки бо муҳри ташкилот тасдиқ карда шудааст.\",\n  \"businessAccountsPageTextThirtySeven\": \"Барои соҳибкорони инфиродӣ:\",\n  \"businessAccountsPageTextThirtyEight\": \"Шиноснома бо сабти ном ва РМА;\",\n  \"businessAccountsPageTextThirtyNine\": \"Ҳуҷҷати аслӣ дар бораи бақайдгирии давлатии шахси воқеӣ ба сифати соҳибкор;\",\n  \"businessAccountsPageTextForty\": \"Нусхаи аслӣ аз реестри ягонаи давлатй (иқтибос).\",\n  \"businessAccountsPageTextFortyOne\": \"Талаботи иловагӣ дар баъзе ҳолатҳо:\",\n  \"businessAccountsPageTextFortyTwo\": \"Барои филиал ё намояндагӣ: ваколатномаи ташкилоти ибтидоӣ, ки ба номи роҳбар дода шудааст;\",\n  \"businessAccountsPageTextFortyThree\": \"Барои ғайрирезидентҳо: нусхаи иҷозатнома ё дархости мақоми ваколатдори кишвари ғайрирезидент барои кушодани суратҳисоб дар давлати хориҷӣ, ки дар сафорат/консулгарии Ҷумҳурии Тоҷикистон дар хориҷа ё сафоратхона/ консулгарии кишвари ғайрирезидент дар Љумҳурии Тоҷикистон;\",\n  \"businessAccountsPageTextFortyFour\": \"Барои ташкилоти қарзӣ: иҷозат барои анҷом додани фаъолияти бонкӣ;\",\n  \"businessAccountsPageTextFortyFive\": \"Барои хоҷагиҳои деҳконӣ: нусхаи шаҳодатномаи ҳуқуқии истифодаи замин.\",\n  \"businessConsultingRequestForm\": \"Машварат оид ба\",\n  \"businessConsultingRequestFormTwo\": \"маҳсулот\",\n  \"businessConsultingRequestFormThree\": \"Шаклро пур кунед, то мо бо шумо кор кунем\",\n  \"businessConsultingRequestFormFour\": \"бо мо тамос гиред ва ҳама чизро ба мо муфассал нақл кунед\",\n  \"businessConsultingRequestFormFive\": \"Ном ва насаб\",\n  \"businessConsultingRequestFormSix\": \"Номи пурраи худро нависед\",\n  \"businessConsultingRequestFormSeven\": \"Ном ва насабатонро калон ҳарф занед\",\n  \"businessConsultingRequestFormEight\": \"Рақами мобилӣ\",\n  \"businessConsultingRequestFormNine\": \"Майдони рақами телефонро пур кунед\",\n  \"businessConsultingRequestFormTen\": \"Майдони рақами телефонро пур кунед (+992 999 999 999)\",\n  \"businessConsultingRequestFormEleven\": \"E-mail\",\n  \"businessConsultingRequestFormTwelve\": \"Майдони почтаи E-mail-ро дар формати дуруст пур кунед\",\n  \"businessConsultingRequestFormThirteen\": \"Ширкат\",\n  \"businessConsultingRequestFormFourteen\": \"Майдонро бо номи ширкати худ пур кунед\",\n  \"businessConsultingRequestFormFifteen\": \"Шаҳр\",\n  \"businessConsultingRequestFormSixteen\": \"Майдони шаҳрро пур кунед\",\n  \"businessConsultingRequestFormSeventeen\": \"Фиристодан\",\n  \"businessConsultingRequestFormEighteen\": \"Бо пашх кардани ташмаи\",\n  \"businessConsultingRequestFormNineteen\": \"Фиристодан\",\n  \"businessConsultingRequestFormTwenty\": \", Ман ба шартҳои коркарди маълумоти хусусӣ розӣ ҳастам.\",\n  \"businessFinancingPageTextOne\": \"Муробаҳаи корпоративӣ\",\n  \"businessFinancingPageTextTwo\": \" Имрӯз ва ҳозир тиҷорати худро афзоиш диҳед!\",\n  \"businessFinancingPageTextThree\": \"Дархост барои маблағгузорӣ\",\n  \"businessFinancingPageTextFour\": \"Манфиатҳои маблағгузории мо\",\n  \"businessFinancingPageTextFive\": \"Ҷалби муштариёни нав\",\n  \"businessFinancingPageTextSix\": \"Рӯзи дигар ҳақи пардохти молро гиред\",\n  \"businessFinancingPageTextSeven\": \"Васеъ намудани хати воситаҳои пардохт\",\n  \"businessFinancingPageTextEight\": \"Афзоиши ҳаҷми маблағи миёнаи чек\",\n  \"businessFinancingPageTextNine\": \"Васеъ кардани ҷуғрофияи фурӯш\",\n  \"businessFinancingPageTextTen\": \"Корпоратив Муробаха чист?\",\n  \"businessFinancingPageTextEleven\": \"Ин як муомилоти тиҷорӣ мебошад, ки дар он бонк арзиши дороиро мустақиман баён мекунад ва онро бо илова кардани фоида ё илова бар он ба муштарӣ мефурӯшад.\",\n  \"businessFinancingPageTextTwelve\": \"то 3 000 000 сомонӣ\",\n  \"businessFinancingPageTextThirteen\": \"маблағи қарзи дилхоҳ\",\n  \"businessFinancingPageTextFourteen\": \"Аз 0 то 90\",\n  \"businessFinancingPageTextFifteen\": \"ҳаққи ибтидоӣ\",\n  \"businessFinancingPageTextSixteen\": \"Аз 3 то 36 моҳ\",\n  \"businessFinancingPageTextSeventeen\": \"шартҳои пардохти қарз\",\n  \"businessFinancingPageTextEighteen\": \"Се қадами оддӣ барои дарёфти маблағгузорӣ\",\n  \"businessFinancingPageTextNineteen\": \"Дархост гузоштан\",\n  \"businessFinancingPageTextTwenty\": \"барои маблағгузорӣ\",\n  \"businessFinancingPageTextTwentyOne\": \"Шартнома\",\n  \"businessFinancingPageTextTwentyTwo\": \"дар бораи хамкориро фосилавӣ имзо кунед\",\n  \"businessFinancingPageTextTwentyThree\": \"Маблағгузориро дарёбед\",\n  \"businessFinancingPageTextTwentyFour\": \"Маблағи пурраро гиред\",\n  \"businessFinancingPageTextTwentyFive\": \"дар давоми 24 соат\",\n  \"businessDepositPageTextOne\": \"Музорабаи маҳдуд\",\n  \"businessDepositPageTextTwo\": \"САРМОЯГУЗОРӢ БО МУТАХАССИСОНИ БОЗОР\",\n  \"businessDepositPageTextThree\": \"МУТАХАССИСОНИ БОЗОР\",\n  \"businessDepositPageTextFour\": \"Сармоягузорӣ\",\n  \"businessDepositPageTextFive\": \"Эътимоднокӣ\",\n  \"businessDepositPageTextSix\": \"ҳимояи сармоягузор\",\n  \"businessDepositPageTextSeven\": \"Идоранамоии\",\n  \"businessDepositPageTextEight\": \"профессионалӣ\",\n  \"businessDepositPageTextNine\": \"Шартҳои чандирии\",\n  \"businessDepositPageTextTen\": \"давраи сармоягузорӣ\",\n  \"businessDepositPageTextEleven\": \"Бартариятҳои Музорабаи маҳдуд\",\n  \"businessDepositPageTextTwelve\": \"Эътимоднокӣ\",\n  \"businessDepositPageTextThirteen\": \"Ҳимояи сармоягузорон тавассути танзими қатъии қонунгузории бозор аз ҷониби Бонки марказӣ.\",\n  \"businessDepositPageTextFourteen\": \"Профессиональное управление\",\n  \"businessDepositPageTextFifteen\": \"Таҷриба ва коршиносӣ бо ширкати идоракунандаи ҶСК  Тавҳидбонк ба мо имкон медиҳад, ки ба манфиати муштарӣ қарорҳои муассир қабул кунем.\",\n  \"businessDepositPageTextSixteen\": \"Гибкие условия\",\n  \"businessDepositPageTextSeventeen\": \" Определяйте период инвестирования сами. Рекомендуемый срок — от года.\",\n  \"businessDepositPageTextEighteen\": \"Шартҳои чандирии\",\n  \"businessDepositPageTextNineteen\": \"Шартҳо\",\n  \"businessDepositPageTextTwenty\": \"Таносуби тақсимоти фоида\",\n  \"businessDepositPageTextTwentyOne\": \"Се қадами оддӣ барои кушодани пасандоз\",\n  \"businessDepositPageTextTwentyTwo\": \"Дархост гузоштан\",\n  \"businessDepositPageTextTwentyThree\": \"бпрои кушодани пасандоз\",\n  \"businessDepositPageTextTwentyFour\": \"Шартнома\",\n  \"businessDepositPageTextTwentyFive\": \"дар бораи хамкориро фосилавӣ имзо кунед\",\n  \"businessDepositPageTextTwentySix\": \"Даромад гиред\",\n  \"businessDepositPageTextTwentySeven\": \"вобаста ба асъор,\",\n  \"businessDepositPageTextTwentyEight\": \"маблағ ва муҳлати пасандоз\",\n  \"businessAcquiringTextOne\": \"ИНТЕРНЕТ-ЭКВАЙРИНГ\",\n  \"businessAcquiringTextTwo\": \"ДАР ШАРТҲОИ МУФИД\",\n  \"businessAcquiringTextThree\": \"Меъёр ба таври инфиродӣ ҳисоб карда мешавад Пайвастшавӣ ройгон ба ЭКВАЙРИНГ\",\n  \"businessAcquiringTextFour\": \"Пайваст шудан\",\n  \"businessAcquiringTextFive\": \"Афзоиши\",\n  \"businessAcquiringTextSix\": \"ҳаҷми фурӯш\",\n  \"businessAcquiringTextSeven\": \"Баландшавии\",\n  \"businessAcquiringTextEight\": \"садоқати муштариён\",\n  \"businessAcquiringTextNine\": \"Табдили баланди\",\n  \"businessAcquiringTextTen\": \"пардохт\",\n  \"businessAcquiringTextEleven\": \"Бартарӣ\",\n  \"businessAcquiringTextTwelve\": \"Пайвастшавӣ ва истифодаи муносиб\",\n  \"businessAcquiringTextThirteen\": \"Пайвасти ройгон ва пардохти муштарӣ\",\n  \"businessAcquiringTextFourteen\": \"Давраи пайвастшавӣ: на бештар аз 5 рӯз\",\n  \"businessAcquiringTextFifteen\": \"Ҳадди ақали бастаи ҳуҷҷатҳо\",\n  \"businessAcquiringTextSixteen\": \"Ҷубронпулӣ ба суратҳисоби дар ҳама гуна бонкҳои ҶТ кушодашуда\",\n  \"businessAcquiringTextSeventeen\": \"Хизматрасонии қабули пардохт\",\n  \"businessAcquiringTextEighteen\": \"Бастани маблағ то тасдиқи фармоиш\",\n  \"businessAcquiringTextNineteen\": \"Имконияти кор бидуни ҳамгироӣ бо Бонк (таъмини истинод ба пардохтҳо аз ҲШ)\",\n  \"businessAcquiringTextTwenty\": \"Муқаррар намудани ҳисобкунии маблағҳо аз корти муштарӣ тибқи ҷадвал\",\n  \"businessAcquiringTextTwentyOne\": \"Технология ва Амният\",\n  \"businessAcquiringTextTwentyTwo\": \"Интиқоли маблағ дар рӯзи кории оянда\",\n  \"businessAcquiringTextTwentyThree\": \"Дастгирӣ ва дастрасӣ ба система 24/7\",\n  \"businessAcquiringTextTwentyFour\": \"Табдилоти баланди пардохт\",\n  \"businessAcquiringTextTwentyFive\": \"Мутобиқати ҳама стандартҳо\",\n  \"businessAcquiringTextTwentySix\": \"Тарофа\",\n  \"businessAcquiringTextTwentySeven\": \"Ибтидоӣ\",\n  \"businessAcquiringTextTwentyEight\": \"Комиссия ҳамагӣ 2,49% мин. 5 сомонӣ.\",\n  \"businessAcquiringTextTwentyNine\": \"Саноатӣ\",\n  \"businessAcquiringTextThirty\": \"Комиссия аз 0,80% мин. 5 сомонӣ.\",\n  \"businessAcquiringTextThirtyOne\": \"Инфиродӣ\",\n  \"businessAcquiringTextThirtyTwo\": \"шароити маъсус\",\n  \"businessAcquiringTextThirtyThree\": \"барои тиҷорати Шумо\",\n  \"businessAcquiringTextThirtyFour\": \"Барои шарикони ҶСК Тавҳидбонк\",\n  \"businessAcquiringTextThirtyFive\": \"Комиссия 1,9% мин. 5 сомонӣ.\",\n  \"businessAcquiringTextThirtySix\": \"Машварати маҳсулот\",\n  \"businessAcquiringTextThirtySeven\": \"Телефонҳо барои тамос\",\n  \"businessAcquiringTextThirtyEight\": \"Тарофаҳои ҶСК «Тавҳидбонк» барои пешниҳоди хизматрасонии интернет эквайринг\",\n  \"businessAcquiringTextThirtyNine\": \"Шартҳои пешниҳоди хизматрасонии интернет эквайринг дар Тавҳидбонк\",\n  \"businessAcquiringTextForty\": \"ба ташкилотҳои фарҳанги ва шахсони ваколатдори ташкилотҳои фарҳангӣ\",\n  \"aboutMainPageTextOne\": \"Аввалин ва ягона\",\n  \"aboutMainPageTextTwo\": \"бонки исломии кишвар.\",\n  \"aboutMainPageTextThree\": \"Дар бораи мо бо рақамҳо\",\n  \"aboutMainPageTextFour\": \"муштариёни фаъол дар Тоҷикистон\",\n  \"aboutMainPageTextFive\": \"300 000+\",\n  \"aboutMainPageTextSix\": \"мизоҷ\",\n  \"aboutMainPageTextSeven\": \"мизоҷони корпоративӣ\",\n  \"aboutMainPageTextEight\": \"200+\",\n  \"aboutMainPageTextNine\": \"ширкат\",\n  \"aboutMainPageTextTen\": \"мизоҷони корпоративӣ\",\n  \"aboutMainPageTextEleven\": \"300+\",\n  \"aboutMainPageTextTwelve\": \"мизоҷ\",\n  \"aboutMainPageTextThirteen\": \"Б\",\n  \"aboutMainPageTextFourteen\": \"онк 24 августи соли 1999 ҳамчун Бонки саҳҳомии тиҷоратии мусоидат ва дастгирии соҳибкорӣ таъсис ёфта, 22 майи соли 2002 ба ҶСК «Соҳибкорбонк» аз нав ташкил карда шуд.\",\n  \"aboutMainPageTextFifteen\": \"Бонк аз замони таъсисёбӣ иштирокчии фаъол, боэътимод ва устувори бозори хизматрасониҳои молиявии кишвар мебошад. Бонк то имрӯз дар фаъолияти худ ба нишондиҳандаҳои назарраси мусбӣ ноил гардида, дар саросари ҷумҳурӣ 5 филиал ва 58 Маркази хизматрасонии бонкӣ дорад.\",\n  \"aboutMainPageTextSixteen\": \"Тибқи сохтори феълӣ дар бонк беш аз 340 нафар мутахассис кор мекунад. 1 июли соли 2019 номи бонк ба «Тавҳидбонк» иваз карда шуд ва аз замони гирифтани иҷозатномаи БМТ\",\n  \"aboutMainPageTextSeventeen\": \"аз 17 сентябри соли 2019 ҳамчун нахустин Бонки исломии комил дар Тоҷикистон фаъолият мекунад.\",\n  \"aboutMainPageTextSeventeenOne\": \"Фарқият аз бонкҳои анъанавӣ:\",\n  \"aboutMainPageTextSeventeenTwo\": \"Бонкҳои анъанавӣ аз бонкҳои исломӣ дар сохтор, принсипҳои фаъолият ва хизматрасонии худ як қатор фарқиятҳои назаррас доранд.\",\n  \"aboutMainPageTextSeventeenThree\": \"Фарқияти асосан аз рӯйи принсипҳои фаъолият мебошад:\",\n  \"aboutMainPageTextSeventeenFour\": \"Дар модели бонкдории анъанавӣ\",\n  \"aboutMainPageTextSeventeenFive\": \"сарчашмаи асосии фоида ин фоиз аз қарзҳо мебошад. Дар бонкҳои анъанавӣ амалиётҳои қарзӣ, маблағгузорӣ ва ҷалби амонатҳои муҳлатнокро дар асоси гирифтан ё пешниҳод намудани фоизҳо амалӣ мегарданд.\",\n  \"aboutMainPageTextSeventeenSix\": \"Бонкҳои исломӣ\",\n  \"aboutMainPageTextSeventeenSeven\": \"бошанд, дар асоси принсипҳои бонкдории исломӣ фаъолият мекунанд, ки истифодаи фоиз, яъне гирифтани фоида аз маблағ манъ аст. Ба ҷойи ин, бонкҳои исломӣ мафҳумҳои шарикӣ ва тиҷоратро истифода мебаранд.\",\n  \"aboutMainPageTextEighteen\": \"Вазифаи бонк\",\n  \"aboutMainPageTextNineteen\": \"Аз мафҳуми фоизи қарз даст кашида, ба манфиати мардуми кишвари мо ва берун аз он ҷорӣ намудани банки одилона ва бефоиз. Фаъолияти худро дар асоси талаботи шаръи роҳандозӣ намуда, пешгирӣ аз амалиёти хилофи усулҳои исломӣ.\",\n  \"aboutMainPageTextTwenty\": \"Дурнамои мо\",\n  \"aboutMainPageTextTwentyOne\": \"Пешвои соҳаи бонкдории исломӣ, дастгирии рушди устувор ва ҳамеша як провайдери афзалиятноки хидматҳои молиявии исломӣ ҳам дар сатҳи миллӣ ва ҳам минтақавӣ будан.\",\n  \"aboutMainPageTextTwentyTwo\": \"Ҷойҳои холии корӣ\",\n  \"aboutMainPageTextTwentyThree\": \"Мо Шуморо дар байни кормандони худ интизорем\",\n  \"aboutMainPageTextTwentyFour\": \"Ҳамроҳ шудан\",\n  \"aboutMainPageTextTwentyFive\": \"Ҳуҷҷатгузорӣ\",\n  \"aboutMainPageTextTwentySix\": \"Оиннома, иҷозатномаҳо ва ғайра.\",\n  \"aboutMainPageTextTwentySeven\": \"Дидан\",\n  \"aboutMainPageTextTwentyEight\": \"Филиалҳо ва банкоматҳои мо\",\n  \"aboutMainPageTextTwentyNine\": \"Тамос\",\n  \"aboutMainPageTextThirty\": \"Алоқаи\",\n  \"aboutMainPageTextThirtyOne\": \"шабонарӯзӣ\",\n  \"aboutMainPageTextThirtyTwo\": \"бо бонк\",\n  \"aboutMainPageTextThirtyThree\": \"Маҳсулоти мо\",\n  \"aboutMainPageTextThirtyFour\": \"Маблағгузорӣ\",\n  \"aboutMainPageTextThirtyFive\": \"Кортҳо\",\n  \"aboutMainPageTextThirtySix\": \"Амонатҳо\",\n  \"aboutBranchesPageTextOne\": \"Нишониҳо\",\n  \"aboutBranchesPageTextTwo\": \"Офисҳо\",\n  \"aboutBranchesPageTextThree\": \"Банкоматҳо\",\n  \"aboutBranchesPageTextFour\": \"Терминалҳо\",\n  \"aboutBranchesPageTextFive\": \"Реҷаи қабули шаҳрвандон\",\n  \"aboutBranchesPageTextSix\": \"Реквизитҳо\",\n 