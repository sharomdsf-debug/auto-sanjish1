":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":554,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":554,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"38paa\\\",\\\"text\\\":\\\"\\u041d\\u0430 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0435 \\u0434\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u041c\\u0435\\u043c\\u043e\\u0440\\u0430\\u043d\\u0434\\u0443\\u043c\\u0430 \\u0411\\u0430\\u043d\\u043a \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u0422\\u0430\\u0434\\u0436\\u0438\\u043a\\u0438\\u0441\\u0442\\u0430\\u043d\\u0430 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0432\\u043d\\u0435\\u0441\\u0442\\u0438 \\u0441\\u0432\\u043e\\u0439 \\u0432\\u043a\\u043b\\u0430\\u0434 \\u0432 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0439 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438 \\u043e \\u043c\\u0435\\u0441\\u0442\\u043d\\u043e\\u043c \\u0440\\u044b\\u043d\\u043a\\u0435, \\u043e\\u0446\\u0435\\u043d\\u043a\\u0443 \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0444\\u0438\\u043d\\u0430\\u043d\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0438 \\u0441\\u043e\\u0442\\u0440\\u0443\\u0434\\u043d\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 \\u0437\\u0430\\u0438\\u043d\\u0442\\u0435\\u0440\\u0435\\u0441\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d. \\u0421 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, Kingdom Group \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0441\\u043e\\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u0438\\u0432\\u043b\\u0435\\u0447\\u0435\\u043d\\u0438\\u044e \\u043c\\u0435\\u0436\\u0434\\u0443\\u043d\\u0430\\u0440\\u043e\\u0434\\u043d\\u044b\\u0445 \\u0438\\u043d\\u0432\\u0435\\u0441\\u0442\\u043e\\u0440\\u043e\\u0432, \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0445 \\u0438 \\u0442\\u043e\\u0440\\u0433\\u043e\\u0432\\u044b\\u0445 \\u043f\\u0430\\u0440\\u0442\\u043d\\u0435\\u0440\\u043e\\u0432, \\u0430 \\u0442\\u0430\\u043a\\u0436\\u0435 \\u0441\\u043e\\u0437\\u0434\\u0430\\u043d\\u0438\\u044e \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0434\\u043b\\u044f \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430 \\u043d\\u0430 \\u0432\\u043d\\u0435\\u0448\\u043d\\u0438\\u0435 \\u0440\\u044b\\u043d\\u043a\\u0438.\\\\n \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":401,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":401,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":401,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":401,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}}],\\\"entityMap\\\":{}}}\",\"content_en\":\"{\\\"contentStateen\\\":{\\\"blocks\\\":[{\\\"key\\\":\\\"3qke7\\\",\\\"text\\\":\\\"The main objective of the Memorandum of Understanding is to establish a framework for mutually beneficial cooperation in the fields of investment, project financing, trade development, the transfer of modern technologies, and the promotion of the sustainable economic development of the Republic of Tajikistan.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":310,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":310,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":310,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":310,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"9ce4h\\\",\\\"text\\\":\\\"Under the signed document, the parties will explore opportunities for expanding cooperation in priority economic sectors, including the mining industry and mineral processing, pharmaceuticals and healthcare, aviation, banking and financial services, agriculture and produce processing, construction and real estate development, tourism, information technology, and Islamic finance.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":381,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":381,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":381,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":381,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"8lvd5\\\",\\\"text\\\":\\\"Additionally, within the framework of this cooperation, special attention will be paid to attracting international investors, evaluating economically significant projects, developing export capabilities, introducing modern technologies, and enhancing the professional capacity of specialists. Furthermore, the parties have envisioned the possibility of jointly developing project concepts, conducting feasibility studies, organizing meetings with investors and strategic partners, and discussing financing mechanisms for promising projects.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":540,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":540,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":540,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":540,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"1tmqn\\\",\\\"text\\\":\\\"Based on this Memorandum, the Development Bank