\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":429,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":429,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":429,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":429,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"3r91h\\\",\\\"text\\\":\\\"As part of this significant regional event, CJSC \\\\\\\"The Development Bank of Tajikistan\\\\\\\" acted as a partner of the Forum, making a substantial contribution to the organization and development of financial ties.  \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":209,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":209,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":209,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":209,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"32llb\\\",\\\"text\\\":\\\"During the forum, the bank\\u2019s achievements and activities were recognized with well-deserved awards:\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":99,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":99,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":99,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":99,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"ckkgc\\\",\\\"text\\\":\\\"The bank's successful operations and its 20-year journey were marked with a special award: \\\\\\\"20 Years of Trust, Development, and Partnership\\\\\\\".  \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":143,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":143,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":143,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":143,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"4rccu\\\",\\\"text\\\":\\\"The Chairman of the Management Board of CJSC \\\\\\\"The Development Bank of Tajikistan,\\\\\\\" Sharifzoda P. O., was awarded the honorary title and lapel badge \\\\\\\"Excellence in the Banking System\\\\\\\" for his merits in developing the sector.  \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":225,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":225,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":225,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":225,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"c9a0i\\\",\\\"text\\\":\\\"In addition, Deputy Chairman of the Management Board Rakhmatov S. K. and the Financial Director were awarded special AFOT diplomas for their active contribution to the development of the credit and financial system.  \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":217,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":217,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":217,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":217,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"tg5\\\",\\\"text\\\":\\\"The active participation of the management and the support of this international-level event once again emphasize the strong positions, reliability, and key role of The Development Bank of Tajikistan in strengthening the country's financial system.\\\\n \\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":248,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":248,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":248,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":248,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}}],\\\"entityMap\\\":{}}}\",\"created_at\":\"2026-10-05T09:33:32.000000Z\",\"updated_at\":\"2026-10-05T09:35:44.000000Z\"},{\"id\":32,\"url\":\"international-transfers\",\"title_tg\":\"\\u0418\\u043d\\u0442\\u0438\\u049b\\u043e\\u043b\\u0438 \\u0444\\u0430\\u0432\\u0440\\u0438\\u0438 \\u0431\\u0430\\u0439\\u043d\\u0430\\u043b\\u043c\\u0438\\u043b\\u0430\\u043b\\u04e3 \\u0431\\u0430 \\u04ee\\u0437\\u0431\\u0435\\u043a\\u0438\\u0441\\u0442\\u043e\\u043d \\u0432\\u0430 \\u049a\\u0438\\u0440\\u0493\\u0438\\u0437\\u0438\\u0441\\u0442\\u043e\\u043d \\u2014 \\u0430\\u043a\\u043d\\u0443\\u043d \\u0434\\u0430\\u0440 \\u0437\\u0430\\u043c\\u0438\\u043c\\u0430\\u0438 \\u00ab\\u0411\\u043e\\u043d\\u043a\\u0438 \\u0440\\u0443\\u0448\\u0434\\u00bb\",\"title_ru\":\"\\u041c\\u0433\\u043d\\u043e\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043c\\u0435\\u0436\\u0434\\u0443\\u043d\\u0430\\u0440\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0435\\u0440\\u0435\\u0432\\u043e\\u0434\\u044b \\u0432 \\u0423\\u0437\\u0431\\u0435\\u043a\\u0438\\u0441\\u0442\\u0430\\u043d \\u0438 \\u041a\\u044b\\u0440\\u0433\\u044b\\u0437\\u0441\\u0442\\u0430\\u043d \\u2014 \\u0442\\u0435\\u043f\\u0435\\u0440\\u044c \\u0432 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0438 \\u00ab\\u0411\\u043e\\u043d\\u043a\\u0438 \\u0440\\u0443\\u0448\\u0434\\u00bb\",\"title_en\":\"Instant International Transfers to Uzbekistan and Kyrgyzstan Now Available in the \\\"Bonki Rushd\\\" App\",\"subtitle_tg\":\"\\u04b6\\