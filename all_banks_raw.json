          {
            "url": "https://dc.tj/local.json",
            "body": "{\n  \"ru\": {\n    \"navtext1\": \"Физическим лицам\",\n    \"navtext2\": \"Юридическим лицам\",\n    \"navtext3\": \"О банке\",\n    \"navtext4\": \"Русский\",\n    \"navtext5\": \"Точики\",\n    \"appText1\": \"Скачайте DC Next\",\n    \"appText2\": \"Оплачивайте налоги, государственные и таможенные пошлины, а также коммунальные и 250+ других услуг в два клика\",\n    \"applicationText1\": \"Остались вопросы?\",\n    \"applicationText2\": \"Оставьте онлайн-заявку и узнайте решение банка за несколько минут\",\n    \"applicationText3\": \"Я соглашаюсь с условиями и даю согласие на обработку своих данных\",\n    \"applicationText4\": \"Отправить\",\n    \"applicationText5\": \"* Все поля являются обязательными\",\n    \"text1\": \"Ипотека до 8 лет\",\n    \"text2\": \"Покупайте квартиру в ипотеку от 8% годовых\",\n    \"text3\": \"Подробнее\",\n    \"text4\": \"Автомобиль за 1 клик\",\n    \"text5\": \"Заполните заявку и получите кредит на автомобиль вашей мечты\",\n    \"text6\": \"Совершайте покупки\",\n    \"text7\": \"с картами Dushanbe City или с QR в DC Next и получайте бонусы\",\n    \"text8\": \"Наши продукты\",\n    \"text9\": \"Кредиты\",\n    \"text10\": \"Дебетовые карты\",\n    \"text11\": \"Бонусы\",\n    \"text12\": \"Автокредит\",\n    \"text13\": \"Ипотека\",\n    \"text14\": \"Рассчитайте кредит\",\n    \"text15\": \"Кредит наличными\",\n    \"text16\": \"Автокредит\",\n    \"text17\": \"Ипотеку\",\n    \"text18\": \"Сумма кредита:\",\n    \"text19\": \"На срок:\",\n    \"text20\": \"мес.\",\n    \"text21\": \"Расчет является предварительным. Точные условия по кредиту вам будут предоставлены в отделении банка\",\n    \"text22\": \"Ежемесячный платеж:\",\n    \"text23\": \"Ставка по кредиту:\",\n    \"text24\": \"Оставить заявку\",\n    \"text25\": \"Все кредиты\",\n    \"text26\": \"Проекты\",\n    \"text27\": \"Автолизинг\",\n    \"text28\": \"Аренда авто с последующей покупкой  \",\n    \"text29\": \"Годовая процентная ставка — 28%.\",\n    \"text30\": \"Срок кредитования — до 36 месяцев\",\n    \"text31\": \"Авиабилеты\",\n    \"text32\": \"Выбор и покупка авиабилетов по самым выгодным ценам прямо в DC Avia\",\n    \"text33\": \"Международные перевозки\",\n    \"text34\": \"Перевозки для всех с DC CARGO\",\n    \"text35\": \"Страхование\",\n    \"text36\": \"Широкий спектр страховых услуг — от страхования автомобилей до медицинского страхования, страхования имущества и т.д.\",\n    \"text37\": \"Будьте в курсе последних новостей\",\n    \"text38\": \"Полезное\",\n    \"text39\": \"Банкоматы и отделения\",\n    \"text40\": \"Найдите ближайший банкомат или отделении в вашем городе\",\n    \"text41\": \"Найти банкомат\",\n    \"text42\": \"Служба поддержки\",\n    \"text43\": \"Задайте свой вопрос в наших социальных сетях\",\n    \"text44\": \"Написать\",\n    \"text45\": \"Скоро\",\n    \"text46\": \"Зарплатный проект\",\n    \"text47\": \"Расчётно кассовое обслуживание\",\n    \"text48\": \"Торговое финансирование\",\n    \"text49\": \"Программа лояльности\",\n    \"text50\": \"Торговый эквайринг\",\n    \"text51\": \"Кредит для развития бизнеса\",\n    \"text52\": \"Бизнесу\",\n    \"text53\": \"Акция Visa Direct\",\n    \"text54\": \"Подарки каждую неделю от Душанбе Сити Банка и Visa\",\n    \"text55\": \"Отправляйте более 20$ на карту Visa за границу и получайте призы\",\n    \"text56\": \"Подробнее\",\n    \"text57\": \"Visa Gold за 5 минут\",\n    \"text58\": \"Получите свою карту в Душанбе Сити Банке\",\n    \"text59\": \"Будьте внимательны!\",\n    \"text60\": \"Не открывайте подозрительные файлы, ссылки и никому не сообщайте ваши банковские данные, коды-подтверждения\",\n    \"text61\": \"Обновить DC Next\",\n    \"text62\": \"*Банк не несёт ответственности за кражу средств при нарушении правил безопасности\",\n    \"text63\": \"Специальное предложение от Тойота Центр «Taj Motors»\",\n    \"text64\": \"Принесите паспорт и станьте владельцем нового автомобиля\",\n    \"text65\": \"Мир возможностей с\",\n    \"text66\": \"Мгновенные платежи по всему миру, особенно на популярных зарубежных маркетплейсах: Amazon, TaoBao, Pinduoduo, AliBaba и другие\",\n    \"text67\": \"Покупайте сейчас, платите в удобное время\",\n    \"text68\": \"С рассрочкой «Дастрас» — до 6 месяцев 0 %\",\n    \"text69\": \"Станьте обладателем квартиры мечты\",\n    \"text70\": \"Ипотека с удобными условиями и гибкими решениями помогает чувствовать уверенность и комфорт на пути к своей квартире\",\n    \"text71\": \"Курс валюты\",\n    \"text72\": \"Переводы\",\n    \"text73\": \"В кассе\",\n    \"text74\": \"НБТ\",\n    \"text75\": \"Валюта\",\n    \"text76\": \"Продажа\",\n    \"text77\": \"Покупка\",\n    \"text78\": \"У меня есть\",\n    \"text79\": \"Хочу купить\",\n    \"text80\": \"Показать ещё\",\n    \"text81\": \"Курс\",\n    \"text82\": \"Юр. лица\",\n    \"text83\": \"Курс актуален на\",\n    \"gpayText1\": \"Оплата в одно касание\",\n    \"gpayText2\": \"Без карты, без наличных — только телефон или Smart Watch и ваша оплата пройдёт мгновенно с Google Pay\",\n    \"chinatext1\": \"Покупать из Китая стало проще\",\n    \"chinatext2\": \"Оформите UnionPay Virtual и оплачивайте покупки на китайских маркетплейсах без комиссии\",\n    \"newsText1\": \"С 1 августа оплата всех государственных услуг будет осуществляться в безналичной форме\",\n    \"newsText2\": \"Согласно посланию президента страны от 23 декабря\",\n    \"newsText3\": \"Первый Фестиваль финансовой грамотности от Национального Банка Таджикистана прошёл на ура\",\n    \"newsText4\": \"Провели конкурс, раздали подарочки и даже приняли на работу.\",\n    \"newsText5\": \"Ищете работу? Работа есть!\",\n    \"newsText6\": \"Поучаствовали на Фестивале карьеры в рамка\",\n    \"newsText7\": \"Читать\",\n    \"calctext1\": \"Кредитный калькулятор\",\n    \"calctext2\": \"Рассчитайте предположительные условия кредита\",\n    \"calctext3\": \"Сумма кредита/займа\",\n    \"calctext4\": \"Процентная ставка, % годовых\",\n    \"calctext5\": \"Срок кредита/займа\",\n    \"calctext6\": \"Ежемесячный кредит\",\n    \"calctext7\": \"Полная стоимость кредита\",\n    \"calctext8\": \"Всего процентов\",\n    \"calctext9\": \"Графика платежей\",\n    \"footerText1\": \"Частным лицам\",\n    \"footerText2\": \"Карты\",\n    \"footerText3\": \"Express Card\",\n    \"footerText4\": \"Именная карта\",\n    \"footerText5\": \"Кобрендовая карта\",\n    \"footerText6\": \"Детская карта\",\n    \"footerText7\": \"Кредиты\",\n    \"footerText8\": \"Дастрас\",\n    \"footerText9\": \"Автокредит\",\n    \"footerText10\": \"Ипотека\",\n    \"footerText11\": \"Товары в рассрочку\",\n    \"footerText12\": \"Потребительский кредит\",\n    \"footerText13\": \"Кредит Ломбард\",\n    \"footerText14\": \"Кредитный калькулятор\",\n    \"footerText15\": \"Денежные переводы\",\n    \"footerText16\": \"Переводы с России\",\n    \"footerText76\": \"Переводы в Россию\",\n    \"footerText77\": \"Переводы в Китай\",\n    \"footerText18\": \"Contact\",\n    \"footerText19\": \"UniStream\",\n    \"footerText20\": \"Asia Plus\",\n    \"footerText21\": \"Tcell\",\n    \"footerText22\": \"Еще\",\n    \"footerText23\": \"Бонусы\",\n    \"footerText24\": \"Новости\",\n    \"footerText25\": \"Курсы валют\",\n    \"footerText26\": \"Мобильное приложение\",\n    \"footerText27\": \"Онлайн идентификация\",\n    \"footerText28\": \"Часто задаваемые вопросы\",\n    \"footerText29\": \"Проекты\",\n    \"footerText30\": \"DC AVIA\",\n    \"footerText31\": \"DC LEASING\",\n    \"footerText32\": \"DC CARGO\",\n    \"footerText33\": \"Офисы и банкоматы\",\n    \"footerText34\": \"Головной офис\",\n    \"footerText35\": \"АЦБО\",\n    \"footerText36\": \"ЦБО\",\n    \"footerText37\": \"Филиалы\",\n    \"footerText38\": \"Терминалы\",\n    \"footerText39\": \"Банкоматы\",\n    \"footerText40\": \"Представители\",\n    \"footerText41\": \"Юридическим лицам\",\n    \"footerText42\": \"Бизнесу\",\n    \"footerText43\": \"Открытие и обслуживание счёта\",\n    \"footerText44\": \"Зарплатный проект\",\n    \"footerText45\": \"Кредиты\",\n    \"footerText46\": \"Кредит для развития бизнеса\",\n    \"footerText47\": \"Эквайринг\",\n    \"footerText48\": \"Единый QR-код\",\n    \"footerText49\": \"POS-терминал\",\n    \"footerText50\": \"Реквизиты\",\n    \"footerText51\": \"О банке\",\n    \"footerText52\": \"Наша история\",\n    \"footerText53\": \"Наши ценности\",\n    \"footerText54\": \"Наши достижения\",\n    \"footerText55\": \"Наши продукты и услуги\",\n    \"footerText56\": \"Документы\",\n    \"footerText57\": \"Отчеты\",\n    \"footerText58\": \"Комплаенс\",\n    \"footerText59\": \"Безопасность\",\n    \"footerText60\": \"Вакансии\",\n    \"footerText61\": \"Дизайн\",\n    \"footerText62\": \"Связь с Душанбе Сити Банком\",\n    \"footerText84\": \"Связать с Национальным банком Таджикистана\",\n    \"footerText63\": \"Таджикистан, г. Душанбе, ул. Пулоди, 41\\nОриентир: магазин JYSK\",\n    \"footerText64\": \"Таджикистан, г. Душанбе,\",\n    \"footerText65\": \"Режим работы:\\n8.00-17.00\",\n    \"footerText66\": \"Внутри Республики Таджикистан\",\n    \"footerText67\": \"366\",\n    \"footerText68\": \"Для звонков со всего мира\",\n    \"footerText69\": \"+992 44 630 99 99\",\n    \"footerText70\": \"E-mail:\",\n    \"footerText71\": \"Связать с Национальным банком Таджикистана\",\n    \"footerText72\": \"+992 44 600 15 20\",\n    \"footerText73\": \"E-mail: info@nbt.tj\",\n    \"footerText74\": \"Мы в социальных сетях\",\n    \"footerText75\": \"© ЗАО «Душанбе Сити Банк» 2026. Лицензия Национального банка Республики Таджикистан №0000301 от 10 июня 2022 года\",\n    \"footerText78\": \"Телефон: \",\n    \"footerText79\": \"Таджикистан, г. Душанбе, ул. Пулоди, 41 Ориентир: магазин JYSK\",\n    \"footerText80\": \"Внутри Республики Таджикистан 366\",\n    \"footerText81\": \"Для звонков со всего мира\",\n    \"footerText82\": \"Тендеры\",\n       \"footerText83\": \"Депозиты\",\n    \"footerText85\": \"Если вы столкнулись с проблемой, свяжитесь с Национальным банком Таджикистана\",\n    \"footerText86\": \"Контакты\"\n  },\n  \"tj\": {\n    \"navtext1\": \"Ба шахсони воқеӣ\",\n    \"navtext2\": \"Ба шахсони ҳуқуқӣ\",\n    \"navtext3\": \"Дар бораи мо\",\n    \"navtext4\": \"Руси\",\n    \"navtext5\": \"Тоҷики\",\n    \"appText1\": \"DC Next-ро насб намоед\",\n    \"appText2\": \"Андоз, боҷ, хизматрасониҳои давлатӣ, коммуналӣ ва 250+ хизматрасониҳо бо 2 пахш супоред\",\n    \"applicationText1\": \"Саволҳо боқӣ мондаанд?\",\n    \"applicationText2\": \"Онлайн-дархост гузоред ва чавоби бонкро муддати кӯтох дастрас намоед\",\n    \"applicationText3\": \"Ман ба ҳама гуна шартҳо розӣ ҳастам ва барои коркарди маълумотҳои хусусии худ розигиамро медиҳам\",\n    \"applicationText4\": \"Ирсол кардан\",\n    \"applicationText5\": \"*Пур намудани ҳамаи майдонҳо ҳатмӣ мебошанд\",\n    \"text1\": \"Ипотека то 8 сол\",\n    \"text2\": \"Хона бо ипотека бо 8% солона харед\",\n    \"text3\": \"Муфассал\",\n    \"text4\": \"Автомобил 1 бо клик\",\n    \"text5\": \"Аризаро пур кунед ва дилхоҳ мошинро ба насия гиред\",\n    \"text6\": \"Совершайте покупки\",\n    \"text7\": \"Бо Кортҳои Dushanbe City е QR Дар Dc Next ва мукофотпулӣ гиред\",\n    \"text8\": \"Маҳсулоти мо\",\n    \"text9\": \"Насия\",\n    \"text10\": \"Кортҳои дебетӣ\",\n    \"text11\": \"Бонусҳо\",\n    \"text12\": \"Автокредит\",\n    \"text13\": \"Ипотека\",\n    \"text14\": \"Насияро ҳисоб кунед\",\n    \"text15\": \"Қарзи нақдӣ\",\n    \"text16\": \"Автокредит\",\n    \"text17\": \"Ипотека\",\n    \"text18\": \"Маблағи насия:\",\n    \"text19\": \"Муҳлати пардохт:\",\n    \"text20\": \"моҳ\",\n    \"text21\": \"Ҳисоб тахминан аст. Шартҳои дақиқи қарз ба шумо дар филиали бонк дода мешаванд\",\n    \"text22\": \"Пардохти моҳона:\",\n    \"text23\": \"Меъери қарз:\",\n    \"text24\": \"Дархост гузоштан\",\n    \"text25\": \"Ҳамаи насияҳо\",\n    \"text26\": \"Лоиҳаҳо\",\n    \"text27\": \"Лизинг\",\n    \"text28\": \"Мошинро ба иҷора гирифта, минбаъд онро харидорӣ намоед\",\n    \"text29\": \"Солона — 28%\",\n    \"text30\": \"Муҳлат — то 36 моҳ\",\n    \"text31\": \"Чиптаҳои ҳавопаймо\",\n    \"text32\": \"Интихоб ва харидани чиптаҳои ҳавопаймоӣ бо беҳтарин нархҳо дар DC Avia\",\n    \"text33\": \"Карго\",\n    \"text34\": \"Интиқоли байналмилалӣ барои ҳама бо DC Cargo\",\n    \"text35\": \"Суғурта\",\n    \"text36\": \"Доираи васеъи хизматрасониӽои суғуртавӣ – аз суғуртаи мошин то суғуртаи тиббӣ, суғуртаи амвол ва ғайра\",\n    \"text37\": \"Аз хабарҳои навтарин бохабар бошед\",\n    \"text38\": \"Хизматрасониҳои муфид\",\n    \"text39\": \"Банкоматҳо ва филиалҳо\",\n    \"text40\": \"Банкомати ё филиали наздиктаринро дар шахри худ пайдо кунед\",\n    \"text41\": \"ҷустуҷӯ\",\n    \"text42\": \"Маркази тамос\",\n    \"text43\": \"Саволи худро дар шабакаи иҷтимоӣ мо диҳед\",\n    \"text44\": \"Савол додан\",\n    \"text45\": \"Ба наздикӣ\",\n    \"text46\": \"Лоиҳаи маошдиҳӣ\",\n    \"text47\": \"Кушодани суратҳисоб\",\n    \"text48\": \"Маблағгузории савдо DC\",\n    \"text49\": \"Барномаи бонус\",\n    \"text50\": \"Эквайринг\",\n    \"text51\": \"Қарз барои рушди тиҷорат\",\n    \"text52\": \"Барои тиҷорат\",\n    \"text53\": \"Иқдоми Visa Direct\",\n    \"text54\": \"Тӯҳфаҳо ҳар ҳафта аз Душанбе Сити Бонк ва Visa\",\n    \"text55\": \"Ба кортҳои байналмилалии Visa маблағ интиқол дода, имконияти соҳиби тӯҳфаҳои арзишманд шуданро аз даст надиҳед\",\n    \"text56\": \"Муффасал\",\n    \"text57\": \"Visa Gold дар 5 дақиқа\",\n    \"text58\": \"Корти худро аз Душанбе Сити Бонк гиред\",\n    \"text59\": \"Бодиққат бошед!\",\n    \"text60\": \"Файлҳои шубҳанокро накушоед, ба истинодҳои номаълум нагузаред, маълумотҳои бонкии худ ва паёмак-тасдиқҳоро ба ҳеҷ кас надиҳед\",\n    \"text61\": \"Навсозии DC Next\",\n    \"text62\": \"*Ҳангоми риоя накардан ба қоидаҳои бехатарӣ ва дуздида шудани маблағ бонк масъул намебошад\",\n    \"text63\": \"Пешниҳоди махсус аз «Taj Motors»\",\n    \"text64\": \"Танҳо бо шиноснома соҳиби мошини нав шавед\",\n    \"text65\": \"Ҷаҳони имкониятҳо бо\",\n    \"text66\": \"Пардохти зуд дар тамоми дунё, махсусан дар онлайн мағозаҳои хориҷӣ: Amazon, TaoBao, Pinduoduo, AliBaba ва ғайра\",\n    \"text67\": \"Ҳозир харид кунед, маблағро дар вақти ба худ мувофиқ супоред\",\n    \"text68\": \"Бо насияи «Дастрас» — то 6 моҳ 0%\",\n    \"text69\": \"Соҳиби хонаи орзуҳо шавед\",\n    \"text70\": \"Шарики боэътимод барои харидҳои боэътимод Ипотека бо шартҳои қулай ва қарорҳои чандир ба шумо дар роҳи расидан ба хонаи шахсиатон эҳсоси эътимоду оромиро мебахшад\",\n        \"text71\": \"Қурби асъор\",\n    \"text72\": \"Интиқолҳо\",\n    \"text73\": \"Дар хазина\",\n    \"text74\": \"БМТ\",\n    \"text75\": \"Асъор\",\n    \"text76\": \"Фурӯш\",\n    \"text77\": \"Харид\",\n    \"text78\": \"Ман дорам\",\n    \"text79\": \"Мехоҳам гирам\",\n    \"text80\": \"Бештар\",\n    \"text81\": \"Қурб\",\n    \"text82\": \"Ш. ҳуқуқӣ\",\n    \"text83\": \"Эътибори қурб дар\",\n        \"gpayText1\": \"Пардохт бо як ҳаракат\",\n    \"gpayText2\": \"Бе корт, бе пули нақд — танҳо телефон ё Smart Watch ва пардохти шумо дар як лаҳза бо Google Pay анҷом меёбад\",\n        \"chinatext1\": \"Харид аз Чин осонтар шуд\",\n    \"chinatext2\": \"UnionPay Virtual-ро гиред ва харидҳои худро аз маркетплейсҳои Чин бе комиссия пардохт намоед.\",\n    \"newsText1\": \"Аз 1 август пардохти ҳамаи хизматрасониҳои давлатӣ дар шакли ғайринақдӣ сурат мегирад\",\n    \"newsText2\": \"Тибқи паеми президенти мамлакат аз 23 декабри соли 2022 'дар бораи самтҳои асосии сиесати дохилӣ ва хориҷӣ', фармони президент no 586 аз 22 июни соли ҷорӣ бо мақсади дастгирии рушди бахши молиявӣ, фарогирии пурраи шабакаҳои рақамии хизматрасониҳои молиявӣ, таъмини хизматрасониҳои гуногун дар ҳисоббаробаркуниҳои ғайринақдӣ чунин амалӣ карда мешавад: пардохти андозҳо, боҷҳои давлатӣ, иҷозатномаҳо, суғурта, хизматрасониҳои коммуналӣ, ҳисоббаробаркуниҳои бонкӣ.\",\n    \"newsText3\": \"Якум Фестивали саводнокии молиявии Бонки Миллии Тоҷикистон зӯр гузашт\",\n    \"newsText4\": \"Озмун гузарондему тӯҳфаҳоро тақсим кардем ва ҳатто ба кор қабул намудем\",\n    \"newsText5\": \"Кор мекобед? Кор ҳаст!\",\n    \"newsText6\": \"Дар Форуми байналмиллалии ҷавонон дар Китобхонаи Миллӣ иштирок намудем\",\n    \"newsText7\": \"Муфассал\",\n    \"calctext1\": \"Ҳисобкунаки қарзӣ\",\n    \"calctext2\": \"Шартҳои тахминии қарзро ҳисоб кунед\",\n    \"calctext3\": \"Маблағи қарз\",\n    \"calctext4\": \"Меъёри фоизӣ, % солона\",\n    \"calctext5\": \"Мӯҳлати пардохт\",\n    \"calctext6\": \"Пардохти моҳона\",\n    \"calctext7\": \"Арзиши пурраи қарз\",\n    \"calctext8\": \"Маблағи фоиз\",\n    \"calctext9\": \"Ҷадвали пардохт\",\n    \"footerText1\": \"Ба шахсони хусусӣ\",\n    \"footerText2\": \"Кортҳо\",\n    \"footerText3\": \"Express Card\",\n    \"footerText4\": \"Корти номй\",\n    \"footerText5\": \"Корти кобренди\",\n    \"footerText6\": \"Корти кудакона\",\n    \"footerText7\": \"Қарзҳо\",\n    \"footerText8\": \"Дастрас\",\n    \"footerText9\": \"Карзи автомобилй\",\n    \"footerText10\": \"Ипотека\",\n    \"footerText11\": \"Молхо ба насия\",\n    \"footerText12\": \"Қарзи истеъмоли\",\n    \"footerText13\": \"Қарзи Ломбард\",\n    \"footerText14\": \"Хисобкунаки қарзи\",\n    \"footerText15\": \"Интиқоли маблағҳо\",\n    \"footerText16\": \"Интиқол аз Русия\",\n    \"footerText76\": \"Интиқол ба Русия\",\n    \"footerText77\": \"Интиқол ба Хитой\",\n    \"footerText18\": \"Contact\",\n    \"footerText19\": \"UniStream\",\n    \"footerText20\": \"Asia Plus\",\n    \"footerText21\": \"Tcell\",\n    \"footerText22\": \"Инчунин\",\n    \"footerText23\": \"Бонсухо\",\n    \"footerText24\": \"Хабархо\",\n    \"footerText25\": \"Қурби асъор\",\n    \"footerText26\": \"Барномаи мобилй\",\n    \"footerText27\": \"Онлайн идентификация\",\n    \"footerText28\": \"Саволу чавоб\",\n    \"footerText29\": \"Проектҳо\",\n    \"footerText30\": \"DC AVIA\