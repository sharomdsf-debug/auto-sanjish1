%; height: 22.4px; text-align: center;\\\"><strong>6</strong></td>\\r\\n<td style=\\\"width: 38.1106%; height: 22.4px;\\\">Эрназаров Достонбек Мухидиллоевич\\\"</td>\\r\\n<td style=\\\"width: 14.541%; height: 22.4px; text-align: center;\\\">Зафаробод</td>\\r\\n<td style=\\\"width: 43.2427%; height: 22.4px; text-align: left;\\\">Вил. Сугд н. Истаравшан, шахраки Симурғ</td>\\r\\n</tr>\\r\\n<tr style=\\\"height: 22.4px;\\\">\\r\\n<td style=\\\"width: 4.08668%; height: 22.4px; text-align: center;\\\"><strong>7</strong></td>\\r\\n<td style=\\\"width: 38.1106%; height: 22.4px;\\\">Қурбонов Руҳидин Ҳуснидинович\\\"</td>\\r\\n<td style=\\\"width: 14.541%; height: 22.4px; text-align: center;\\\">Бохтар&nbsp;</td>\\r\\n<td style=\\\"width: 43.2427%; height: 22.4px;\\\">Вил. Хатлон, н. Кубодиен, Ч/д И Ниезов , дех, Чорбог</td>\\r\\n</tr>\\r\\n<tr style=\\\"height: 22.4px;\\\">\\r\\n<td style=\\\"width: 4.08668%; height: 22.4px; text-align: center;\\\"><strong>8</strong></td>\\r\\n<td style=\\\"width: 38.1106%; height: 22.4px;\\\">Курбонов Шерхон Рузибоевич\\\"</td>\\r\\n<td style=\\\"width: 14.541%; height: 22.4px; text-align: center;\\\">Бохтар&nbsp;</td>\\r\\n<td style=\\\"width: 43.2427%; height: 22.4px;\\\">Вил. Хатлон, н. Кубодиен ч/д И. Ниёзов, Чорбог</td>\\r\\n</tr>\\r\\n</tbody>\\r\\n</table>\",\"description_tg\":\"<p><strong>Мизоҷони мӯҳтарам!</strong></p>\\r\\n<p>Ба маълумоти Шумо мерасонем, ки шахсоне дар поён зикрг гардида эътиборан хизматрасониҳои бонкиро <strong>анҷом намедиҳад</strong> ва агенти бонкии ҶСП Бонки \\\"Арванд\\\" намебошанд:</p>\\r\\n<p>&nbsp;</p>\",\"description_en\":null,\"created_at\":\"23.10.2026\",\"updated_at\":\"23.10.2026\",\"lft\":1,\"rght\":2,\"tree_id\":5,\"level\":0,\"parent\":null},{\"id\":153,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/0d/82/0d82d187-928f-4432-aea3-d01d384d17fc/3.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"aktsii\",\"name\":\"Аксияхо\"}],\"url\":\"/tg/pr/news/153/\",\"date\":\"09.11.2026\",\"backdating_at\":\"16.10.2026\",\"title\":\"Соҳиби iPhone 17 Pro Max-и нав бо пасандози «Муҳоҷир» шавед!\",\"title_ru\":\"Станьте обладателем нового iPhone 17 Pro Max с вкладом «Муҳоҷир»!\",\"title_tg\":\"Соҳиби iPhone 17 Pro Max-и нав бо пасандози «Муҳоҷир» шавед!\",\"title_en\":null,\"description\":\"<p>Мехоҳед маблағҳои худро на танҳо эҳтиёткорона нигоҳ доред, балки соҳиби туҳфаи қиматбаҳо гардед? Пасандози &laquo;Муҳоҷир&raquo; дар Бонки &laquo;Арванд&raquo; кушоед ва дар аксия иштирок намоед!</p>\\r\\n<p><strong><em>Чӣ тавр бояд иштирок кард:</em></strong></p>\\r\\n<ul>\\r\\n<li>Пасандози &laquo;Муҳоҷир&raquo;-ро бо сомонӣ онлайн тавассути ҳамёни мобилии &laquo;Арванд&raquo; (24/7 дастрас аст), ё дар марказҳои хизматрасонии бонкӣ кушоед.</li>\\r\\n<li>То анҷоми аксия як интиқоли пулиро тавассути Бонки &laquo;Арванд&raquo; қабул кунед.</li>\\r\\n<li>Бақияи минималиро дар пасандоз то 31 декабри соли 2026 на камтар аз 1000 сомонӣ нигоҳ доред.</li>\\r\\n<li>Рақами ID-и худро гиред ва иштирокчии аксия гардед!</li>\\r\\n</ul>\\r\\n<p>Байни ҳамаи иштирокчиёне, ки шартҳоро иҷро кардаанд, мо<strong> 7 адад смартфони iPhone 17 Pro Max (250 ГБ</strong>)-ро мебозем!</p>\\r\\n<p><strong>Мӯҳлати аксия: то 31 декабри соли 2026.</strong></p>\\r\\n<p>Пасандозро кушоед, шартҳои оддиро иҷро намоед ва соҳиби суперприз шавед!</p>\\r\\n<p>Бонки &laquo;Арванд&raquo;</p>\\r\\n<p><em>Дастгирии мо - Дастоварди шумо!</em></p>\\r\\n<p>&nbsp;</p>\",\"description_ru\":\"<p>Хотите не только надёжно сохранить свои сбережения, но и получить шанс выиграть ценный подарок? Откройте вклад &laquo;Муҳоҷир&raquo; в Банке &laquo;Арванд&raquo; и станьте участником акции!</p>\\r\\n<p><strong><em>Как принять участие:</em></strong></p>\\r\\n<ul>\\r\\n<li>Откройте вклад &laquo;Муҳоҷир&raquo; в сомони онлайн через мобильный кошелёк &laquo;Арванд&raquo; (доступен 24/7) или в любом центре банковского обслуживания.</li>\\r\\n<li>До окончания акции получите хотя бы один денежный перевод через Банк &laquo;Арванд&raquo;.</li>\\r\\n<li>Поддерживайте минимальный остаток на вкладе в размере не менее 1 000 сомони до 31 декабря 2026 года.</li>\\r\\n<li>Получите свой ID-номер и станьте участником акции!</li>\\r\\n</ul>\\r\\n<p>Среди всех участников, выполнивших условия акции, мы разыграем <strong>7 смартфонов iPhone 17 Pro Max (250 ГБ)!</strong></p>\\r\\n<p><strong>Срок проведения акции: до 31 декабря 2026 года.</strong></p>\\r\\n<p>Откройте вклад, выполните простые условия и получите шанс стать обладателем суперприза!</p>\\r\\n<p>Банк &laquo;Арванд&raquo;</p>\\r\\n<p><em>Наша поддержка &mdash; Ваш успех!</em></p>\\r\\n<p>&nbsp;</p>\",\"description_tg\":\"<p>Мехоҳед маблағҳои худро на танҳо эҳтиёткорона нигоҳ доред, балки соҳиби туҳфаи қиматбаҳо гардед? Пасандози &laquo;Муҳоҷир&raquo; дар Бонки &laquo;Арванд&raquo; кушоед ва дар аксия иштирок намоед!</p>\\r\\n<p><strong><em>Чӣ тавр бояд иштирок кард:</em></strong></p>\\r\\n<ul>\\r\\n<li>Пасандози &laquo;Муҳоҷир&raquo;-ро бо сомонӣ онлайн тавассути ҳамёни мобилии &laquo;Арванд&raquo; (24/7 дастрас аст), ё дар марказҳои хизматрасонии бонкӣ кушоед.</li>\\r\\n<li>То анҷоми аксия як интиқоли пулиро тавассути Бонки &laquo;Арванд&raquo; қабул кунед.</li>\\r\\n<li>Бақияи минималиро дар пасандоз то 31 декабри соли 2026 на камтар аз 1000 сомонӣ нигоҳ доред.</li>\\r\\n<li>Рақами ID-и худро гиред ва иштирокчии аксия гардед!</li>\\r\\n</ul>\\r\\n<p>Байни ҳамаи иштирокчиёне, ки шартҳоро иҷро кардаанд, мо<strong> 7 адад смартфони iPhone 17 Pro Max (250 ГБ</strong>)-ро мебозем!</p>\\r\\n<p><strong>Мӯҳлати аксия: то 31 декабри соли 2026.</strong></p>\\r\\n<p>Пасандозро кушоед, шартҳои оддиро иҷро намоед ва соҳиби суперприз шавед!</p>\\r\\n<p>Бонки &laquo;Арванд&raquo;</p>\\r\\n<p><em>Дастгирии мо - Дастоварди шумо!</em></p>\\r\\n<p>&nbsp;</p>\",\"description_en\":null,\"created_at\":\"09.11.2026\",\"updated_at\":\"09.11.2026\",\"lft\":1,\"rght\":2,\"tree_id\":6,\"level\":0,\"parent\":null}],\"tabs\":[{\"slug\":\"esg\",\"name\":\"ESG\",\"news\":[{\"id\":138,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/43/ae/43aefd29-21de-4a58-b315-feebcca4b9c9/photo_2026-08-14_17-34-45.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/138/\",\"date\":\"14.08.2026\",\"backdating_at\":\"14.08.2026\",\"title\":\"Продолжаем ESG: повышаем экологическую осведомленность населения вместе с Банком «Арванд»\",\"title_ru\":\"Продолжаем ESG: повышаем экологическую осведомленность населения вместе с Банком «Арванд»\",\"title_tg\":null,\"title_en\":null,\"description\":\"<p>В рамках проекта Банк &laquo;Арванд&raquo; организовал стади-тур и День открытых дверей на демонстрационном участке клиента программы GEFF в районе Деваштич с командой GEFF Таджикистан. Цель мероприятия &mdash; показать, как современные экологически устойчивые технологии помогают развивать агробизнес, экономить ресурсы и повышать эффективность сельского хозяйства.</p>\\r\\n<p>Наши клиенты, фермеры и предприниматели смогли на практике увидеть применение &laquo;зеленых&raquo; решений, среди которых:</p>\\r\\n<ul>\\r\\n<li>капельное орошение и фертигация;</li>\\r\\n<li>солнечные панели и возобновляемая энергия;</li>\\r\\n<li>резервуар для сбора и хранения воды;</li>\\r\\n<li>интенсивный сад;</li>\\r\\n<li>цифровые технологии в сельском хозяйстве</li>\\r\\n</ul>\\r\\n<p>Участники ознакомились с преимуществами экологически устойчивых технологий, оценили их экономическую эффективность и получили информацию о возможностях финансирования таких решений через программу GEFF.</p>\\r\\n<p>Для Банка &laquo;Арванд&raquo; ESG &mdash; это не только финансирование устойчивых проектов, но и повышение осведомленности населения, поддержка фермеров и предпринимателей, а также продвижение практик, способствующих бережному использованию природных ресурсов и устойчивому развитию регионов.</p>\",\"description_ru\":\"<p>В рамках проекта Банк &laquo;Арванд&raquo; организовал стади-тур и День открытых дверей на демонстрационном участке клиента программы GEFF в районе Деваштич с командой GEFF Таджикистан. Цель мероприятия &mdash; показать, как современные экологически устойчивые технологии помогают развивать агробизнес, экономить ресурсы и повышать эффективность сельского хозяйства.</p>\\r\\n<p>Наши клиенты, фермеры и предприниматели смогли на практике увидеть применение &laquo;зеленых&raquo; решений, среди которых:</p>\\r\\n<ul>\\r\\n<li>капельное орошение и фертигация;</li>\\r\\n<li>солнечные панели и возобновляемая энергия;</li>\\r\\n<li>резервуар для сбора и хранения воды;</li>\\r\\n<li>интенсивный сад;</li>\\r\\n<li>цифровые технологии в сельском хозяйстве</li>\\r\\n</ul>\\r\\n<p>Участники ознакомились с преимуществами экологически устойчивых технологий, оценили их экономическую эффективность и получили информацию о возможностях финансирования таких решений через программу GEFF.</p>\\r\\n<p>Для Банка &laquo;Арванд&raquo; ESG &mdash; это не только финансирование устойчивых проектов, но и повышение осведомленности населения, поддержка фермеров и предпринимателей, а также продвижение практик, способствующих бережному использованию природных ресурсов и устойчивому развитию регионов.</p>\",\"description_tg\":null,\"description_en\":null,\"created_at\":\"14.08.2026\",\"updated_at\":\"17.08.2026\",\"lft\":1,\"rght\":2,\"tree_id\":12,\"level\":0,\"parent\":null},{\"id\":132,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/9b/b2/9bb2d460-0c1d-4b39-9618-5eec6f3244e2/photo_2026-06-09_10-24-34.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/132/\",\"date\":\"09.06.2026\",\"backdating_at\":\"06.06.2026\",\"title\":\"Бонки «Арванд» маблағгузории нави GEFF II-ро барои рушди иқтисоди сабз ҷалб менамояд!\",\"title_ru\":\"Банк «Арванд» привлекает новое финансирование GEFF II для развития зелёной экономики!\",\"title_tg\":\"Бонки «Арванд» маблағгузории нави GEFF II-ро барои рушди иқтисоди сабз ҷалб менамояд!\",\"title_en\":\"Bank Arvand Secures New GEFF II Financing to Support Green Economy Development in Tajikistan\",\"description\":\"<p>Бонки &laquo;Арванд&raquo; дар доираи барномаи минтақавии <strong>Green Economy Financing Facility (GEFF II)</strong> аз ҷониби <strong>Бонки Аврупоии Таҷдид ва Рушд (EBRD</strong>) ва <strong>Фонди иқлими сабз (Green Climate Fund &ndash; GCF)</strong> маблағгузории навро ба маблағи умумии <strong>5 миллион доллари ИМА</strong> ҷалб менамояд.</p>\\r\\n<p>Маросими имзои созишнома 6 июни соли 2026 дар шаҳри Рига (Ҷумҳурии Латвия) дар доираи ҷаласаи солонаи Бонки Аврупоии Таҷдид ва Рушд баргузор гардид. Дар маросими имзои созишнома аз ҷониби Бонки &laquo;Арванд&raquo; Раиси Раёсати ҶСП &laquo;Бонки Арванд&raquo; Содиқова Шоира Музаффаровна ва аз ҷониби Директори иҷроия ва роҳбари гурӯҳи фаъолияти муассисаҳои молиявии EBRD Франсис Малиж (Francis Malige) иштирок намуданд.</p>\\r\\n<p>Аз маблағи умумӣ <strong>3,75 миллион доллари ИМА аз ҷониби EBRD</strong> ва <strong>1,25 миллион доллари ИМА аз ҷониби Фонди иқлими сабз</strong> пешниҳод гардида, барои маблағгузории лоиҳаҳои самаранокии энергетикӣ, технологияҳои мутобиқшавӣ ба тағйирёбии иқлим ва рушди иқтисоди сабз дар Тоҷикистон равона карда мешавад.</p>\\r\\n<p>Ин панҷумин ҳамкории Бонки &laquo;Арванд&raquo; дар доираи барномаи GEFF буда, идомаи муваффақонаи татбиқи ташаббусҳои қаблӣ ва саҳми муҳим дар рушди бозори молияи сабз дар Тоҷикистон мебошад.</p>\\r\\n<p>Маблағгузории нав имконият медиҳад, ки Бонки &laquo;Арванд&raquo; пешниҳоди маҳсулоти қарзии сабзро боз ҳам васеъ намуда, махсусан соҳибкорони хурду миёна, бахши кишоварзӣ ва минтақаҳои деҳотро бо технологияҳои инноватсионӣ ва экологӣ дастгирӣ намояд.</p>\\r\\n<p>Яке аз самтҳои муҳими лоиҳа дастгирии соҳибкории занон мебошад. Дар доираи усули <strong>Gender SMART ҳадди ақал 30 фоизи маблағгузорӣ</strong> ба занон ва соҳибкории таҳти роҳбарии занон равона гардида, барои таъмини дастрасии баробар ба маблағгузории сабз ва рушди фарогири иқтисодӣ мусоидат хоҳад кард.</p>\\r\\n<p>Ин сармоягузории нав боз як қадами муҳим дар роҳи рушди устувор, дастгирии иқтисоди сабз ва баланд бардоштани сатҳи зиндагии аҳолии Тоҷикистон мебошад.</p>\",\"description_ru\":\"<p>Банк &laquo;Арванд&raquo; в рамках региональной программы <strong>Green Economy Financing Facility (GEFF II)</strong> привлекает новое финансирование в размере<strong> 5 миллионов долларов США</strong>, предоставленное <strong>Европейским банком реконструкции и развития (ЕБРР)</strong> и <strong>Зелёным климатическим фондом (Green Climate Fund &ndash; GCF)</strong>.</p>\\r\\n<p>Церемония подписания соглашения состоялась 6 июня 2026 года в городе Рига (Латвийская Республика) в рамках ежегодного заседания Европейского банка реконструкции и развития. Со стороны Банка &laquo;Арванд&raquo; соглашение подписала Председатель Правления ЗАО &laquo;Банк Арванд&raquo; Шоира Музаффаровна Содикова, а со стороны ЕБРР &mdash; исполнительный директор и руководитель группы по работе с финансовыми учреждениями Фрэнсис Малиж (Francis Malige).</p>\\r\\n<p>Из общего объёма финансирования <strong>3,75 миллиона долларов США предоставляются ЕБРР, а 1,25 миллиона долларов США &mdash; Зелёным климатическим фондом</strong>. Средства будут направлены на финансирование проектов в области энергоэффективности, технологий адаптации к изменению климата и развития зелёной экономики в Таджикистане.</p>\\r\\n<p>Это уже пятое сотрудничество Банка &laquo;Арванд&raquo; в рамках программы GEFF, которое является успешным продолжением ранее реализованных инициатив и важным вкладом в развитие рынка зелёного финансирования в Таджикистане.</p>\\r\\n<p>Новое финансирование позволит Банку &laquo;Арванд&raquo; ещё больше расширить линейку зелёных кредитных продуктов, уделяя особое внимание поддержке малого и среднего бизнеса, сельскохозяйственного сектора и сельских регионов посредством внедрения инновационных и экологически устойчивых технологий.</p>\\r\\n<p>Одним из ключевых направлений проекта является поддержка женского предпринимательства. В рамках подхода <strong>Gender SMART не менее 30% финансирования</strong> будет направлено женщинам и предприятиям, возглавляемым женщинами, что будет способствовать обеспечению равного доступа к зелёному финансированию и развитию инклюзивной экономики.</p>\\r\\n<p>Данное финансирование станет ещё одним важным шагом на пути к устойчивому развитию, поддержке зелёной экономики и повышению качества жизни населения Таджикистана.</p>\",\"description_tg\":\"<p>Бонки &laquo;Арванд&raquo; дар доираи барномаи минтақавии <strong>Green Economy Financing Facility (GEFF II)</strong> аз ҷониби <strong>Бонки Аврупоии Таҷдид ва Рушд (EBRD</strong>) ва <strong>Фонди иқлими сабз (Green Climate Fund &ndash; GCF)</strong> маблағгузории навро ба маблағи умумии <strong>5 миллион доллари ИМА</strong> ҷалб менамояд.</p>\\r\\n<p>Маросими имзои созишнома 6 июни соли 2026 дар шаҳри Рига (Ҷумҳурии Латвия) дар доираи ҷаласаи солонаи Бонки Аврупоии Таҷдид ва Рушд баргузор гардид. Дар маросими имзои созишнома аз ҷониби Бонки &laquo;Арванд&raquo; Раиси Раёсати ҶСП &laquo;Бонки Арванд&raquo; Содиқова Шоира Музаффаровна ва аз ҷониби Директори иҷроия ва роҳбари гурӯҳи фаъолияти муассисаҳои молиявии EBRD Франсис Малиж (Francis Malige) иштирок намуданд.</p>\\r\\n<p>Аз маблағи умумӣ <strong>3,75 миллион доллари ИМА аз ҷониби EBRD</strong> ва <strong>1,25 миллион доллари ИМА аз ҷониби Фонди иқлими сабз</strong> пешниҳод гардида, барои маблағгузории лоиҳаҳои самаранокии энергетикӣ, технологияҳои мутобиқшавӣ ба тағйирёбии иқлим ва рушди иқтисоди сабз дар Тоҷикистон равона карда мешавад.</p>\\r\\n<p>Ин панҷумин ҳамкории Бонки &laquo;Арванд&raquo; дар доираи барномаи GEFF буда, идомаи муваффақонаи татбиқи ташаббусҳои қаблӣ ва саҳми муҳим дар рушди бозори молияи сабз дар Тоҷикистон мебошад.</p>\\r\\n<p>Маблағгузории нав имконият медиҳад, ки Бонки &laquo;Арванд&raquo; пешниҳоди маҳсулоти қарзии сабзро боз ҳам васеъ намуда, махсусан соҳибкорони хурду миёна, бахши кишоварзӣ ва минтақаҳои деҳотро бо технологияҳои инноватсионӣ ва экологӣ дастгирӣ намояд.</p>\\r\\n<p>Яке аз самтҳои муҳими лоиҳа дастгирии соҳибкории занон мебошад. Дар доираи усули <strong>Gender SMART ҳадди ақал 30 фоизи маблағгузорӣ</strong> ба занон ва соҳибкории таҳти роҳбарии занон равона гардида, барои таъмини дастрасии баробар ба маблағгузории сабз ва рушди фарогири иқтисодӣ мусоидат хоҳад кард.</p>\\r\\n<p>Ин сармоягузории нав боз як қадами муҳим дар роҳи рушди устувор, дастгирии иқтисоди сабз ва баланд бардоштани сатҳи зиндагии аҳолии Тоҷикистон мебошад.</p>\",\"description_en\":\"<p>Bank Arvand has secured a new <strong>USD 5 million</strong> financing facility under the <strong>Green Economy Financing Facility (GEFF II)</strong> programme, supported by the <strong>European Bank for Reconstruction and Development (EBRD)</strong> and the <strong>Green Climate Fund (GCF)</strong>.</p>\\r\\n<p>The financing agreement was signed on 6 June 2026 in Riga, Latvia, during the EBRD Annual Meeting. The signing ceremony was attended by Mrs. Shoira Muzaffarovna Sodiqova, Chairperson of the Management Board of Bank Arvand, and Mr. Francis Malige, Managing Director and Head of the Financial Institutions Business Group at the EBRD.</p>\\r\\n<p>The financing package includes <strong>USD 3.75 million from the EBRD</strong> and <strong>USD 1.25 million from the Green Climate Fund</strong>, aimed at supporting investments in energy efficiency, climate change mitigation and adaptation technologies, and sustainable green development across Tajikistan.</p>\\r\\n<p>This transaction represents Bank Arvand&rsquo;s fifth participation under the GEFF programme, reflecting the successful implementation of previous facilities and reinforcing the Bank&rsquo;s long-term commitment to expanding green finance in the country.</p>\\r\\n<p>The new funding will enable Bank Arvand to further expand its portfolio of green financial products, providing greater access to financing for micro, small and medium-sized enterprises, particularly in agriculture and rural areas, while promoting the adoption of innovative climate-friendly technologies.</p>\\r\\n<p>A key feature of the programme is its <strong>Gender SMART approach, under which at least 30% of the financing</strong> volume will be directed to women and women-led businesses, promoting equal access to green finance and supporting inclusive economic growth.</p>\\r\\n<p>This new financing marks another significant milestone in Bank Arvand&rsquo;s strategy to promote sustainable development, expand green finance, and contribute to building a more resilient, inclusive, and environmentally responsible economy in Tajikistan.</p>\",\"created_at\":\"09.06.2026\",\"updated_at\":\"09.06.2026\",\"lft\":1,\"rght\":2,\"tree_id\":23,\"level\":0,\"parent\":null},{\"id\":127,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/5e/6a/5e6a5177-c18d-4230-9a39-e02557372c9d/sabzi_faol.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/127/\",\"date\":\"25.05.2026\",\"backdating_at\":\"19.05.2026\",\"title\":\"Пасандози нав \\\"Сабзи фаъол\\\"\",\"title_ru\":\"Новый депозит \\\"Сабзи фаъол\\\"\",\"title_tg\":\"Пасандози нав \\\"Сабзи фаъол\\\"\",\"title_en\":null,\"description\":\"<p><strong>Деньги должны приносить деньги, а не &laquo;спать под подушкой&raquo;!</strong></p>\\r\\n<p>Вы когда-нибудь задумывались, сколько денег теряете, храня средства на обычной карте без начисления процентов? С новым вкладом &laquo;Сабзи Фаъол&raquo; от Банка &laquo;Арванд&raquo; ваши средства будут приносить доход каждый месяц.</p>\\r\\n<p><strong>Что такое &laquo;Сабзи Фаъол&raquo;?</strong></p>\\r\\n<p>Это ваш цифровой кошелёк, который растёт сам по себе.</p>\\r\\n<p><em>&bull; 11% годовых в сомони на остаток счёта.</em></p>\\r\\n<p><em>&bull; Открывается за 1 минуту через мобильное приложение.</em></p>\\r\\n<p><em>&bull; Пополняйте счёт и снимайте деньги в любое время &mdash; без ограничений.</em></p>\\r\\n<p>Вклады и депозиты клиентов ЗАО Банк &laquo;Арванд&raquo; застрахованы Фондом страхования вкладов и депозитов Таджикистана.</p>\\r\\n<p>Напишите в комментариях: на что бы вы потратили дополнительный доход, полученный от процентов? Посмотрим, у кого самые интересные цели!</p>\",\"description_ru\":\"<p><strong>Деньги должны приносить деньги, а не &laquo;спать под подушкой&raquo;!</strong></p>\\r\\n<p>Вы когда-нибудь задумывались, сколько денег теряете, храня средства на обычной карте без начисления процентов? С новым вкладом &laquo;Сабзи Фаъол&raquo; от Банка &laquo;Арванд&raquo; ваши средства будут приносить доход каждый месяц.</p>\\r\\n<p><strong>Что такое &laquo;Сабзи Фаъол&raquo;?</strong></p>\\r\\n<p>Это ваш цифровой кошелёк, который растёт сам по себе.</p>\\r\\n<p><em>&bull; 11% годовых в сомони на остаток счёта.</em></p>\\r\\n<p><em>&bull; Открывается за 1 минуту через мобильное приложение.</em></p>\\r\\n<p><em>&bull; Пополняйте счёт и снимайте деньги в любое время &mdash; без ограничений.</em></p>\\r\\n<p>Вклады и депозиты клиентов ЗАО Банк &laquo;Арванд&raquo; застрахованы Фондом страхования вкладов и депозитов Таджикистана.</p>\\r\\n<p>Напишите в комментариях: на что бы вы потратили дополнительный доход, полученный от процентов? Посмотрим, у кого самые интересные цели!</p>\",\"description_tg\":null,\"description_en\":null,\"created_at\":\"25.05.2026\",\"updated_at\":\"25.05.2026\",\"lft\":1,\"rght\":2,\"tree_id\":26,\"level\":0,\"parent\":null},{\"id\":126,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/a5/5e/a55e0595-5016-4f63-94c8-7d19f14f1dc7/photo_2026-05-05_09-22-04.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/126/\",\"date\":\"08.05.2026\",\"backdating_at\":\"02.05.2026\",\"title\":\"«Рӯзи дарҳои кушод» дар ноҳияи Вахш\",\"title_ru\":\"«День открытых дверей» в Вахшском районе\",\"title_tg\":\"«Рӯзи дарҳои кушод» дар ноҳияи Вахш\",\"title_en\":\"“Open Day” in the Vakhsh district\",\"description\":\"<p data-start=\\\"819\\\" data-end=\\\"1084\\\">2 май дар доираи барномаи <strong>GEFF II Tajikistan</strong> бо дастгирии БАТР, <strong>Бонки &laquo;Арванд&raquo;</strong> якҷо бо дастаи GEFF II Tajikistan бо мақсади баланд бардоштани сатҳи огоҳии аҳолӣ дар қитъаи намоишии Хоҷагии деҳқонии &laquo;Танзила&raquo; дар ноҳияи Вахш <strong>&laquo;Рӯзи дарҳои кушод&raquo;</strong>-ро баргузор намуданд.</p>\\r\\n<p data-start=\\\"1086\\\" data-end=\\\"1269\\\">Иштирокчиён бо технологияҳои муосири гармхонаӣ ва &laquo;сабз&raquo;, аз ҷумла обёрии қатрагӣ, кишоварзии амудӣ, панелҳои офтобӣ, нуриҳои биологӣ ва ҳалли рақамӣ дар соҳаи кишоварзӣ шинос шуданд.</p>\\r\\n<p data-start=\\\"1271\\\" data-end=\\\"1528\\\">Аз ҷониби Бонки &laquo;Арванд&raquo; <strong>Қосимова Гулнора</strong> баромад намуда, имкониятҳои маблағгузориро дар доираи барномаи GEFF муаррифӣ кард. Ҳамчунин, аз ҷониби мушовири лоиҳа <strong>Ҷӯраев Садриддин</strong> оид ба ҷорӣ намудани технологияҳои сабз дар агробизнес маълумот пешниҳод гардид.</p>\\r\\n<p>&nbsp;</p>\\r\\n<p data-start=\\\"1530\\\" data-end=\\\"1631\\\" data-is-last-node=\\\"\\\" data-is-only-node=\\\"\\\">Чорабинӣ ба майдони мубодилаи таҷриба ва пешбурди роҳҳалҳои устувор дар бахши агросаноатӣ табдил ёфт.</p>\",\"description_ru\":\"<p style=\\\"text-align: left;\\\">2 мая в рамках программы <strong>GEFF II Tajikistan</strong> при поддержке ЕБРР <strong>Банк &laquo;Арванд&raquo;</strong> совместно с командой GEFF II Tajikistan провели <strong>&laquo;День открытых дверей&raquo;</strong> с целью повышения осведомленности населения на демонстрационном участке Дехканского хозяйства &laquo;Танзила&raquo; в Вахшском районе.</p>\\r\\n<p style=\\\"text-align: left;\\\">Участники ознакомились с современными тепличными и <strong>&laquo;зелеными&raquo; технологиями</strong>: капельным орошением, вертикальным земледелием, солнечными панелями, биоудобрениями и цифровыми решениями в сельском хозяйстве.</p>\\r\\n<p style=\\\"text-align: left;\\\">Со стороны Банка &laquo;Арванд&raquo; выступила <strong>Косимова Гулнора</strong>, представив возможности финансирования в рамках GEFF, а со стороны консультантов проекта <strong>Джураев Садриддин</strong>, который рассказал о внедрении зеленых технологий в агробизнесе.</p>\\r\\n<p style=\\\"text-align: left;\\\">Мероприятие стало площадкой для обмена опытом и продвижения устойчивых решений в агросекторе.</p>\",\"description_tg\":\"<p data-start=\\\"819\\\" data-end=\\\"1084\\\">2 май дар доираи барномаи <strong>GEFF II Tajikistan</strong> бо дастгирии БАТР, <strong>Бонки &laquo;Арванд&raquo;</strong> якҷо бо дастаи GEFF II Tajikistan бо мақсади баланд бардоштани сатҳи огоҳии аҳолӣ дар қитъаи намоишии Хоҷагии деҳқонии &laquo;Танзила&raquo; дар ноҳияи Вахш <strong>&laquo;Рӯзи дарҳои кушод&raquo;</strong>-ро баргузор намуданд.</p>\\r\\n<p data-start=\\\"1086\\\" data-end=\\\"1269\\\">Иштирокчиён бо технологияҳои муосири гармхонаӣ ва &laquo;сабз&raquo;, аз ҷумла обёрии қатрагӣ, кишоварзии амудӣ, панелҳои офтобӣ, нуриҳои биологӣ ва ҳалли рақамӣ дар соҳаи кишоварзӣ шинос шуданд.</p>\\r\\n<p data-start=\\\"1271\\\" data-end=\\\"1528\\\">Аз ҷониби Бонки &laquo;Арванд&raquo; <strong>Қосимова Гулнора</strong> баромад намуда, имкониятҳои маблағгузориро дар доираи барномаи GEFF муаррифӣ кард. Ҳамчунин, аз ҷониби мушовири лоиҳа <strong>Ҷӯраев Садриддин</strong> оид ба ҷорӣ намудани технологияҳои сабз дар агробизнес маълумот пешниҳод гардид.</p>\\r\\n<p>&nbsp;</p>\\r\\n<p data-start=\\\"1530\\\" data-end=\\\"1631\\\" data-is-last-node=\\\"\\\" data-is-only-node=\\\"\\\">Чорабинӣ ба майдони мубодилаи таҷриба ва пешбурди роҳҳалҳои устувор дар бахши агросаноатӣ табдил ёфт.</p>\",\"description_en\":\"<p data-start=\\\"13\\\" data-end=\\\"278\\\">On May 2, within the framework of the <strong>GEFF II Tajikistan</strong> program supported by the EBRD, <strong>Bank Arvand</strong> together with the GEFF II Tajikistan team held an <strong>&ldquo;Open Day&rdquo;</strong> at the demonstration site of the &ldquo;Tanzila&rdquo; Dehkan Farm in the Vakhsh district to raise public awareness.</p>\\r\\n<p data-start=\\\"280\\\" data-end=\\\"461\\\">Participants learned about modern greenhouse and green technologies, including drip irrigation, vertical farming, solar panels, biofertilizers, and digital solutions in agriculture.</p>\\r\\n<p data-start=\\\"463\\\" data-end=\\\"684\\\">Representing Bank Arvand, <strong>Gulnora Kosimova</strong> presented financing opportunities available under the GEFF program. Project consultant <strong>Sadriddin Juraev</strong> also spoke about the implementation of green technologies in agribusiness.</p>\\r\\n<p>&nbsp;</p>\\r\\n<p data-start=\\\"686\\\" data-end=\\\"800\\\">The event became a platform for sharing experience and promoting sustainable solutions in the agricultural sector.</p>\",\"created_at\":\"08.05.2026\",\"updated_at\":\"08.05.2026\",\"lft\":1,\"rght\":2,\"tree_id\":27,\"level\":0,\"parent\":null},{\"id\":124,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/c3/16/c316070a-8f47-4659-8a69-c05db92578ba/photo_2026-05-05_09-33-05.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/124/\",\"date\":\"01.05.2026\",\"backdating_at\":\"01.05.2026\",\"title\":\"Бонки «Арванд» ҳамчун беҳтарин оид ба пешниҳоди хизматрасониҳои ғайрибонкӣ ба бонувони соҳибкор эътироф гардид\",\"title_ru\":\"Банк «Арванд» признан лучшим по предоставлению небанковских услуг женщинам-предпринимателям\",\"title_tg\":\"Бонки «Арванд» ҳамчун беҳтарин оид ба пешниҳоди хизматрасониҳои ғайрибонкӣ ба бонувони соҳибкор эътироф гардид\",\"title_en\":null,\"description\":\"<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонки &laquo;Арванд&raquo; дар озмуни <strong>&laquo;Беҳтарин ташкилоти қарзӣ оид ба пешниҳоди хизматрасониҳои ғайрибонкӣ ба бонувони соҳибкор&raquo;</strong>, ки аз ҷониби Бонки миллии Тоҷикистон ташкил гардид, ҷои аввалро ишғол намуд.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Озмун ба дастгирии ташкилотҳои молиявие равона шудааст, ки дар рушди соҳибкории занон ва фароҳам овардани дастрасӣ ба хизматрасониҳои молиявӣ барои онҳо саҳм мегузоранд.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Ин дастоварди Бонки &laquo;Арванд&raquo; натиҷаи кори мунтазам дар самти таҳияи хизматрасониҳои дастрас ва қулай барои </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувони</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> соҳибкор мебошад. Бонк пайваста маҳсулот ва ташаббусҳоро барои дастгирии занон рушд медиҳад, аз ҷумла омӯзиш, машварат ва дастрасии содда ба воситаҳои молиявӣ.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Аз рӯзҳои аввали фаъолияти худ Бонки &laquo;Арванд&raquo; ба дастгирии </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувони </span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">соҳибкор аҳамияти махсус медиҳад ва ин самтро ҳамчун яке аз афзалиятҳои стратегии худ муайян намудааст. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонк мунтазам дар барномаҳо ва лоиҳаҳои байналмилалӣ, ки ба дастгирии соҳибкории </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> равона шудаанд, иштирок менамояд. Аз ҷумла, &laquo;Арванд&raquo; иштирокчии барномаи &laquo;Women in Business&raquo;-и Бонки аврупоии таҷдид ва рушд буда, ҳамчунин бо ташкилотҳои байналмилалӣ, аз қабили IFC ҳамкорӣ мекунад, ки ба васеъ намудани имкониятҳои молиявӣ барои </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> мусоидат менамояд. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Қаблан низ бонк дар ин самт ба дастовардҳои назаррас ноил гардида, соҳиби ҷоизаҳо ва эътирофи миллӣ ва байналмилалӣ шудааст. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонки &laquo;Арванд&raquo; ба ҳамаи мизоҷони худ &mdash; бонувони соҳибкор изҳори миннатдорӣ менамояд. Маҳз бо шарофати эътимод ва фаъолияти онҳо ин дастовард имконпазир гардид.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Барои Бонки &laquo;Арванд&raquo; рушди соҳибкории </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> танҳо як самт нест, балки қисми муҳими рисолати иҷтимоии он мебошад. Бонк минбаъд низ барои фароҳам овардани имкониятҳои бештар ба занон ва дастгирии онҳо дар рушди фаъолияти соҳибкорӣ талош хоҳад кард.</span></p>\",\"description_ru\":\"<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Банк &laquo;Арванд&raquo; занял первое место в конкурсе <strong>&laquo;Лучшая кредитная организация по предоставлению небанковских услуг женщинам-предпринимателям&raquo;</strong>, организованном Национальным банком Таджикистана.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Конкурс был направлен на поддержку финансовых организаций, которые вносят вклад в развитие женского предпринимательства и расширение доступа к финансовым услугам для женщин.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Победа Банка &laquo;Арванд&raquo; &mdash; это результат системной работы по созданию доступных и удобных решений для женщин, ведущих собственный бизнес. Банк активно развивает продукты и инициативы, направленные на поддержку женщин-предпринимателей, включая обучение, консультации и упрощённый доступ к финансовым инструментам.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">С самого начала своей деятельности Банк &laquo;Арванд&raquo; уделяет особое внимание именно женщинам-предпринимателям. Сегодня банк продолжает эту стратегию, оставаясь одним из лидеров в развитии женского предпринимательства в стране. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Банк на постоянной основе участвует в международных программах и инициативах, направленных на поддержку женщин в бизнесе. В частности, &laquo;Арванд&raquo; является участником программы &laquo;Женщины в бизнесе&raquo; Европейского банка реконструкции и развития, а также сотрудничает с международными финансовыми институтами, такими как IFC, расширяя доступ женщин к финансированию и знаниям. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Ранее банк уже получал признание в этом направлении &mdash; становился победителем и лауреатом профильных конкурсов, а также отмечался международными наградами за вклад в развитие финансовой инклюзии и поддержку предпринимательства. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Банк &laquo;Арванд&raquo; выражает искреннюю благодарность своим клиентам &mdash; женщинам-предпринимателям. Именно их доверие, активность и стремление развивать своё дело стали важной частью этого достижения.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Для Банка &laquo;Арванд&raquo; развитие женского предпринимательства &mdash; это не просто одно из направлений, а важная часть социальной миссии. Банк и дальше будет работать над тем, чтобы создавать ещё больше возможностей для женщин, помогая им уверенно развивать своё дело и достигать новых результатов.</span></p>\",\"description_tg\":\"<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонки &laquo;Арванд&raquo; дар озмуни <strong>&laquo;Беҳтарин ташкилоти қарзӣ оид ба пешниҳоди хизматрасониҳои ғайрибонкӣ ба бонувони соҳибкор&raquo;</strong>, ки аз ҷониби Бонки миллии Тоҷикистон ташкил гардид, ҷои аввалро ишғол намуд.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Озмун ба дастгирии ташкилотҳои молиявие равона шудааст, ки дар рушди соҳибкории занон ва фароҳам овардани дастрасӣ ба хизматрасониҳои молиявӣ барои онҳо саҳм мегузоранд.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Ин дастоварди Бонки &laquo;Арванд&raquo; натиҷаи кори мунтазам дар самти таҳияи хизматрасониҳои дастрас ва қулай барои </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувони</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> соҳибкор мебошад. Бонк пайваста маҳсулот ва ташаббусҳоро барои дастгирии занон рушд медиҳад, аз ҷумла омӯзиш, машварат ва дастрасии содда ба воситаҳои молиявӣ.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Аз рӯзҳои аввали фаъолияти худ Бонки &laquo;Арванд&raquo; ба дастгирии </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувони </span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">соҳибкор аҳамияти махсус медиҳад ва ин самтро ҳамчун яке аз афзалиятҳои стратегии худ муайян намудааст. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонк мунтазам дар барномаҳо ва лоиҳаҳои байналмилалӣ, ки ба дастгирии соҳибкории </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> равона шудаанд, иштирок менамояд. Аз ҷумла, &laquo;Арванд&raquo; иштирокчии барномаи &laquo;Women in Business&raquo;-и Бонки аврупоии таҷдид ва рушд буда, ҳамчунин бо ташкилотҳои байналмилалӣ, аз қабили IFC ҳамкорӣ мекунад, ки ба васеъ намудани имкониятҳои молиявӣ барои </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> мусоидат менамояд. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Қаблан низ бонк дар ин самт ба дастовардҳои назаррас ноил гардида, соҳиби ҷоизаҳо ва эътирофи миллӣ ва байналмилалӣ шудааст. </span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Бонки &laquo;Арванд&raquo; ба ҳамаи мизоҷони худ &mdash; бонувони соҳибкор изҳори миннатдорӣ менамояд. Маҳз бо шарофати эътимод ва фаъолияти онҳо ин дастовард имконпазир гардид.</span></p>\\r\\n<p class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; line-height: normal;\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\">Барои Бонки &laquo;Арванд&raquo; рушди соҳибкории </span><span lang=\\\"TG\\\" style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: TG; mso-fareast-language: RU;\\\">бонувон</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-fareast-language: RU;\\\"> танҳо як самт нест, балки қисми муҳими рисолати иҷтимоии он мебошад. Бонк минбаъд низ барои фароҳам овардани имкониятҳои бештар ба занон ва дастгирии онҳо дар рушди фаъолияти соҳибкорӣ талош хоҳад кард.</span></p>\",\"description_en\":\"<p><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">Bank \\\"Arvand\\\" has taken first place in the competition&nbsp;</span><strong style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">&ldquo;Best Credit Organization for Providing Non-Banking Services to Women Entrepreneurs&rdquo;</strong><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">, organized by the National Bank of Tajikistan.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">The competition aimed to support financial institutions that contribute to the development of women&rsquo;s entrepreneurship and expand women&rsquo;s access to financial services.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">This achievement reflects Bank \\\"Arvand\\\" systematic efforts to create accessible and convenient solutions for women running their own businesses. The bank actively develops products and initiatives aimed at supporting women entrepreneurs, including training, advisory services, and simplified access to financial tools.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">Since the beginning of its operations, Bank \\\"Arvand\\\" has placed special emphasis on supporting women entrepreneurs. Today, the bank continues this strategy and remains one of the leaders in advancing women&rsquo;s entrepreneurship in the country.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">The bank regularly participates in international programs and initiatives focused on supporting women in business. In particular, Arvand is a participant in the European Bank for Reconstruction and Development&rsquo;s&nbsp;</span><strong style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">Women in Business</strong><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">&nbsp;program and collaborates with international financial institutions such as IFC, expanding women&rsquo;s access to financing and knowledge.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">Previously, the Bank has also received recognition in this area&mdash;becoming a winner and laureate of specialized competitions, as well as receiving international awards for its contribution to financial inclusion and the development of entrepreneurship.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">Bank \\\"Arvand\\\" expresses its sincere gratitude to its clients&mdash;women entrepreneurs. Their trust, initiative, and determination to grow their businesses have been an essential part of this achievement.</span><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><br style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\" /><span style=\\\"font-family: 'Times New Roman', serif; font-size: 16px;\\\">For Bank \\\"Arvand\\\", the development of women&rsquo;s entrepreneurship is not just one of its focus areas, but an important part of its social mission. The bank will continue working to create even more opportunities for women, helping them confidently grow their businesses and achieve new success.</span></p>\",\"created_at\":\"01.05.2026\",\"updated_at\":\"08.05.2026\",\"lft\":1,\"rght\":2,\"tree_id\":28,\"level\":0,\"parent\":null},{\"id\":88,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/c9/15/c915e766-af9d-4dfd-af6b-55adc8977ddf/pr-2025-93_ifad.jpg__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"esg\",\"name\":\"ESG\"}],\"url\":\"/tg/pr/news/88/\",\"date\":\"18.12.2025\",\"backdating_at\":\"18.12.2025\",\"title\":\"МФСР и Банк «Арванд» поддерживают программу REMIT PRIME.\",\"title_ru\":\"МФСР и Банк «Арванд» поддерживают программу REMIT PRIME.\",\"title_tg\":null,\"title_en\":null,\"description\":\"<p class=\\\"MsoNormal\\\"><strong><span lang=\\\"ru\\\">9 </span></strong><strong>декабря<span lang=\\\"EN-US\\\">​</span>​ 202</strong><strong><span lang=\\\"ru\\\">5 </span></strong><strong>, Рим </strong>&ndash; <span lang=\\\"ru\\\">Международный <span class=\\\"MsoHyperlink\\\" style=\\\"color: #3598db;\\\"><a style=\\\"color: #3598db;\\\" href=\\\"https://www.ifad.org/en/\\\">фонд сельскохозяйственного развития (МФСР) </a></span>и <span class=\\\"MsoHyperlink\\\"><a href=\\\"../../../../../en/person/\\\">Банк Арванд </a></span>подписали соглашение о предоставлении гранта на инвестирование около 445 000 евро в новую инициативу, направленную на расширение возможностей жителей сельских районов Таджикистана по преобразованию денежных переводов</span>, получаемых от членов семей, работающих<span lang=\\\"ru\\\"> за границей в устойчивые экономические возможности.</span></p>\\r\\n<p class=\\\"MsoNormal\\\">Программа <span class=\\\"MsoHyperlink\\\"><span lang=\\\"ru\\\"><a href=\\\"https://ffremittances.org/programme/prime-central-asia/\\\"><span style=\\\"color: #3598db;\\\">REMIT PRIME <span lang=\\\"RU\\\">в</span> Центральной Азии</span></a></span></span><span lang=\\\"ru\\\"> объединяет МФСР, Европейский </span>С<span lang=\\\"ru\\\">оюз и других кредиторов для расширения доступа к денежным переводам и повышения благосостояния сообществ, которые от них зависят. Он</span>а<span lang=\\\"ru\\\"> является частью глобальной программы МФСР <span class=\\\"MsoHyperlink\\\" style=\\\"color: #3598db;\\\"><a style=\\\"color: #3598db;\\\" href=\\\"https://ffremittances.org/\\\">по финансированию денежных переводов </a></span>и основывается на участии МФСР в Таджикистане в целях содействия инклюзивному развитию сельских районов и укрепления роли денежных переводов как фактора, создающего экономические возможности, расширяющего права и возможности женщин и повышающего устойчивость к изменению климата.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&laquo;Мы, как Европейский Союз, рады поддержать этот проект, превращающий денежные переводы в мощный инструмент роста и стабильности в сельских районах Таджикистана. Предлагая более качественные финансовые услуги, поддерживая местный бизнес и обучая финансовым навыкам, мы надеемся помочь более чем 14 000 человек, особенно женщинам, построить светлое будущее. Вместе с нашими партнерами</span>,<span lang=\\\"ru\\\"> Европейский Союз стремится содействовать устойчивому развитию и процветанию сельских общин&raquo;, &mdash; </span>сказал <span lang=\\\"ru\\\">Радослав Дарский, </span>П<span lang=\\\"ru\\\">осол Европейского Союза в Таджикистане.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">В сельских районах Таджикистана каждый второй житель, особенно пожилые люди и женщины, зависит от денежных переводов из-за рубежа для удовлетворения основных бытовых потребностей. Эти потоки обеспечивают средства к существованию, финансируют образование и поддерживают малый бизнес.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&laquo;Денежные переводы &mdash; это жизненно важный источник дохода для сельских районов Таджикистана. Благодаря проекту Tajik REMIT PRIME, </span>Банк &laquo;Арванд&raquo;<span lang=\\\"ru\\\"> превращает этот источник в долгосрочное экономическое развитие для тысяч семей&raquo;, &mdash; сказал Педро Де Васконселос, </span>М<span lang=\\\"ru\\\">енеджер </span>П<span lang=\\\"ru\\\">рограммы </span>Ф<span lang=\\\"ru\\\">инансирования</span> Д<span lang=\\\"ru\\\">енежных </span>П<span lang=\\\"ru\\\">ереводов</span>,<span lang=\\\"ru\\\"> IFAD.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">В течение следующих двух лет программа охватит более 14 000 </span>жителей<span lang=\\\"ru\\\"> сельских</span> регионов<span lang=\\\"ru\\\">, большинство из которых &mdash; женщины, </span>содействуя их<span lang=\\\"ru\\\"> доступ</span>у<span lang=\\\"ru\\\"> к финансовым услугам, </span>формируя стабильные <span lang=\\\"ru\\\">источник</span>и<span lang=\\\"ru\\\"> дохода и укреп</span>ляя возможность<span lang=\\\"ru\\\"> инвестировать </span>средства <span lang=\\\"ru\\\">в климатически устойчивые способы обеспечения жизнедеятельности</span>,<span lang=\\\"ru\\\"> путем:</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Расширени</span>я <span lang=\\\"ru\\\">доступа к финансовым услугам &mdash; Укрепление каналов предоставления услуг в сельской местности и агентских сетей</span>,<span lang=\\\"ru\\\"> для оказания индивидуальных финансовых услуг получателям денежных переводов и возвращающимся гражданам.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Поддержк</span>и <span lang=\\\"ru\\\">деятельности, приносящей доход, &mdash; предоставление софинансируемых грантов и займов на приобретение сельскохозяйственного оборудования и технологий, устойчивых к изменению климата.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Повышени</span>я <span lang=\\\"ru\\\">финансовой грамотности &mdash; обучение 8000 жителей сельской местности, более 50 процентов из которых &mdash; женщины, основам финансовой и деловой грамотности</span>,<span lang=\\\"ru\\\"> посредством онлайн- и очных занятий.</span></p>\\r\\n<p><span style=\\\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\\\"><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">&laquo;Мы гордимся началом сотрудничества с МФСР и Европейским </span><span style=\\\"line-height: 115%;\\\">С</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">оюзом с целью </span><span style=\\\"line-height: 115%;\\\">трансформации</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\"> денежных переводов в источник развития, создания рабочих мест и деловых возможностей. Вместе мы стремимся помочь сельским общинам укрепить свою финансовую устойчивость и инвестировать в лучшее будущее&raquo;, &mdash; </span><span style=\\\"line-height: 115%;\\\">сказала</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\"> Шоира Содикова, </span><span style=\\\"line-height: 115%;\\\">П</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">редседатель </span><span style=\\\"line-height: 115%;\\\">п</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">равления Банка </span><span style=\\\"line-height: 115%;\\\">&laquo;</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">Арванд</span><span style=\\\"line-height: 115%;\\\">&raquo;</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">.</span></span></p>\",\"description_ru\":\"<p class=\\\"MsoNormal\\\"><strong><span lang=\\\"ru\\\">9 </span></strong><strong>декабря<span lang=\\\"EN-US\\\">​</span>​ 202</strong><strong><span lang=\\\"ru\\\">5 </span></strong><strong>, Рим </strong>&ndash; <span lang=\\\"ru\\\">Международный <span class=\\\"MsoHyperlink\\\" style=\\\"color: #3598db;\\\"><a style=\\\"color: #3598db;\\\" href=\\\"https://www.ifad.org/en/\\\">фонд сельскохозяйственного развития (МФСР) </a></span>и <span class=\\\"MsoHyperlink\\\"><a href=\\\"../../../../../en/person/\\\">Банк Арванд </a></span>подписали соглашение о предоставлении гранта на инвестирование около 445 000 евро в новую инициативу, направленную на расширение возможностей жителей сельских районов Таджикистана по преобразованию денежных переводов</span>, получаемых от членов семей, работающих<span lang=\\\"ru\\\"> за границей в устойчивые экономические возможности.</span></p>\\r\\n<p class=\\\"MsoNormal\\\">Программа <span class=\\\"MsoHyperlink\\\"><span lang=\\\"ru\\\"><a href=\\\"https://ffremittances.org/programme/prime-central-asia/\\\"><span style=\\\"color: #3598db;\\\">REMIT PRIME <span lang=\\\"RU\\\">в</span> Центральной Азии</span></a></span></span><span lang=\\\"ru\\\"> объединяет МФСР, Европейский </span>С<span lang=\\\"ru\\\">оюз и других кредиторов для расширения доступа к денежным переводам и повышения благосостояния сообществ, которые от них зависят. Он</span>а<span lang=\\\"ru\\\"> является частью глобальной программы МФСР <span class=\\\"MsoHyperlink\\\" style=\\\"color: #3598db;\\\"><a style=\\\"color: #3598db;\\\" href=\\\"https://ffremittances.org/\\\">по финансированию денежных переводов </a></span>и основывается на участии МФСР в Таджикистане в целях содействия инклюзивному развитию сельских районов и укрепления роли денежных переводов как фактора, создающего экономические возможности, расширяющего права и возможности женщин и повышающего устойчивость к изменению климата.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&laquo;Мы, как Европейский Союз, рады поддержать этот проект, превращающий денежные переводы в мощный инструмент роста и стабильности в сельских районах Таджикистана. Предлагая более качественные финансовые услуги, поддерживая местный бизнес и обучая финансовым навыкам, мы надеемся помочь более чем 14 000 человек, особенно женщинам, построить светлое будущее. Вместе с нашими партнерами</span>,<span lang=\\\"ru\\\"> Европейский Союз стремится содействовать устойчивому развитию и процветанию сельских общин&raquo;, &mdash; </span>сказал <span lang=\\\"ru\\\">Радослав Дарский, </span>П<span lang=\\\"ru\\\">осол Европейского Союза в Таджикистане.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">В сельских районах Таджикистана каждый второй житель, особенно пожилые люди и женщины, зависит от денежных переводов из-за рубежа для удовлетворения основных бытовых потребностей. Эти потоки обеспечивают средства к существованию, финансируют образование и поддерживают малый бизнес.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&laquo;Денежные переводы &mdash; это жизненно важный источник дохода для сельских районов Таджикистана. Благодаря проекту Tajik REMIT PRIME, </span>Банк &laquo;Арванд&raquo;<span lang=\\\"ru\\\"> превращает этот источник в долгосрочное экономическое развитие для тысяч семей&raquo;, &mdash; сказал Педро Де Васконселос, </span>М<span lang=\\\"ru\\\">енеджер </span>П<span lang=\\\"ru\\\">рограммы </span>Ф<span lang=\\\"ru\\\">инансирования</span> Д<span lang=\\\"ru\\\">енежных </span>П<span lang=\\\"ru\\\">ереводов</span>,<span lang=\\\"ru\\\"> IFAD.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">В течение следующих двух лет программа охватит более 14 000 </span>жителей<span lang=\\\"ru\\\"> сельских</span> регионов<span lang=\\\"ru\\\">, большинство из которых &mdash; женщины, </span>содействуя их<span lang=\\\"ru\\\"> доступ</span>у<span lang=\\\"ru\\\"> к финансовым услугам, </span>формируя стабильные <span lang=\\\"ru\\\">источник</span>и<span lang=\\\"ru\\\"> дохода и укреп</span>ляя возможность<span lang=\\\"ru\\\"> инвестировать </span>средства <span lang=\\\"ru\\\">в климатически устойчивые способы обеспечения жизнедеятельности</span>,<span lang=\\\"ru\\\"> путем:</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Расширени</span>я <span lang=\\\"ru\\\">доступа к финансовым услугам &mdash; Укрепление каналов предоставления услуг в сельской местности и агентских сетей</span>,<span lang=\\\"ru\\\"> для оказания индивидуальных финансовых услуг получателям денежных переводов и возвращающимся гражданам.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Поддержк</span>и <span lang=\\\"ru\\\">деятельности, приносящей доход, &mdash; предоставление софинансируемых грантов и займов на приобретение сельскохозяйственного оборудования и технологий, устойчивых к изменению климата.</span></p>\\r\\n<p class=\\\"MsoNormal\\\"><span lang=\\\"ru\\\">&bull; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Повышени</span>я <span lang=\\\"ru\\\">финансовой грамотности &mdash; обучение 8000 жителей сельской местности, более 50 процентов из которых &mdash; женщины, основам финансовой и деловой грамотности</span>,<span lang=\\\"ru\\\"> посредством онлайн- и очных занятий.</span></p>\\r\\n<p><span style=\\\"font-size: 12pt; font-family: arial, helvetica, sans-serif;\\\"><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">&laquo;Мы гордимся началом сотрудничества с МФСР и Европейским </span><span style=\\\"line-height: 115%;\\\">С</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">оюзом с целью </span><span style=\\\"line-height: 115%;\\\">трансформации</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\"> денежных переводов в источник развития, создания рабочих мест и деловых возможностей. Вместе мы стремимся помочь сельским общинам укрепить свою финансовую устойчивость и инвестировать в лучшее будущее&raquo;, &mdash; </span><span style=\\\"line-height: 115%;\\\">сказала</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\"> Шоира Содикова, </span><span style=\\\"line-height: 115%;\\\">П</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">редседатель </span><span style=\\\"line-height: 115%;\\\">п</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">равления Банка </span><span style=\\\"line-height: 115%;\\\">&laquo;</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">Арванд</span><span style=\\\"line-height: 115%;\\\">&raquo;</span><span lang=\\\"ru\\\" style=\\\"line-height: 115%;\\\">.</span></span></p>\",\"description_tg\":null,\"description_en\":null,\"created_at\":\"18.12.2025\",\"updated_at\":\"23.02.2026\",\"lft\":1,\"rght\":2,\"tree_id\":69,\"level\":0,\"parent\":null}]},{\"slug\":\"prodazha-imushestva\",\"name\":\"Фуруши амвол\",\"news\":[{\"id\":94,\"pr_img\":\"/media/filer_public_thumbnails/filer_public/9e/3f/9e3fae5c-5969-42aa-a97b-aae52bbdf638/resized_730x410.png__400x400_q95_ALIAS-pr_card_img_crop_subsampling-2_upscale.jpg\",\"documents\":[],\"news_types\":[{\"slug\":\"prodazha-imushestva\",\"name\":\"Фуруши амвол\"}],\"url\":\"/tg/pr/news/94/\",\"date\":\"24.02.2026\",\"backdating_at\":\"17.02.2026\",\"title\":\"Фурӯши амвол\",\"title_ru\":\"Продажа имущества\",\"title_tg\":\"Фурӯши амвол\",\"title_en\":null,\"description\":\"<table class=\\\"table table-striped\\\" style=\\\"border-collapse: collapse; width: 1189px; height: 102px; border-style: ridge; float: right;\\\" border=\\\"0\\\" cellspacing=\\\"1\\\" cellpadding=\\\"15\\\" align=\\\"center\\\">\\r\\n<thead>\\r\\n<tr style=\\\"height: 25.2px;\\\">\\r\\n<th style=\\\"text-align: center; width: 104.775px; height: 25.2px;\\\" scope=\\\"col\\\"><span style=\\\"font-size: 12pt;\\\">Минтақа</span></th>\\r\\n<th style=\\\"text-align: center; width: 563.125px; height: 25.2px;\\\" scope=\\\"col\\\"><span style=\\\"font-size: 12pt;\\\">Суроға</span></th>\\r\\n<th style=\\\"text-align: center; width: 200.913px; height: 25.2px;\\\" scope=\\\"col\\\"><span style=\\\"font-size: 12pt;\\\">Нарх (сомонӣ)</span></th>\\r\\n<th style=\\\"text-align: center; width: 196.188px; height: 25.2px;\\\" scope=\\\"col\\\"><span s