":\"Успешно\",\"name\":\"успешно моб.png\",\"width\":80,\"height\":80,\"url\":\"/uploads/uspeshno_mob_6ba524fa63.png\"},\"desktopDoneIcon\":{\"documentId\":\"tb3iyjf69lkjcebrkzsrvlfk\",\"alternativeText\":\"Успешно\",\"name\":\"успешно.png\",\"width\":121,\"height\":120,\"url\":\"/uploads/uspeshno_203c19796b.png\"},\"title\":\"Дархост қабул шуд\",\"description\":\"<p>Онро дар давоми 3 рӯзи корӣ дида мебароем. Лутфан, зангро интизор шавед.</p>\",\"buttonLabel\":\"Аз нав равон кардан\",\"fillFormButtonLabel\":\"Саволномаро пур кардан\"},\"backendErrorModal\":{\"mobileIcon\":{\"documentId\":\"wmlgmhnto611czevs3vtrz91\",\"alternativeText\":null,\"name\":\"warning моб.png\",\"width\":80,\"height\":80,\"url\":\"/uploads/warning_mob_1976739950.png\"},\"desktopIcon\":{\"documentId\":\"bzb6mz92s96ijxxa6hiq6kmi\",\"alternativeText\":null,\"name\":\"warning.png\",\"width\":121,\"height\":120,\"url\":\"/uploads/warning_31bb815fd8.png\"},\"title\":\"Аллакай дархост доред\",\"description\":\"Лутфан, баррасии дархости пешинаро интизор шавед.\",\"buttonLabel\":\"Ба саҳифаи асосӣ\"}},\"requiredDocuments\":{\"headerTitle\":\"Ҳуҷҷатҳои лозима\",\"headerDescription\":\"Эҳтимолият ҳаст, ки гарави иловагӣ ё зомин талаб карда мешавад. Аз ин рӯ ба шумо ва зомин ҳуҷҷатҳои зерин лозиманд:\",\"headerBackgroundColor\":\"#F7F8F9\",\"headerImage\":{\"documentId\":\"yrmrjysgfegtq954fuz5wat8\",\"alternativeText\":\"Документы для партнерства\",\"name\":\"Frame 1321314175.png\",\"width\":489,\"height\":224,\"url\":\"/uploads/Frame_1321314175_8e878cc400.png\"},\"documentsList\":\"<p>— Шиноснома, РМА ва бо ҷои истиқомат дар Душанбе, Хуҷанд, Ҳисор, Бохтар, Турсунзода, Ваҳдат, Истаравшан ё Панҷакент.<br>— Маълумотномаи музди меҳнат. Инчунин ба ҷои онҳо метавонед патент ё шаҳодатномаи соҳибкориро бо иқтибос ва расидҳои пардохти андоз барои 3 моҳи охир пешниҳод кунед.</p><p>Инчунин вобаста ба қарори кумитаи қарзӣ пешпардохт супоридан лозим мешавад.</p>\"},\"repayLoan\":{\"title\":\"Қарзро чӣ хел супоридан мумкин аст?\",\"cards\":[{\"id\":\"84\",\"backgroundColor\":null,\"color\":\"#333333\",\"buttonLabel\":\"\",\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>«Хизматрасониҳои Алиф» ва «Пардохти насия»-ро пахш карда, пулро супоред.</p>\",\"header\":\"Бо барномаи Alif\",\"isActive\":true,\"link\":\"https://app.adjust.com/1iuriy79?adgroup=new-website\",\"desktopImage\":{\"documentId\":\"mi0my69suezokub4lsopnuo4\",\"alternativeText\":\"Пополнение счета через приложение Alif Таджикистан\",\"name\":\"Алиф моби.png\",\"width\":360,\"height\":200,\"url\":\"/uploads/Alif_mobi_3e29528605.png\"},\"mobileImage\":{\"documentId\":\"cw4vcha1m5pkvcpq5od7gx9e\",\"alternativeText\":\"Пополнение счета через приложение Alif Таджикистан\",\"name\":\"алиф моби моб.png\",\"width\":316,\"height\":200,\"url\":\"/uploads/alif_mobi_mob_eef266f219.png\"}},{\"id\":\"83\",\"backgroundColor\":null,\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>«Пардохти насия»-ро дар болои экран пахш карда, ба осонӣ пули насияро супоред.</p>\",\"header\":\"Дар терминалҳои кишвар\",\"isActive\":true,\"link\":\"https://alif.tj/bank/contacts/terminals?cityId=7\",\"desktopImage\":{\"documentId\":\"ee12hcshbnwozno4t3ckq9lz\",\"alternativeText\":\"Alif пополнение счета через терминалы по всей стране\",\"name\":\"Терминал.png\",\"width\":360,\"height\":200,\"url\":\"/uploads/Terminal_5013aa4e88.png\"},\"mobileImage\":{\"documentId\":\"zkxyhd3qlk5xhs62sq9ky6ye\",\"alternativeText\":\"Alif пополнение счета через терминалы по всей стране\",\"name\":\"терминал моби.png\",\"width\":316,\"height\":200,\"url\":\"/uploads/terminal_mobi_c55ecdb4c0.png\"}},{\"id\":\"85\",\"backgroundColor\":null,\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"Ба наздиктарин офиси мо омада, ба хазина муроҷиат намоед.\",\"header\":\"Дар хазинаҳои Алиф\",\"isActive\":true,\"link\":\"https://alif.tj/bank/contacts/offices/dushanbe?city=4\",\"desktopImage\":{\"documentId\":\"zvr9pfriobfioynp9scjm8l1\",\"alternativeText\":\"Пополнение счета Alif наличными в кассах Таджикистан\",\"name\":\"касса.png\",\"width\":360,\"height\":200,\"url\":\"/uploads/kassa_5f5e1e4ae1.png\"},\"mobileImage\":{\"documentId\":\"k04b13cs7by1lkgm4rsjgfp7\",\"alternativeText\":\"Пополнение счета Alif наличными в кассах Таджикистан\",\"name\":\"касса моб.png\",\"width\":316,\"height\":200,\"url\":\"/uploads/kassa_mob_deafd53678.png\"}}]},\"faq\":{\"title\":\"Ҷавоб ба саволҳои муҳим\",\"content\":[{\"id\":\"282\",\"title\":\"Дар куҷо барои маблағгузории мошин дархост гузорам?\",\"description\":\"<p>Дархостро барои маблағгузории мошин дар сайт, офисҳо ва марказҳои хизматрасонии бонкиамон (МХБ) дар шаҳрҳои зерин гузошта метавонед:</p><p>— Душанбе;<br>— Хуҷанд;<br>— Кӯлоб;<br>— Ваҳдат;<br>— Ҳисор;<br>— Бохтар;<br>— Панҷакент;<br>— Турсунзода;<br>— Истаравшан;<br>— Бӯстон;<br>— Бобоҷон Ғафуров.</p>\"},{\"id\":\"283\",\"title\":\"Имконияти пешпардохт кардан нест. Чӣ кор кунам?\",\"description\":\"<p>Пешпардохт талаботи ҳатмӣ мебошад. Аз арзиши умумии мошин 20% пешпардохт кардан лозим аст. Инчунин ба ҷои пешпардохт метавонед гарав гузоред, масалан:</p><p>— дигар мошин;<br>— тилло;<br>— хонаи истиқоматӣ;<br>— амонат дар Алиф.</p><p>Дар ин ҳолат ҷамъи маблағгузорӣ аз 100%-и арзиши мошин ҳисоб карда мешавад.<br>&nbsp;</p>\"},{\"id\":\"284\",\"title\":\"Шахси ҳуқуқӣ мошинро тариқи Алиф харида метавонад?\",\"description\":\"<p>Барои хариди мошин ҳам шахси воқеӣ ва ҳам ҳуқуқӣ дархост карда метавонанд. Барои шахси ҳуқуқӣ ҳуҷҷатҳои зерин лозиманд:</p><p>— Оиннома, шаҳодатномаи соҳибкорӣ, РМА, ҳуҷҷатҳои муассисӣ.<br>— Ҳисоботи молиявӣ, ки аз ҷониби мақомоти андоз қайд карда шудааст ё баённомаи андоз дар санаи охирини андоз аз фоида.<br>— Нусхаи маълумотномаи мақомоти андоз аз ҷои зист дар бораи қарздор набудан;<br>— Нақшаи тиҷорат.<br>— Пешгӯии гардиши маблағ.<br>— Ҳисоботи охирини молиявӣ (якмоҳа, семоҳа) — барои баҳо додани вазъи молиявии мизоҷ аз ҷониби мо.<br>— Варақаҳо бо намунаи имзоҳои шахсоне, ки ба имзои якум ва агар пешбинӣ шуда бошанд, дуюм ҳуқуқ доранд.<br>— Нусхаи шиноснома ва фармони директор.<br>— Нусхаи шиноснома ва фармони сармуҳосиб.<br>— Қарори шӯрои аъзоёни Ҷамъияти ширкат дар бораи гирифтани қарз, агар маблағи карз аз 20 фоизи тамоми активҳои чамъият зиёд бошад.</p>\"},{\"id\":\"288\",\"title\":\"Пас аз пардохти пурраи харид, мошинро дар БДА чӣ гуна озод карда метавонам?\",\"description\":\"<p>Пас аз пардохти пурра, бо шиноснома назди мутахассисони шуъбаи «Маблағгузории хариди мошин» оед ва дар бораи бастани маблағгузорӣ мактуби махсус гиред.</p><p>Бо ин мактуб ба БДА муроҷиат карда, мошинро озод намоед. Он тақрибан 80 сомониро ташкил медиҳад.</p><p>Ҳангоми озод кардан андози мошин ва ҷаримаҳои ҷойдоштаро дар «Шаҳри Бехатар» супоридан лозим аст.</p>\"},{\"id\":\"286\",\"title\":\"Чӣ тавр санаи пардохти харид бо долларро дида метавонам?\",\"description\":\"<p>Санаи пардохти навбатӣ ва маблағи боқимондаро дар сайти online.alif.tj тафтиш карда метавонед:</p><p>1. Тугмачаи «Меню»-ро дар online.alif.tj пахш кунед.<br>2. Бахши «Насияҳо»-ро интихоб намоед.<br>3. Шартномаи лозимаро пахш кунед.<br>4. Дар ин ҷо ҳамаи маълумотро дар бораи пардохтҳои худ санҷида метавонед.<br>&nbsp;</p>\"},{\"id\":\"287\",\"title\":\"Агар маблағгузории мошин бо доллар бошад, онро бо сомонӣ пардохт карда метавонам?\",\"description\":\"<p>Бале, маблағгузории мошинро бо сомонӣ тавассути терминалҳо, ҳамёнҳои электронӣ ва хазинаҳои Алиф бо қурби ҷории он рӯз пардохт карда метавонед.</p><p>Дар мавриди маблағро пардохт накардан, ҷарима гирифта мешавад:</p><p>— дар 7 рӯзи аввали дермонӣ 0,5%, на камтар аз 10 сомонӣ аз маблағи пардохти ҳармоҳа;<br>— баъди 7-ум рӯз 0,5% аз маблағи умумии қарз.</p>\"}]},\"locales\":[\"tg\",\"ru\",\"en\"],\"locale\":\"tg\"},\"__N_SSG\":true}"
          },
