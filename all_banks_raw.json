\\"length\\\":17,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"},{\\\"offset\\\":0,\\\"length\\\":17,\\\"style\\\":\\\"BOLD\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"at8mf\\\",\\\"text\\\":\\\"\\\\nThe Development Bank of Tajikistan with utmost respect and sincerity congratulates you all on November 6 \\u2014 the Constitution Day of the Republic of Tajikistan!\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":1,\\\"length\\\":158,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":1,\\\"length\\\":158,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":1,\\\"length\\\":158,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":1,\\\"length\\\":158,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"b35cr\\\",\\\"text\\\":\\\"The Constitution of the Republic of Tajikistan serves as the supreme legal act, the solid foundation of national statehood, the guarantor of independence and freedom, peace, stability, national unity, and the protection of human rights and freedoms.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":249,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\\\":249,\\\"style\\\":\\\"bgcolor-transparent\\\"},{\\\"offset\\\":0,\\\"length\\\":249,\\\"style\\\":\\\"fontsize-11pt\\\"},{\\\"offset\\\":0,\\\"length\\\":249,\\\"style\\\":\\\"fontfamily-Arial, sans-serif\\\"}],\\\"entityRanges\\\":[],\\\"data\\\":{}},{\\\"key\\\":\\\"7mrji\\\",\\\"text\\\":\\\"The adoption of the Constitution is a milestone historical event in the history of modern Tajik statehood, providing a reliable foundation for building a sovereign, democratic, legal, secular, and unitary state.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\\":[{\\\"offset\\\":0,\\\"length\\\":211,\\\"style\\\":\\\"color-rgb(0,0,0)\\\"},{\\\"offset\\\":0,\\\"length\