            "body": "{\n  \"miniBannerTextOne\": \"МОШИНҲО БАРОИ БОЗФУРӮШӢ!\",\n  \"miniBannerTextTwo\": \"Маълумоти бештар\",\n  \"topHeaderMenuPersonal\": \"Шахсони воқеӣ\",\n  \"topHeaderMenuBusiness\": \"Тиҷорат\",\n  \"topHeaderMenuAbout\": \"Тавҳидбонк\",\n  \"topHeaderMenuOffices\": \"Нишонӣ ва банкоматҳо\",\n  \"bottomPersonalHeaderMenuOne\": \"Маблағгузорӣ\",\n  \"bottomPersonalHeaderMenuTwo\": \"Амонат ва сармоягузориҳо\",\n  \"bottomPersonalHeaderMenuThree\": \"Кортҳо\",\n  \"bottomPersonalHeaderMenuFour\": \"Интиқолҳо \",\n  \"bottomPersonalHeaderMenuFive\": \"Хариди мошин\",\n  \"bottomPersonalHeaderMenuSix\": \"Tawhidpay\",\n  \"bottomPersonalHeaderMenuSeven\": \"Саволҳо ва ҷавобҳо\",\n  \"bottomPersonalHeaderMenuEight\": \"Тавҳид-лизинг\",\n  \"bottomPersonalHeaderMenuInternetBanking\": \"Интернет-бонкинг\",\n  \"bottomBusinessHeaderMenuOne\": \"Суратҳисоб\",\n  \"bottomBusinessHeaderMenuTwo\": \"Маблағгузорӣ\",\n  \"bottomBusinessHeaderMenuThree\": \"Амонатҳо\",\n  \"bottomBusinessHeaderMenuFour\": \"Эквайринг\",\n  \"bottomBusinessHeaderMenuFive\": \"Интернет-бонкинг\",\n  \"bottomAboutHeaderMenuOne\": \"Нишониҳо\",\n  \"bottomAboutHeaderMenuTwo\": \"Ҳуҷҷатҳо\",\n  \"bottomAboutHeaderMenuThree\": \"Кор\",\n  \"bottomAboutHeaderMenuFour\": \"Хабарҳо\",\n  \"bottomAboutHeaderMenuFive\": \"Кӯмак\",\n  \"bottomAboutHeaderMenuSix\": \"Шӯрои нозирон\",\n  \"bottomAboutHeaderMenuSeven\": \"КХМИ\",\n  \"bottomAboutHeaderMenuEight\": \"Раёсат\",\n  \"bottomAboutHeaderMenuNine\": \"Интернет-бонкинг\",\n  \"bottomAboutHeaderMenuTen\": \"Эълонҳо\",\n  \"footerPersonalTextOne\": \"Барои мизоҷони инфиродӣ\",\n  \"footerPersonalTextTwo\": \"Маблағгузорӣ\",\n  \"footerPersonalTextThree\": \"Кортҳо\",\n  \"footerPersonalTextFour\": \"Амонатҳо ва сармоягузорӣ\",\n  \"footerPersonalTextFive\": \"Муробаҳа-манзил\",\n  \"footerPersonalTextSix\": \"Муробаҳа-авто\",\n  \"footerPersonalTextSeven\": \"Tawhid PAY\",\n  \"footerAboutTextOne\": \"Бонк\",\n  \"footerAboutTextTwo\": \"Маълумоти умумӣ\",\n  \"footerAboutTextThree\": \"Реквизитҳо\",\n  \"footerAboutTextFour\": \"Саҳҳомон\",\n  \"footerAboutTextFive\": \"Ҳисоботдиҳӣ\",\n  \"footerAboutTextSix\": \"Ҷойҳои кории холӣ\",\n  \"footerAboutTextSeven\": \"Хабарҳои бонк\",\n  \"footerClientsTextOne\": \"Барои муштариён\",\n  \"footerClientsTextTwo\": \"Барномаи мобилӣ\",\n  \"footerClientsTextThree\": \"Пардохт ва интиқол\",\n  \"footerClientsTextFour\": \"Интернет-бонкинг\",\n  \"footerSocialTextOne\": \"Шабакаҳои иҷтимоӣ\",\n  \"footerSocialTextTwo\": \"Tawhid PAY\",\n  \"footerSocialTextThree\": \"Дар бораи барнома\",\n  \"footerSocialTextFour\": \"Барои ҳама намуд дастгоҳҳо\",\n  \"footerSocialTextFive\": \"Интернет-бонкинг\",\n  \"footerSocialTextSix\": \"Зеркашии барномаи мобилии Tawhid PAY\",\n  \"footerBankInfoTextOne\": \"ҶСК \\\"Тавҳидбонк\\\"\",\n  \"footerBankInfoTextTwo\": \"Иҷозатнома БМТ №0000104\",\n  \"footerBankInfoTextThree\": \"Нишонӣ: 734025, ш. Душанбе, кӯчаи С. Айнӣ 4/1\",\n  \"footerBankInfoTextFour\": \"РМА: 510008235\",\n  \"footerBankInfoTextFive\": \"ТЕЛ: +992 (44) 601 70 70\",\n  \"footerBankInfoTextSix\": \"ТЕЛ: 9111\",\n  \"footerBankInfoTextSeven\": \"Рақами боварии Бонки миллии Тоҷикистон\",\n  \"footerBankInfoTextEight\": \"барои арзу шикоятҳо:\",\n  \"footerBankInfoTextNine\": \"Телефони боварии БМТ: +992 (44) 600 15 20\",\n  \"footerBankInfoTextTen\": \"Email БМТ: allomushtari@nbt.tj\",\n  \"personalMainBannerDataTitleOne\": \"Муробаҳа - авто\",\n  \"personalMainBannerDataDescriptionOne\": \"Ҳаракат ба сӯи орзуҳо\",\n  \"personalMainBannerDataTitleTwo\": \"Пасандози «Вакала»\",\n  \"personalMainBannerDataDescriptionTwo\": \"Интихоби боэътимод\",\n  \"personalMainBannerDataTitleThree\": \"Корти қарзии «Сабз»\",\n  \"personalMainBannerDataDescriptionThree\": \"Аввалин корти қарзӣ ҷавобгӯ ба принсипҳои маблағгузории исломӣ\",\n  \"personalMainBannerDataTitleFour\": \"Иҷораи исломӣ\",\n  \"personalMainBannerDataDescriptionFour\": \"Трактор ва мошини боркаш\",\n  \"personalMainBannerDataTitleFive\": \"Мошинҳои фурӯшӣ аз Тавҳидбонк!\",\n  \"personalMainBannerDataDescriptionFive\": \"Мошинҳо бо нархи муносиб\",\n  \"personalMainBannerData\": \"Бештар\",\n  \"personalMainBestProductsTitle\": \"Беҳтарин маҳсулот аз бонк\",\n  \"personalMainBestProductTitleOne\": \"Муробаҳа \\\"Манзил\\\"\",\n  \"personalMainBestProductTextOne\": \"Маблағгузорӣ барои шахсони воқеӣ бо мақсади хариди амволи ғайриманқул (бинои истиқоматӣ, квартира дар бинои истиқоматӣ) пешбинӣ шудааст.\",\n  \"personalMainBestProductTitleTwo\": \"Муробаҳа \\\"Авто\\\"\",\n  \"personalMainBestProductTextTwo\": \"Маблағгузорӣ барои шахсони воқеӣ ва соҳибкорони инфиродӣ барои харидани мошини нав ё истифодашуда.\",\n  \"personalMainBestProductTitleThree\": \"Муробаҳа \\\"Business\\\"\",\n  \"personalMainBestProductTextThree\": \"Маблағгузории соҳибкорони инфиродӣ барои рушди соҳибкорӣ.\",\n  \"personalMainBestProductTitleFour\": \"Депозит “Музораба”\",\n  \"personalMainBestProductTextFour\": \"Музороба амонатест, ки дар он муштарӣ (шарик) маблағҳои худро барои идоракунии эътимод ба Бонк интиқол медиҳад.\",\n  \"personalMainBestProductTitleFive\": \"Депозит “Вакала”\",\n  \"personalMainBestProductTextFive\": \"Сармоягузорӣ ба лоиҳаҳо тибқи принсипҳои молияи исломӣ\",\n  \"personalMainBestProductTitleSix\": \"Корти кредитии «Сабз»\",\n  \"personalMainBestProductTextSix\": \"Кортҳои кредитии исломии «Сабз» бар асоси консепсияи «Ҳасан» бо лимити 3000 сомонӣ ва 6000 сомонӣ бо ситонидани комиссияи яквақта аз ин маблағҳо.\",\n  \"personalMainCalculateTitle\": \"Онлайн ҳисоб кунед \",\n  \"personalMainCalculateTabsArrayOne\": \"Қурби асъор\",\n  \"personalMainCalculateTabsArrayTwo\": \"Ҳисобкунаки маблағгузорӣ\",\n  \"personalMainCalculateMortgageTabOne\": \"Сомониӣ\",\n  \"personalMainCalculateMortgageTabTwo\": \"Доллар ИМА\",\n  \"personalMainCalculateMortgageTextOne\": \"Ҳаҷми маблағгузорӣ\",\n  \"personalMainCalculateMortgageTextTwo\": \"Пардохти ибтидоӣ\",\n  \"personalMainCalculateMortgageTextThree\": \"муҳлати маблағгузорӣ\",\n  \"personalMainCalculateMortgageTextFour\": \"Пардохти моҳона\",\n  \"personalMainCalculateMortgageTextFive\": \"меъёри болонархӣ\",\n  \"personalMainCalculateMortgageTextSix\": \"Ҳаҷми маблағгузорӣ\",\n  \"personalMainCalculateMortgageTextSeven\": \"Дархост гузоштан\",\n  \"personalMainCalculateMortgageTextEight\": \"Ҳама нархҳо суғуртаро дар бар мегиранд. Бонк қарори ниҳоӣ оид ба параметрҳои қарзро пас аз гирифтани ҳуҷҷатҳои зарурӣ қабул мекунад\",\n  \"personalMainConverterTabsArrayOne\": \"Фурухт\",\n  \"personalMainConverterTabsArrayTwo\": \"Харид\",\n  \"personalMainConverterTextOne\": \"Асъор\",\n  \"personalMainConverterTextTwo\": \"Асъорро бо фоида мубодила намоед!\",\n  \"personalMainAppsTextOne\": \"Тавҳидбонк - бонки исломии Шумо.\",\n  \"personalMainAppsTextTwo\": \"Вақти худро сарфа кунед — амалиёти молиявиро онлайн анҷом диҳед!\",\n  \"personalMainAppsTextThree\": \"Зеркашии Tawhidpay\",\n  \"personalMainAppsTextFour\": \"Интернет-бонкинг\",\n  \"personalMainServicesTextOne\": \"Хидматҳои муфид\",\n  \"personalMainServicesTextTwo\": \"Барои ҳама ҳолатҳо\",\n  \"personalMainServicesCarouselTextOne\": \"Пардохтҳо ва интиқолҳо\",\n  \"personalMainServicesCarouselTextOneDescription\": \"Аз кортҳои  Тавҳидбонк ва дигар бонкҳо пул интиқол диҳед ва ҳаққи хизматҳоро пардохт кунед.\",\n  \"personalMainServicesCarouselTextTwo\": \"Мубодилаи асъор\",\n  \"personalMainServicesCarouselTextTwoDescription\": \"Тағйир додани асъор дар бонкдории мобилӣ ва онлайн.\",\n  \"personalMainServicesCarouselTextThree\": \"Тахфифҳо ва аксияҳо\",\n  \"personalMainServicesCarouselTextThreeDescription\": \"Аз пешниҳодҳо ва тахфифҳои мусоид барои муштариёни Тавҳидбонк оид ба фароғат, таълим ва дигар молу хизматҳо баҳра баред.\",\n  \"personalMainServicesCarouselButtonText\": \"Бештар\",\n  \"personalMainAppRateTextOne\": \"Қурби асъор\",\n  \"personalMainAppRateTextTwo\": \"Гирифта шуд\",\n  \"personalMainAppRateTextThree\": \"Бонк мехарад\",\n  \"personalMainAppRateTextFour\": \"Бонк мефурӯшад\",\n  \"personalMainAppRateTextFive\": \"Нақдӣ\",\n  \"personalMainAppRateTextSix\": \"Интиқоли маблағ\",\n  \"personalMainAppRateTextSeven\": \"Дар интернет-бонк\",\n  \"personalMainAppRateTextEight\": \"БМТ\",\n  \"personalMainAppRateTextNine\": \"Офисҳо ва банкоматҳо\",\n  \"personalMainAppRateTextTen\": \"Нишониҳои филиалҳо ва банкоматҳои Бонки  Тавҳидбонк, инчунин рӯйхати банкоматҳои шарик дар харита - соатҳои корӣ, рақамҳои телефон.\",\n  \"personalMainAppRateTextEleven\": \"Гузаштан\",\n  \"personalMainInterestingTitle\": \"Шояд ба шумо писанд бошад\",\n  \"personalMainInterestingCarouselTextOne\": \"Интиқоли бе комиссия.\",\n  \"personalMainInterestingCarouselTextOneDescription\": \"Интиқоли пул ба Тоҷикистон 0%\",\n  \"personalMainInterestingCarouselTextTwo\": \"Бонки шумо ҳамеша бо шумост\",\n  \"personalMainInterestingCarouselTextTwoDescription\": \"Тез, муносиб, ҳамеша дар даст!\",\n  \"personalMainNewsTitle\": \"Хабарҳои бонк\",\n  \"personalMainAllNews\": \"Ҳама хабарҳо\",\n  \"personalMainAppFaqTitle\": \"Ҳанӯз саволҳо доред ё мехоҳед фикру мулоҳизаҳои худро баён кунед?\",\n  \"personalMainAppFaqCardTextOne\": \"Онлайн занг\",\n  \"personalMainAppFaqCardTextOneDescription\": \"Ба шумо дастрасӣ ба микрофон лозим аст\",\n  \"personalMainAppFaqCardTextOneAction\": \"Занг задан\",\n  \"personalMainAppFaqCardTextTwo\": \"Саволҳо\",\n  \"personalMainAppFaqCardTextTwoDescription\": \"ва посухҳо\",\n  \"personalMainAppFaqCardTextTwoAction\": \"Дидан\",\n  \"personalMainAppFaqCardTextThree\": \"Сомонаро баҳо диҳед\",\n  \"personalMainAppFaqCardTextThreeDescription\": \"Донистани фикри Шумо муҳим аст\",\n  \"personalMainAppFaqCardTextThreeAction\": \"Баҳо додан\",\n  \"personalFinancingTitle\": \"Маблағгузорӣ\",\n  \"personalFinancingCardOneTextOne\": \"Муробаҳа - истеъмолӣ\",\n  \"personalFinancingCardOneTextTwo\": \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed\