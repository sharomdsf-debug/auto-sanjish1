41\\u0442\\u0430\\u0440\\u0438\\u0448\\u0438 \\u04b3\\u0430\\u043c\\u043a\\u043e\\u0440\\u0438\\u0440\\u043e \\u0434\\u0430\\u0440 \\u0431\\u0430\\u0445\\u0448\\u04b3\\u043e\\u0438 \\u0430\\u0444\\u0437\\u0430\\u043b\\u0438\\u044f\\u0442\\u043d\\u043e\\u043a\\u0438 \\u0438\\u049b\\u0442\\u0438\\u0441\\u043e\\u0434\\u0438\\u0451\\u0442, \\u0430\\u0437 \\u04b7\\u0443\\u043c\\u043b\\u0430 \\u0441\\u0430\\u043d\\u043e\\u0430\\u0442\\u0438 \\u043a\\u04ef\\u04b3\\u043a\\u043e\\u0440\\u04e3 \\u0432\\u0430 \\u043a\\u043e\\u0440\\u043a\\u0430\\u0440\\u0434\\u0438 \\u0437\\u0430\\u0445\\u0438\\u0440\\u0430\\u04b3\\u043e\\u0438 \\u043c\\u0430\\u044a\\u0434\\u0430\\u043d\\u04e3, \\u0434\\u043e\\u0440\\u0443\\u0441\\u043e\\u0437\\u04e3 \\u0432\\u0430 \\u0442\\u0430\\u043d\\u0434\\u0443\\u0440\\u0443\\u0441\\u0442\\u04e3, \\u0430\\u0432\\u0438\\u0430\\u0442\\u0441\\u0438\\u044f, \\u0445\\u0438\\u0437\\u043c\\u0430\\u0442\\u0440\\u0430\\u0441\\u043e\\u043d\\u0438\\u04b3\\u043e\\u0438 \\u0431\\u043e\\u043d\\u043a\\u04e3 \\u0432\\u0430 \\u043c\\u043e\\u043b\\u0438\\u044f\\u0432\\u04e3, \\u043a\\u0438\\u0448\\u043e\\u0432\\u0430\\u0440\\u0437\\u04e3 \\u0432\\u0430 \\u043a\\u043e\\u0440\\u043a\\u0430\\u0440\\u0434\\u0438 \\u043c\\u0430\\u04b3\\u0441\\u0443\\u043b\\u043e\\u0442, \\u0441\\u043e\\u0445\\u0442\\u043c\\u043e\\u043d \\u0432\\u0430 \\u0440\\u0443\\u0448\\u0434\\u0438 \\u0430\\u043c\\u0432\\u043e\\u043b\\u0438 \\u0493\\u0430\\u0439\\u0440\\u0438\\u043c\\u0430\\u043d\\u049b\\u0443\\u043b, \\u0441\\u0430\\u0439\\u0451\\u04b3\\u04e3, \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044f\\u04b3\\u043e\\u0438 \\u0438\\u0442\\u0442\\u0438\\u043b\\u043e\\u043e\\u0442\\u04e3 \\u0432\\u0430 \\u043c\\u043e\\u043b\\u0438\\u044f\\u0438 \\u0438\\u0441\\u043b\\u043e\\u043c\\u04e3 \\u0431\\u0430\\u0440\\u0440\\u0430\\u0441\\u04e3 \\u0445\\u043e\\u04b3\\u0430\\u043d\\u0434 \\u043a\\u0430\\u0440\\u0434.\\\",\\\"type\\\":\\\"unstyled\\\",\\\"depth\\\":0,\\\"inlineStyleRanges\\