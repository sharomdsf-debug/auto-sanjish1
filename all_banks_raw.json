_0de44a884e.svg\"}},{\"id\":\"148\",\"link\":\"https://www.tiktok.com/@alifbank.tj?_t=8kdw6q9I3ne&_r=1\",\"image\":{\"documentId\":\"jcgn3jgpje12780g4y2po4yh\",\"alternativeText\":null,\"name\":\"Tik tok.svg\",\"width\":40,\"height\":40,\"url\":\"/uploads/Tik_tok_2d07d4f570.svg\"}}],\"menu\":[{\"id\":\"472\",\"label\":\"Дар бораи мо\",\"link\":\"/tg/bank/about-us\"},{\"id\":\"473\",\"label\":\"Суроғаҳо ва реҷаи корӣ\",\"link\":\"/bank/contacts/offices/dushanbe?city=1\"},{\"id\":\"474\",\"label\":\"Ҳуҷҷатҳо ва тарофаҳо\",\"link\":\"/tg/bank/documents\"},{\"id\":\"475\",\"label\":\"Ҷойҳои кор\",\"link\":\"https://job.alif.tj/about\"},{\"id\":\"476\",\"label\":\"Ҳуқуқҳои муштарӣ\",\"link\":\"/bank/help\"}],\"mobileMobiLink\":{\"link\":\"https://alf.tj/alifapp\",\"title\":\"Alif\",\"description\":\"Ҳамёни мобилӣ\",\"image\":{\"documentId\":\"t8mhqze5ke979p7tqemms6ii\",\"alternativeText\":\"Frame 184.svg\",\"name\":\"Frame 184.svg\",\"width\":null,\"height\":null,\"url\":\"/uploads/Frame_184_e3848b14a9.svg\"}},\"copyright\":\"© 2026 ҶСК «Алиф Бонк»\",\"license\":\"Иҷозатномаи БМТ №0000114 аз 03.01.2020\",\"depositInsuranceFund\":\"ҶСК «Алиф Бонк» узви Хазинаи суғуртаи амонату пасандозҳои Тоҷикистон мебошад\",\"labelMobiLinks\":\"Ҳамёни мобилӣ\",\"labelSocialLinks\":\"Шабакаҳои иҷтимоӣ\",\"logo\":{\"documentId\":\"opypn6mwijq5zsy07fyr1tes\",\"alternativeText\":\"Alif Products Logo.svg\",\"name\":\"Alif Products Logo.svg\",\"width\":null,\"height\":null,\"url\":\"/uploads/Alif_Products_Logo_e0b63c960b.svg\"},\"lastUpdate\":{\"updateTitle\":\"Навсозӣ шуд\",\"updateDate\":\"2026-11-05T12:30:00.000Z\",\"isActive\":true}},\"ogImage\":{\"documentId\":\"rgryhdgos8cc4dtnz2mclh24\",\"alternativeText\":null,\"name\":\"alif bank og.png\",\"width\":1288,\"height\":529,\"url\":\"/uploads/alif_bank_og_e360356dbe.png\"}},\"pageTitle\":\"Дар бораи мо\",\"seo\":{\"title\":\"Alif — финтех дар Тоҷикистон | Бонк ва технологияҳо\",\"description\":\" 1,7 млн мизоҷ, 3 000 шарик, 1 млн+ насби Alif. Кортҳо, насия, интиқолҳо, маблағгузории мошин. Барои тиҷорат — интернет-бонк, лоиҳаи музди меҳнат, эквайринг.\",\"keywords\":null,\"themeColor\":null,\"canonicalLink\":\"https://alif.tj/tg/bank/about-us\",\"favicon\":{\"documentId\":\"qg40v28zmt1n4d6ezc5safyk\",\"alternativeText\":\"icon.svg\",\"name\":\"icon.svg\",\"width\":1080,\"height\":1080,\"url\":\"/uploads/icon_000e4319de.svg\"},\"ogImage\":null},\"banner\":[{\"id\":\"41\",\"image\":{\"documentId\":\"koy7kxrupus5xamn0ayo8qk3\",\"alternativeText\":\"Консультация посетителя специалистом Алиф в офисе\",\"name\":\"front.jpg\",\"width\":230,\"height\":280,\"url\":\"/uploads/front_e80da89979.jpg\"},\"mobileImage\":{\"documentId\":\"p11kxuams3hs4n23b4nhpks1\",\"alternativeText\":\"Консультация посетителя специалистом Алиф в офисе\",\"name\":\"experts mobi.png\",\"width\":286,\"height\":205,\"url\":\"/uploads/experts_mobi_d91ff02585.png\"}},{\"id\":\"42\",\"image\":{\"documentId\":\"gbbm54k5ccms7grdq9sw824d\",\"alternativeText\":\"рабочие моменты команды Алиф\",\"name\":\"logistika.png\",\"width\":583,\"height\":280,\"url\":\"/uploads/logistika_bff8333d90.png\"},\"mobileImage\":{\"documentId\":\"lwxj3cs39o84qd7mtkppv3q6\",\"alternativeText\":\"рабочие моменты команды Алиф\",\"name\":\"logisty mobi.png\",\"width\":286,\"height\":205,\"url\":\"/uploads/logisty_mobi_311ccf058c.png\"}},{\"id\":\"43\",\"image\":{\"documentId\":\"o38veorwx64thrdwcw9jypu0\",\"alternativeText\":\"IT-специалисты Алиф работают над финтех-решениями за компьютерами в офисе\",\"name\":\"it.png\",\"width\":264,\"height\":280,\"url\":\"/uploads/it_2a627875aa.png\"},\"mobileImage\":{\"documentId\":\"jjldnwihi5le0ohug7ow4bsw\",\"alternativeText\":\"IT-специалисты Алиф работают над финтех-решениями за компьютерами в офисе\",\"name\":\"it mobi.png\",\"width\":286,\"height\":205,\"url\":\"/uploads/it_mobi_c806a8884b.png\"}}],\"history\":{\"id\":\"13\",\"title\":\"Дар бораи Алиф\",\"description\":\"<p>Алиф фаъолияти худро аз соли 2014 оғоз карда, яке аз ширкатҳои молиявӣ ва технологии пешқадами Осиёи Марказӣ мебошад.</p><p>&nbsp;</p><p>Мо хизматрасониҳои молиявӣ ва технологиро тарҳрезӣ карда, ба мизоҷону шарикон пешниҳод менамоем. Барномаи мобилии Alif-ро ба роҳ мондем, ки барои хариду интиқол ва дигар амалиёт кумак менамояд. Инчунин, яке аз калонтарин онлайн-мағозаҳоеро кушодем, ки дар он мизоҷон молҳоро ба насия мегиранд ва шарикон савдои худро бештар менамоянд.</p><p>&nbsp;</p><p>Корти «Салом», интернет-бонк ва дигар хизматрасониҳо бошанд, соҳаи тиҷоратро рушд дода, ба даҳҳо ҳазор мизоҷон ёрӣ мерасонанд.</p><p>&nbsp;</p><p>Лоиҳаи дигарамон — Алиф Академияро баҳри он таъсис додем, ки шавқу рағбати ҳамватанонро ба соҳаи технологияҳои иттилоотӣ бештар намоем. То имруз бештар аз 2 000 барномасозро барои ширкатҳои ватанӣ ва хориҷа омода намудем.</p><p>&nbsp;</p><p>Боварӣ дорем, ки бо ягонагӣ ва меҳнатдӯстии ҳамкоронамон Алифро пешқадамтарин ширкати молиявӣ ва технологии исломии ҷаҳон месозем<br>&nbsp;</p>\",\"imageDescription\":\"Офиси хурд, се нафар ва умедҳои бузург — ҳамин тавр соли 2014 Алиф ба навиштани таърихи худ шуруъ кард.\",\"image\":{\"documentId\":\"b03ks54whjy0fnpetjj5w3sz\",\"alternativeText\":\"начало истории Алиф: маленький офис\",\"name\":\"table.png\",\"width\":280,\"height\":220,\"url\":\"/uploads/table_368970bd0b.png\"}},\"team\":{\"id\":\"287\",\"title\":\"Алифиён\",\"description\":\"<p>Мо боварӣ дорем, ки мақоми ҷамъиятии кормандон аҳамияте надорад. Танҳо ғайрату зиракӣ ва ростқавлию поквиҷдонӣ натиҷа медиҳанд. Аз ин рӯ, мо ба таҷриба низ нигоҳ накарда, шахсонеро ба кор мегирем, ки алови чашм ва хислатҳои инсонӣ доранд.</p><p>&nbsp;</p><p>Ҳарсола шумораи ҳамкоронамон чандҳо маротиба зиёд мешавад. Айни ҳол дар Алиф зиёда аз 1 100 нафар кор карда, ҳамарӯза кӯшиш менамоянд, ки зиндагии мизоҷони азизамонро каме ҳам бошад, осонтар намоянд.</p><p><br>&nbsp;</p>\",\"image\":{\"documentId\":\"an2zhjb69pu2d22b28f7xrqk\",\"alternativeText\":\"команда Алиф\",\"name\":\"Frame 181 (1).png\",\"width\":286,\"height\":288,\"url\":\"/uploads/Frame_181_1_58ea8fa700.png\"}},\"values\":{\"id\":\"14\",\"title\":\"7 арзише, ки мо пайравӣ мекунем\",\"values\":[{\"id\":\"93\",\"title\":\"Ман чун Алифам\",\"description\":\"<p>Дар амалҳоям бовиҷдон, ростқавл ва самимӣ ҳастам</p>\",\"desktopImage\":{\"documentId\":\"ufansts6mhnp69qu53l8vceo\",\"alternativeText\":null,\"name\":\"image size.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_1a99ad89e8.png\"},\"mobileImage\":{\"documentId\":\"utm2dq09vxzft9esbmlxvizl\",\"alternativeText\":null,\"name\":\"я как алиф.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/ya_kak_alif_cd535fde44.png\"}},{\"id\":\"94\",\"title\":\"Алиф аз ман аст \",\"description\":\"<p>Онро мисли хонаи худ дӯст медорам ва барои боз беҳтар карданаш аз таҳти дил кор мекунам</p>\",\"desktopImage\":{\"documentId\":\"wdsmjk1ve02k2qm9ff6sthzf\",\"alternativeText\":\"image size-5.png\",\"name\":\"image size-5.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_5_d8ba1e08c3.png\"},\"mobileImage\":{\"documentId\":\"i5fviakest8ydmw86nrhdet8\",\"alternativeText\":null,\"name\":\"лучше, чем вчера.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/luchshe_chem_vchera_4e987f12fd.png\"}},{\"id\":\"95\",\"title\":\"Бетараф нестам \",\"description\":\"<p>Ҳамеша омодаам, ки ҳамкорону Алифро кумак ва дастгирӣ намоям</p>\",\"desktopImage\":{\"documentId\":\"oc0ong2nudmguqb3tbquasli\",\"alternativeText\":\"image size-3.png\",\"name\":\"image size-3.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_3_82d670672e.png\"},\"mobileImage\":{\"documentId\":\"zggnfc0hmkl9quh6cjelo69m\",\"alternativeText\":null,\"name\":\"я не безразличен.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/ya_ne_bezrazlichen_99912419ce.png\"}},{\"id\":\"96\",\"title\":\"Ғайриоддиям\",\"description\":\"<p>Қолабҳоро шикаста, аз интизориҳо зиёдтар корро иҷро мекунам</p>\",\"desktopImage\":{\"documentId\":\"vokzk5ndedc81ihkhw99bhw1\",\"alternativeText\":\"image size-2.png\",\"name\":\"image size-2.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_2_7bee96e7d5.png\"},\"mobileImage\":{\"documentId\":\"fpw0hx2icxi7fe1289q9qkym\",\"alternativeText\":null,\"name\":\"я необычный.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/ya_neobychnyj_a6bf5fc5f5.png\"}},{\"id\":\"97\",\"title\":\"Пешравӣ бе хато нест\",\"description\":\"<p>Хатоҳоямро қабул карда, аз онҳо дарс мегираму беҳтар мешавам</p>\",\"desktopImage\":{\"documentId\":\"rhj6v848r6pc03bclsq9vzau\",\"alternativeText\":\"image size-6.png\",\"name\":\"image size-6.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_6_474d098a76.png\"},\"mobileImage\":{\"documentId\":\"b6glsh0189loqnjl3panzbj1\",\"alternativeText\":null,\"name\":\"ошибки.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/oshibki_2782f37587.png\"}},{\"id\":\"98\",\"title\":\"Имрӯз аз дирӯз беҳтарам\",\"description\":\"<p>Доим малакаҳои нав омӯхта, худро беҳтар мекунам</p>\",\"desktopImage\":{\"documentId\":\"ck8x15dqhlmn0q59f5dwt6pt\",\"alternativeText\":\"image size-4.png\",\"name\":\"image size-4.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_4_a88cf89b1e.png\"},\"mobileImage\":{\"documentId\":\"k6h5mhkn561vo9vviiryuxug\",\"alternativeText\":null,\"name\":\"владею над своими желан.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/vladeyu_nad_svoimi_zhelan_0f41845c16.png\"}},{\"id\":\"99\",\"title\":\"Ман ҳокими нафсам\",\"description\":\"<p>Танбалӣ намекунам ва хоҳишҳоямро идора менамоям</p>\",\"desktopImage\":{\"documentId\":\"lmbng0j354wu0zvjfvsu892b\",\"alternativeText\":\"image size-1.png\",\"name\":\"image size-1.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/image_size_1_ca74622fe9.png\"},\"mobileImage\":{\"documentId\":\"vmr5zg57h9eopu6n8jqpneqz\",\"alternativeText\":null,\"name\":\"Алиф мой.png\",\"width\":128,\"height\":157,\"url\":\"/uploads/Alif_moj_57c3287c6f.png\"}}]},\"ourNumbersHeader\":\"Натиҷаи боварии мизоҷон\",\"ourNumbers\":[{\"id\":\"114\",\"title\":\"2,2 млн+\",\"description\":\"мизоҷ дар Тоҷикистон \"},{\"id\":\"115\",\"title\":\"2 000\",\"description\":\"шарик бо эквайринги тиҷоратӣ\"},{\"id\":\"116\",\"title\":\"1 000 +\",\"description\":\"корманд дар Тоҷикистон\"},{\"id\":\"117\",\"title\":\"1 млн+\",\"description\":\"насби барномаи Alif\"},{\"id\":\"118\",\"title\":\"4 000 +\",\"description\":\"шарике, ки бо корти «Салом» пардохтро қабул мекунанд\"},{\"id\":\"119\",\"title\":\"1 000 +\",\"description\":\"мизоҷи корпоративӣ дар Alif Business\"}],\"achievements\":{\"id\":\"14\",\"Label\":\"Дастовардҳои мо\",\"moreButtonLabel\":\"Ҳамаи дастовардҳо\",\"achievements\":[{\"id\":\"526\",\"title\":\"2026\",\"content\":[{\"id\":\"2425\",\"title\":\"Апрел\",\"description\":\"<p>Дорои сертификати байналмилалии амниятии PCI DSS гаштем ва сатҳи баланди ҳифзи маълумоти пардохтиро тасдиқ намудем</p>\"},{\"id\":\"2426\",\"title\":\"Июл\",\"description\":\"<p>28 июл Apple Pay барои мизоҷони Алиф дастрас шуд. Акнун онҳо метавонанд бо таҷҳизоти худ дар ҳама ҷое, ки пардохти бетамос қабул мешавад, харид кунанд — ҳам дар Тоҷикистон ва ҳам дар хориҷи кишвар.</p>\"},{\"id\":\"2427\",\"title\":\"Август\",\"description\":\"<p>Дар номинатсияи «Бонкҳо»-и озмуни «Топ-35 шарики боэътимоди сол — 2026» Палатаи савдо ва саноати Ҷумҳурии Тоҷикистон ба мо дипломи ғолиб тақдим кард.</p>\"},{\"id\":\"2428\",\"title\":\"Октябр\",\"description\":\"<p>1. Дар номинатсияи «Рақамикунонӣ»-и озмуни «Соҳибкори сол — 2026» ҷойи аввалро ишғол намудем.</p><p>&nbsp;</p><p>2. Барои саҳм дар рушди пардохтҳои рақамӣ ва бонкдории мобилӣ дар Тоҷикистон соҳиби ҷоиза шудем.</p><p>&nbsp;</p><p>3. Дар доираи AICONF-2026, дар категорияи «Шарики сол» соҳиби ҷоизаи AICA Awards 2026 гардидем.</p>\"}]},{\"id\":\"527\",\"title\":\"2025\",\"content\":[{\"id\":\"2429\",\"title\":\"Май\",\"description\":\"<p>Ҷойи 1-ум дар номинаи насб ва истифодаи воситаҳои электронии пардохт дар озмуни «Ташкилоти қарзии молиявии беҳтарин оид ба хизматрасонии бонувони соҳибкор» гирифтем</p>\"},{\"id\":\"2430\",\"title\":\"Июл\",\"description\":\"<p>Пардохтҳо ва интиқолҳои тиҷоратиро бе комиссия тавассути Visa Direct Account оғоз кардем. Истифодабарандагони Alif Business метавонанд интиқолҳои B2B, B2C ва B2G-ро рост ба Амороти Муттаҳидаи Араб, Туркия, Канада ва дигар кишварҳо фиристанд.</p>\"},{\"id\":\"2431\",\"title\":\"Август\",\"description\":\"<p>Дар барномаи Alif интиқолҳо ба Чин ба Alipay ва WeChat дастрас шуданд — бе комиссия ва бе мубодилаи дубора.</p>\"},{\"id\":\"2432\",\"title\":\"Сентябр\",\"description\":\"<p>1. Дар барномаи Alif хизматрасонии нав пайдо шуд — «Мубодилаи асъор», ки дар он доллар, евро ва рублро бе ташриф ба бонк мубодила кардан мумкин аст.</p><p>&nbsp;</p><p>2. Дар барномаи Alif интиқолҳо ба ҳисобҳои бонкии Иёлоти Муттаҳидаи Амрико бе комиссия роҳандозӣ шуданд.</p>\"},{\"id\":\"2433\",\"title\":\"Ноябр\",\"description\":\"<p>Соҳиби се ҷоиза аз Mastercard гардидем: «Барои рушди устувор», «Иқдоми эҷодии маркетингӣ 2025» ва «Иқдоми муваффақи Mastercard Send 2025».</p>\"},{\"id\":\"2434\",\"title\":\"Декабр\",\"description\":\"<p>1. Мо дар маросими миллии «Бренди сол-2025» дар номинатсияҳои «Ташкилоти молиявӣ», «Технологияҳои муосир» ва «Фарҳанг ва маориф» соҳиби чор ҷоизаи тиллоӣ шудем.&nbsp;</p><p>&nbsp;</p><p>2. Соҳиби 8 ҷоизаи Visa шудем: «Беҳтарин ташаббускори интиқолҳо тавассути Visa Direct», «Беҳтарин эмитенти кортҳои Visa Business», «Беҳтарин эмитенти кортҳо дар бозори дохилӣ», «Маркетинги пешқадам дар рушди истифодаи GPay», «Оғоз ва таблиғоти VDA/W», «Воридкунии Visa Risk Manager», «Воридкунии ALM», «Воридкунии Visa CyberSource».</p>\"}]},{\"id\":\"528\",\"title\":\"2024\",\"content\":[{\"id\":\"2435\",\"title\":\"Январ\",\"description\":\"<p>Аз ширкати байналмилалии Snapsec шаҳодатномае гирифтем, ки сатҳи баланди бехатарии Alif Mobi-ро тасдиқ мекунад</p>\"},{\"id\":\"2436\",\"title\":\"Феврал\",\"description\":\"<p>Се ҷоизаи нав аз системаи пардохтии Visa гирифтем: Fintech Vanguard, Best Visa Business Issuer ва Visa Direct Rising Star</p>\"},{\"id\":\"2437\",\"title\":\"Март\",\"description\":\"<p>Якҷоя бо Visa ва Garmin технологияи Garmin Pay-ро барои кортҳои Visa дар Тоҷикистон ҷорӣ кардем. Ин сатҳи нави бехатарӣ ва бароҳатии пардохтҳои бетамосро таъмин намуд.</p>\"},{\"id\":\"2438\",\"title\":\"Апрел\",\"description\":\"<p>Бо Mastercard шартномаи дарозмуҳлат оид ба барориши кортҳо бастем, то ки мизоҷон амалиётҳои молиявиро дар хориҷа боз ҳам осонтар анҷом диҳанд</p>\"},{\"id\":\"2439\",\"title\":\"Май\",\"description\":\"<p>1. The Digital Banker ба мо ҷоизаи Islamic Debit Card of the Year барои кортҳои Visa-амон тақдим кард. Акнун ин ҷоиза дар қатори дигар бонкҳои бузурги исломӣ дар сайти The Digital Banker ҷойгир аст.</p><p>&nbsp;</p><p>2. Барои насб ва истифодаи воситаҳои электронии пардохт дар озмуни «Ташкилоти қарзии молиявии беҳтарин оид ба хизматрасонии соҳибкории бонувон» ҷои дуюмро ишғол намудем.</p>\"},{\"id\":\"2440\",\"title\":\"Июн\",\"description\":\"<p>Бо ҳамроҳии Visa системаи пардохтии Google Pay-ро ворид намудем, то ки пардохтҳои бетамос боз ҳам осонтар шаванд.</p>\"},{\"id\":\"2441\",\"title\":\"Август\",\"description\":\"<p>Ширкати байналмилалии Snapsec ба мо шаҳодатнома тақдим кард. Платформаи Alif Business аз санҷиши осебпазирӣ бомуваффақият гузашта, мувофиқатро ба ҳамаи талаботи амниятӣ тасдиқ намуд.</p>\"},{\"id\":\"2442\",\"title\":\"Ноябр\",\"description\":\"<p>Барои оғози муваффақи барориш ва қабули кортҳои Mastercard ҷоиза гирифтем.</p>\"},{\"id\":\"2443\",\"title\":\"Декабр\",\"description\":\"<p>1. Visa ба мо 8 ҷоиза тақдим кард, аз ҷумла: «Беҳтарин эмитенти ватанӣ», «Иштирокчии пешсафи Visa Direct», «Аввалин ҷорикунандаи Google Pay дар Тоҷикистон», «Беҳтарин ташкилкунандаи ҳалли пардохтҳои B2B», «Эмитенти пешқадами оммавӣ», «Маркетинги муваффақ бо Garmin ва GPay», «Аввалин ҳамгироии обуна дар барнома», «Оғози муваффақи Visa+».</p><p>&nbsp;</p><p>2. Соҳиби се ҷоиза шудем: &nbsp;«Беҳтарин лоиҳаи технологияи молиявӣ (Fintech)», «Беҳтарин майдони электронӣ (маркетплейс)», «Беҳтарин ширкат-таҳиякунандаи IT».</p><p>&nbsp;</p><p>3. Барои ҷорӣ кардани Google Pay бо Mastercard дар Тоҷикистон соҳиби ҷоиза шудем.</p><p>&nbsp;</p><p>4. Мақоми Google Partner бори дигар тасдиқ карда, касбият ва донишҳои худро дар соҳаи таблиғоту таҳлилот нишон додем.</p>\"}]},{\"id\":\"529\",\"title\":\"2023\",\"content\":[{\"id\":\"2444\",\"title\":\"Март\",\"description\":\"<p>Alif Shop ягона маркетплейс аз ИДМ гардид, ки аз байни 30 000 иштирокчиёни дигар ба рӯйхати 100 лоиҳаҳои муваффақи дунё таҳти EWC 2022 дохил шуд</p>\"},{\"id\":\"2445\",\"title\":\"Апрел\",\"description\":\"<p>Дар озмуни ҷумҳуриявии «Бренди сол — 2022» соҳиби якчанд ҷоиза гаштем:<br>— тилло дар категорияи «Ташкилоти молиявӣ»;<br>— нуқра ба интернет-мағозаи alifshop.tj барои пешбурди технологияҳои муосир;<br>— ва ҷоизаи биринҷӣ ба «Алиф Академия» барои саҳм дар фарҳанг ва маориф.</p>\"},{\"id\":\"2446\",\"title\":\"Май\",\"description\":\"<p>Барои кушодан ва пешбурди суратҳисоби бонкӣ дар озмуни «Ташкилоти қарзии молиявии беҳтарин оид ба хизматрасонии соҳибкории бонувон 2022» ҷои якумро ишғол намудем.</p>\"},{\"id\":\"2447\",\"title\":\"Сентябр\",\"description\":\"<p>Аз агентии байналмилалии MicroFinanza Rating шаҳодатномаро бо рейтинги α- «Миёна» гирифтем, ки устувории молиявиамонро тасдиқ мекунад</p>\"},{\"id\":\"2448\",\"title\":\"Ноябр\",\"description\":\"<p>Барои фаъолияти брокериву дилерӣ дар бозори коғазҳои қиматнок, инчунин барои идоракунии эътимоднокии онҳо дорои 3 иҷозатнома шудем</p>\"}]},{\"id\":\"530\",\"title\":\"2022\",\"content\":[{\"id\":\"2449\",\"title\":\"Январ\",\"description\":\"<p>Эътироф ва мукофоти «Ба роҳмонии Visa Infinite ва Platinum дар Ҷумҳурии Тоҷикистон»-ро аз ҷониби низоми пардохти байналмилалии Visa гирифтем</p>\"},{\"id\":\"2450\",\"title\":\"Феврал\",\"description\":\"<p>Ҳаҷми пардохтҳои электрониро бо кортҳои Visa дар Тоҷикистон зиёд кардем ва мукофот гирифтем</p>\"},{\"id\":\"2451\",\"title\":\"Март\",\"description\":\"<p>Дар ҷоизаи ҳарсолаи «Глобальная сеть предпринимательства», ки дар Арабистони Саудӣ баргузор гардид, дар номинатсияи GENStarters Award 2022 мукофот гирифтем</p>\"},{\"id\":\"2452\",\"title\":\"Май\",\"description\":\"<p>Барномаи Alif Mobi-ро зиёда аз 1 миллион нафар насб карданд</p>\"},{\"id\":\"2453\",\"title\":\"Август\",\"description\":\"<p>1. Корти виртуалии Visa Digital-ро барои истифодабарӣ ба роҳ мондем, ки бо он метавонед онлайн-харидҳо кунед, маблағро қабул ё интиқол диҳед&nbsp;</p><p>&nbsp;</p><p>2. Терминалҳои cashout-ро ба кор даровардем. Акнун метавонед тариқи онҳо аз тавозуни ҳамён ё суратҳисоби корт пули нақд гиред&nbsp;</p><p>&nbsp;</p><p>3. Alif Mobi-ро зиёда аз 100 000 нафар истифода мебаранд</p>\"}]},{\"id\":\"531\",\"title\":\"2021\",\"content\":[{\"id\":\"2454\",\"title\":\"Май\",\"description\":\"<p>Аз сохтори молиявию технологии IFC ва ширкати Private Equity баҳри беҳтар кардани дастрасӣ ба хизматрасонии рақамии молиявӣ барои аҳолӣ ба миқдори $10 млн сармоягузорӣ ҷалб намудем</p>\"},{\"id\":\"2455\",\"title\":\"Июл\",\"description\":\"<p>1. Шумораи истифодабарандагони барномаи мобилии Alif Mobi 500 000 нафарро дар бар гирифт&nbsp;</p><p>&nbsp;</p><p>2. Бо мақсади васеъ гардонидани дастрасии аҳолӣ ба хизматрасониҳои молиявӣ ва мустаҳкамкунии бахши маблағгузории хурд дар Тоҷикистон, бо «Фонди бозтамвил» шартномаи маблағгузориро ба имзо расонидем</p>\"},{\"id\":\"2456\",\"title\":\"Август\",\"description\":\"<p>Инфрасохтори барномаи Alif Mobi-ро ба технологияҳои абрӣ гузаронида, онро комилан аз нав тарҳрезӣ кардем. Имконияти идораи насияҳо, кортҳои Visa ва фардикунониро ворид намуда, коркуниашро барои садҳо ҳазор мизоҷон бемаҳдуду гуногунзабон гардонидем</p>\"},{\"id\":\"2457\",\"title\":\"Сентябр\",\"description\":\"<p>1. Кортҳои гуногунасъори Alif Visa Gold, Platinum ва Infinite-ро бо имконияти гирифтани насия, интиқоли маблағ ва идораи пурра дар Alif Mobi таҳия намудем&nbsp;</p><p>&nbsp;</p><p>2. Дар даври навбатии сармоягузорӣ $8 млн ҳамчун сармоя ва $50 млн ҳамчун қарз ҷалб карда, дар минтақа яке аз финтех стартапҳои пешбар бо арзиши $100 млн баҳогузорӣ карда шудем&nbsp;</p><p>&nbsp;</p><p>3. Дар ҷаласаи солонаи Гурӯҳи Бонки Исломии Рушд ҳамроҳ бо 5 ширкати хориҷа сазовори ҷоизаи ICD's Global Finnovation Award 2020 шудем. Ҷоиза барои барномаи Alif Mobi ва корти насияи «Салом» тақдим карда шуд</p>\"},{\"id\":\"2458\",\"title\":\"Октябр\",\"description\":\"<p>1. Сармояи оинномавии бонкро ба маблағи 33 960 000 сомонӣ зиёд гардонидем&nbsp;</p><p>&nbsp;</p><p>2. Низоми автоматикунонидашудаи бонкии дуюмамонро дар асоси технологияҳои нав таҳия кардем</p>\"}]},{\"id\":\"532\",\"title\":\"2020\",\"content\":[{\"id\":\"2459\",\"title\":\"Январ\",\"description\":\"<p>Иҷозатномаи БМТ №0000114 гирифта, номро ба «Алиф Бонк» иваз кардем</p>\"},{\"id\":\"2460\",\"title\":\"Феврал\",\"description\":\"<p>Бонки хусусии Швейтсария CBH Bank (Compagnie Bancaire Helvétique SA) аз мо ҳиссаро харид кард ва соҳибҳисса шуд</p>\"},{\"id\":\"2461\",\"title\":\"Апрел\",\"description\":\"<p>Мактаби барномасозии Алиф Академия кушодем, дар он ҷо ҳамаи хоҳишмандон метавонанд забони JavaScript-ро омӯзанд</p>\"},{\"id\":\"2462\",\"title\":\"Июнь\",\"description\":\"<p>Агентии рейтингии MicroFinanza Rating (Итолиё) ба мо дараҷаи молиявии BBB Stable тақдим кард</p>\"},{\"id\":\"2463\",\"title\":\"Сентябр\",\"description\":\"<p>Дар номиятсияи Fastest Growing Retail Bank Tajikistan 2020 аз рӯи Global Banking &amp; Finance ғолиб омадем</p>\"}]},{\"id\":\"533\",\"title\":\"2019\",\"content\":[{\"id\":\"2464\",\"title\":\"Август\",\"description\":\"<p>Дар Хуҷанд якум шартномаи автокредитро бо мизоҷамон бастем</p>\"},{\"id\":\"2465\",\"title\":\"Сентябр\",\"description\":\"<p>Маркази омӯзишии ройгонро кушодем</p>\"},{\"id\":\"2466\",\"title\":\"Октябр\",\"description\":\"<p>Аз Кумитаи андози Ҷумҳурии Тоҷикистон барои иҷрои софдилонаи қонунгузории андоз ва саҳми назаррас дар қисми даромади буҷети давлатӣ, ифтихорнома гирифтем</p>\"},{\"id\":\"2467\",\"title\":\"Ноябр\",\"description\":\"<p>Маблағгузории соҳибкори тоҷик — Хофиз Шахидиро аз Монако бомуваффақият ҷалб намудем. Дар натиҷаи гуфтушунид, Шахидӣ соҳиби 25% саҳмияҳо гардида, ба мақоми раиси Шӯрои директорон мушарраф шуд. Маблағҳои ҷамъшуда ба мо имкон доданд, ки барои гирифтани иҷозатномаи пурраи бонкӣ ариза пешниҳод намоем</p>\"},{\"id\":\"2468\",\"title\":\"Декабр\",\"description\":\"<p>Сазовори ҷоизаи тиллоии «Бренди сол — 2019. Қуллаи шараф» гардидем</p>\"}]},{\"id\":\"534\",\"title\":\"2018\",\"content\":[{\"id\":\"2469\",\"title\":\"Январ\",\"description\":\"<p>1. Аввалин барномаи мобилӣ, Alif Mobi-ро таҳия кардем, ки имрӯз барномаи бузургтарин ва васеъ истифодашавандаи кишвар ба ҳисоб меравад&nbsp;</p><p>&nbsp;</p><p>2. Аъзои низоми байналмилалии интиқоли маблағҳо шудем</p>\"},{\"id\":\"2470\",\"title\":\"Март\",\"description\":\"<p>Корти овердрафти «Насия»-ро бо насия ба муҳлати 10 рӯз таҳия кардем</p>\"},{\"id\":\"2471\",\"title\":\"Август\",\"description\":\"<p>Корти «Салом»-ро таҳия кардем, ки ба мизоҷон имконият медиҳад, молҳоро дар вақти кӯтоҳ ба насия гиранд. Барои истифодаи ин корт Алиф таъминоти барномавиро таҳия намуд, ки смартфонҳои оддиро ба POS-терминалҳо табдил медиҳад. Тоҷирон онро барои фурӯши мол бо корти «Салом» истифода мебаранд</p>\"},{\"id\":\"2472\",\"title\":\"Октябр\",\"description\":\"<p>Сайти online.alif.tj-ро омода намудем, ки дар он мизоҷон амалиёти бонкии худро назорат карда метавонанд</p>\"}]},{\"id\":\"535\",\"title\":\"2017\",\"content\":[{\"id\":\"2473\",\"title\":\"Январ\",\"description\":\"<p>Низоми автоматикунонидашудаи бонкии (АБС) худро ба роҳ мондем, ки дар дохили ширкат навишта шудааст. Низоми автоматикунонидашудаи бонкӣ барномаи хеле мураккаб буда, одатан аз ҷониби бонкҳои дигар аз ширкатҳои хориҷӣ харидорӣ карда мешавад. Мо дар Алиф бо таҳия ва роҳандозии системаи бонкии худ, қадами муҳимеро дар самти табдил ёфтан ба ширкати технологӣ гузоштем</p>\"},{\"id\":\"2474\",\"title\":\"Март\",\"description\":\"<p>Ба Маркази миллии протсессингӣ ворид шуда, пешниҳоди «Корти миллӣ»-ро ба мизоҷон оғоз кардем</p>\"},{\"id\":\"2475\",\"title\":\"Июн\",\"description\":\"<p>Аввалин онлайн-мағоза, Alif Shop-ро дар кишвар ба роҳ мондем, ки дар он мизоҷон метавонанд молҳоро ба насия дастрас намоянд. Баъдтар, Alif Shop калонтарин онлайн-бозори B2C дар Тоҷикистон гардид</p>\"},{\"id\":\"2476\",\"title\":\"Август\",\"description\":\"<p>Алиф Академияро кушода, курсҳои ройгони барномасозӣ ба роҳ мондем</p>\"},{\"id\":\"2477\",\"title\":\"Октябр\",\"description\":\"<p>Дар Хуҷанд маркази хизматрасонии бонкиро кушодем</p>\"},{\"id\":\"2478\",\"title\":\"Ноябр\",\"description\":\"<p>Дар кишвар аввалин платформаи онлайн-эквайринг, alif pay-ро сохтем, ки ба мизоҷон имконияти онлайн пардохт кардани хизматрасониҳо бо «Корти миллӣ»-ро медиҳад. Системае, ки Алиф истифода мебарад, дертар аз ҷониби дигар бонкҳо васеъ қабул карда шуд, ки давраи рушди босуръати технологияро дар кишвар оғоз намуд</p>\"}]},{\"id\":\"536\",\"title\":\"2016\",\"content\":[{\"id\":\"2479\",\"title\":\"Феврал\",\"description\":\"<p>Хизматрасонии «Бефоиз»-ро таҳия карда, насияи аввалинро пешниҳод кардем</p>\"},{\"id\":\"2480\",\"title\":\"Март\",\"description\":\"<p>Иҷозатномаи ТАҚХ — ташкилоти хурди қарздиҳӣ ва амонатиро аз тарафи Бонки миллии Тоҷикистон гирифтем. Аз ҳамон вақт Алиф ҳуқуқ дорад, ки амонат кушояд, амалиёти мубодилавӣ дар дохили кишвар ва берун аз он дошта бошад. Инчунин метавонад, ки хизматрасониҳои васеи молиявиро ба мизоҷон пешниҳод намояд</p>\"},{\"id\":\"2481\",\"title\":\"Апрел\",\"description\":\"<p>Аввалин суратҳисоби депозитиро кушодем</p>\"}]},{\"id\":\"537\",\"title\":\"2015\",\"content\":[{\"id\":\"2482\",\"title\":\"Октябр\",\"description\":\"<p>Аввалин барномаи хусусии идоракунии муносибатҳо бо муштариёнро (CRM) тарҳрезӣ карда, соли 2016 ба роҳ мондем</p>\"}]},{\"id\":\"538\",\"title\":\"2014\",\"content\":[{\"id\":\"2483\",\"title\":\"Апрел\",\"description\":\"<p>Барои хизматрасониҳои қарздиҳии хурд аз Бонки миллии Тоҷикистон иҷозатнома гирифта, аввалин шартномаи автокредитро бастем</p>\"},{\"id\":\"2484\",\"title\":\"Июн\",\"description\":\"<p>Аввалин бор қарз (сармоягузорӣ) ҷалб намудем</p>\"}]}]},\"projects\":{\"id\":\"14\",\"title\":\"Хизматрасониҳо ва лоиҳаҳо\",\"projectCards\":[{\"id\":\"2239\",\"backgroundColor\":\" #F7F8F9\",\"color\":\"#222222\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Молҳоро ҳозир харида, маблағашонро кам-кам супоред.</p>\",\"header\":\"Корти «Салом»\",\"isActive\":true,\"link\":\"/salom\",\"desktopImage\":{\"documentId\":\"s1e28akutuv0fstu5c859zq0\",\"alternativeText\":\"карта Салом от Алиф \",\"name\":\"salommini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/salommini_7a51f7b1f4.png\"},\"mobileImage\":null},{\"id\":\"2240\",\"backgroundColor\":\"#262729\",\"color\":\"#FFFFFF\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Маблағ фиристед, онлайн пардохт кунед ва аз харидҳо дар хориҷа тахфиф гиред.</p>\",\"header\":\"Кортҳои Visa\",\"isActive\":true,\"link\":\"/cards/visa\",\"desktopImage\":{\"documentId\":\"vaf5834ly3g71e5fwpxnurrd\",\"alternativeText\":\"карты Visa от Алиф \",\"name\":\"visamini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/visamini_a1692fc9d7.png\"},\"mobileImage\":null},{\"id\":\"2241\",\"backgroundColor\":\"#E7FFF5\",\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Зиёда аз 1 миллион нафар Alif-ро барномаи қулай мешуморанд.</p>\",\"header\":\"Барномаи Alif\",\"isActive\":true,\"link\":\"/mobi\",\"desktopImage\":{\"documentId\":\"rniu2f1aeux076sfydcdiisg\",\"alternativeText\":\"Приложение Алиф\",\"name\":\"моби карточка.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/mobi_kartochka_e99c2d6c7b.png\"},\"mobileImage\":null},{\"id\":\"2242\",\"backgroundColor\":\" #FBF8F4\",\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Ҳамаи молҳоро баҳузур аз ҷои нишаст бихаред.</p>\",\"header\":\"alifshop.tj\",\"isActive\":true,\"link\":\"https://alifshop.tj/\",\"desktopImage\":{\"documentId\":\"vz4gbyei66ate4r7qzjbnr8x\",\"alternativeText\":\"Алиф шоп\",\"name\":\"shopmini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/shopmini_07a67caf19.png\"},\"mobileImage\":null},{\"id\":\"2243\",\"backgroundColor\":\" #FFF7EE\",\"color\":\"#222222\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Пулро фиристед ва дар мағозаҳои хориҷа ва интернет пардохт кунед</p>\",\"header\":\"Корти Mastercard\",\"isActive\":true,\"link\":\"/cards/mastercard\",\"desktopImage\":{\"documentId\":\"bcfpude8kgmi5j6e64p0xkwz\",\"alternativeText\":\"Mastercard Platinum от Алиф\",\"name\":\"Mastercard card.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/Mastercard_card_4af6384808.png\"},\"mobileImage\":null},{\"id\":\"2244\",\"backgroundColor\":\"#E8F7EB\",\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Бо кумаки Алиф соҳиби мошини орзуятон шавед.</p>\",\"header\":\"Хариди мошин\",\"isActive\":true,\"link\":\"/auto/cars\",\"desktopImage\":{\"documentId\":\"j8xiyokecwq93k8esbfn6ubf\",\"alternativeText\":\"Покупка авто от Алиф Банк\",\"name\":\"automini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/automini_7987b3d802.png\"},\"mobileImage\":null},{\"id\":\"2245\",\"backgroundColor\":\"#F4F6FA\",\"color\":\"#333333\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Маблағро аз Россия бе комиссия қабул намоед.</p>\",\"header\":\"«Корти миллӣ»\",\"isActive\":true,\"link\":\"/cards/korti-milli\",\"desktopImage\":{\"documentId\":\"ru9nl853q97zbh6srcarsxjh\",\"alternativeText\":\"Корти милли от Алиф\",\"name\":\"kmmini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/kmmini_693d94e89b.png\"},\"mobileImage\":null},{\"id\":\"2246\",\"backgroundColor\":\" #222222\",\"color\":\" #FFFFFF\",\"buttonLabel\":null,\"buttonColor\":null,\"buttonVariant\":null,\"description\":\"<p>Кумак мерасонем, то ки тиҷорати худро рушд диҳед.</p>\",\"header\":\" Alif Business \",\"isActive\":true,\"link\":\"/business/alif-business\",\"desktopImage\":{\"documentId\":\"nwe7ukx0qdsr279k490cin73\",\"alternativeText\":\"Alif Business\",\"name\":\"businessmini.png\",\"width\":264,\"height\":200,\"url\":\"/uploads/businessmini_7f3f89eed6.png\"},\"mobileImage\":null}]},\"locales\":[\"tg\",\"ru\",\"en\"],\"locale\":\"tg\"},\"__N_SSG\":true}"
