_0de44a884e.svg\"}},{\"id\":\"148\",\"link\":\"https://www.tiktok.com/@alifbank.tj?_t=8kdw6q9I3ne&_r=1\",\"image\":{\"documentId\":\"jcgn3jgpje12780g4y2po4yh\",\"alternativeText\":null,\"name\":\"Tik tok.svg\",\"width\":40,\"height\":40,\"url\":\"/uploads/Tik_tok_2d07d4f570.svg\"}}],\"menu\":[{\"id\":\"472\",\"label\":\"Дар бораи мо\",\"link\":\"/tg/bank/about-us\"},{\"id\":\"473\",\"label\":\"Суроғаҳо ва реҷаи корӣ\",\"link\":\"/bank/contacts/offices/dushanbe?city=1\"},{\"id\":\"474\",\"label\":\"Ҳуҷҷатҳо ва тарофаҳо\",\"link\":\"/tg/bank/documents\"},{\"id\":\"475\",\"label\":\"Ҷойҳои кор\",\"link\":\"https://job.alif.tj/about\"},{\"id\":\"476\",\"label\":\"Ҳуқуқҳои муштарӣ\",\"link\":\"/bank/help\"}],\"mobileMobiLink\":{\"link\":\"https://alf.tj/alifapp\",\"title\":\"Alif\",\"description\":\"Ҳамёни мобилӣ\",\"image\":{\"documentId\":\"t8mhqze5ke979p7tqemms6ii\",\"alternativeText\":\"Frame 184.svg\",\"name\":\"Frame 184.svg\",\"width\":null,\"height\":null,\"url\":\"/uploads/Frame_184_e3848b14a9.svg\"}},\"copyright\":\"© 2026 ҶСК «Алиф Бонк»\",\"license\":\"Иҷозатномаи БМТ №0000114 аз 03.01.2020\",\"depositInsuranceFund\":\"ҶСК «Алиф Бонк» узви Хазинаи суғуртаи амонату пасандозҳои Тоҷикистон мебошад\",\"labelMobiLinks\":\"Ҳамёни мобилӣ\",\"labelSocialLinks\":\"Шабакаҳои иҷтимоӣ\",\"logo\":{\"documentId\":\"opypn6mwijq5zsy07fyr1tes\",\"alternativeText\":\"Alif Products Logo.svg\",\"name\":\"Alif Products Logo.svg\",\"width\":null,\"height\":null,\"url\":\"/uploads/Alif_Products_Logo_e0b63c960b.svg\"},\"lastUpdate\":{\"updateTitle\":\"Навсозӣ шуд\",\"updateDate\":\"2026-11-05T12:30:00.000Z\",\"isActive\":true}},\"ogImage\":{\"documentId\":\"rgryhdgos8cc4dtnz2mclh24\",\"alternativeText\":null,\"name\":\"alif bank og.png\",\"width\":1288,\"height\":529,\"url\":\"/uploads/alif_bank_og_e360356dbe.png\"}},\"depositAndAccountsTitle\":\"Амонат ва ҳисобҳо \",\"seo\":{\"title\":\"Амонатҳо дар Тоҷикистон | Алиф\",\"description\":\"«Мақсад», «Муҳлатнок» ва суратҳисобҳо барои нигоҳ доштани пул ва зиёд кардани даромад. Ҳисобкунаки даромад онлайн дастрас аст.\",\"keywords\":null,\"themeColor\":null,\"canonicalLink\":\"https://alif.tj/tg/deposit\",\"favicon\":{\"documentId\":\"xsh7wb1596vjcagbviawz8st\",\"alternativeText\":\"Alif sign.svg\",\"name\":\"Alif sign.svg\",\"width\":1080,\"height\":1080,\"url\":\"/uploads/Alif_sign_a8a4fd79e9.svg\"},\"ogImage\":null},\"faq\":{\"title\":\"Ҷавоб ба саволҳои муҳим\",\"content\":[{\"id\":\"340\",\"title\":\"Амонатро онлайн кушодан мумкин аст?\",\"description\":\"<p>&nbsp;Бале, агар шумо шартномаи хизматрасонии комплексиро имзо кардагӣ бошед.</p><p>Барои ин:</p><p>— барномаи Alif-ро нав кунед;</p><p>— дар экрани асосӣ <strong>«Бонк»</strong> → <strong>«Амонатҳо ва ҳисобҳо»</strong>-ро интихоб кунед;</p><p>— варианти мувофиқро интихоб намуда, <strong>«Кушодани ҳисоб»</strong>-ро пахш кунед.<br>&nbsp;</p>\"},{\"id\":\"343\",\"title\":\"Амалиётҳои амонатиро онлайн гузарондан мумкин аст?\",\"description\":\"<p>Бале, мумкин аст. Дар барномаи Alif дар бахши <strong>«Байни ҳисобҳо»</strong> шумо метавонед:</p><p>— ҳисобро пур кунед;</p><p>— маблағро ба кортҳои худ гузаронед ва баръакс.</p><p>&nbsp;</p><p>Дар бахши <strong>«Бонк»</strong> → <strong>«Амонатҳо ва ҳисобҳо»</strong> инчунин метавонед:<br>ҳисобро пур кунед;</p><p>— маблағро байни ҳисобҳои худ интиқол диҳед;</p><p>— аз ҳисоби амонат насияро пардохт кунед;</p><p>— асъор бихаред.</p><p>&nbsp;</p><p>Дар ҳамин бахш метавонед таърихи амалиётҳо, пуркуниҳо, хароҷот ва маълумот дар бораи ҳисобро бинед.</p>\"},{\"id\":\"342\",\"title\":\"Депозитро бо кадом асъор кушодан мумкин аст?\",\"description\":\"<p>Айни ҳол ду намуди амонат ҳаст —<strong> «Мақсад» </strong>ва <strong>«Муҳлатнок»</strong>: онҳоро ҳам бо сомонӣ ва ҳам бо доллари ИМА кушодан мумкин аст.</p><p>&nbsp;</p><p><strong>«Мақсад»</strong> — то 11% бо сомонӣ ва то 5% бо доллар. Муҳлат — 1 сол. Ҳисобро метавонед дилхоҳ вақт пур кунед ё маблағро гиред — маҳдудият нест.</p><p>&nbsp;</p><p><strong>«Муҳлатнок»</strong> — то 16% дар сомонӣ ва то 7% дар доллар. Муҳлат — 1 сол. Пур кардан ва гирифтани маблағ маҳдудият дорад, вале даромад бештар аст.</p><p>&nbsp;</p><p><i><strong>«Дилхоҳ вақт»</strong> танҳо барои мизоҷоне дастрас аст, ки пештар ин амонатро кушода буданд ва муҳлаташон ҳанӯз ба охир нарасидааст. Айни ҳол танҳо ду намуди амонат дастрасанд.</i></p>\"},{\"id\":\"344\",\"title\":\"Камтарин маблағ барои кушодани амонат чанд аст?\",\"description\":\"<p>Амонатро метавонед аз 1 сомонӣ ё 1 доллари ИМА кушоед. Маълумоти бештарро метавонед дар <a href=\\\"https://alif.tj/deposit\\\">ин ҷо</a> пайдо кунед.</p>\"},{\"id\":\"345\",\"title\":\"Агар пулро пешакӣ гирам, чӣ мешавад?\",\"description\":\"<p><strong>Амонати «Мақсад»</strong> — маблағро метавонед дилхоҳ вақт гиред ё ҳисобро пур кунед. Ҳамаи фоизҳои ҳисобшуда нигоҳ дошта мешаванд.</p><p>&nbsp;</p><p><strong>Амонати «Муҳлатнок»</strong> — маблағи асосиро пешакӣ гирифта намешавад. Агар амонат пешакӣ маҳкам шавад, танҳо маблағи асосӣ баргардонида мешавад ва тамоми фоида аз байн меравад. Вале фоизҳое, ки бонк мунтазам пардохт мекунад, метавонед дилхоҳ вақт гиред.</p>\"},{\"id\":\"346\",\"title\":\"Ҳангоми гирифтани маблағ аз амонате, ки ғайринақдӣ пур шудааст, комиссия чӣ қадар аст?\",\"description\":\"<p>Бо доллари ИМА — <strong>0,9%</strong>, агар маблағ дар давоми 90 рӯз гирифта шавад; баъд аз 90 рӯз комиссия гирифта намешавад.</p><p>&nbsp;</p><p>Бо сомонӣ — <strong>0,9%</strong>, агар маблағ дар давоми 30 рӯз гирифта шавад; баъд аз 30 рӯз комиссия гирифта намешавад.</p>\"},{\"id\":\"951\",\"title\":\"Кадом андоз аз даромади амонат нигоҳ дошта мешавад?\",\"description\":\"<p>Мувофиқи қонунгузории андоз (моддаҳои 236 ва 238-и Кодекси андози ҶТ), бонк ҳамчун агенти андоз <strong>12%-и даромади амонатро нигоҳ медорад.</strong><br>&nbsp;</p><p>Андоз ҳар моҳ нигоҳ дошта мешавад, фоидаи соф барои гирифтани маблағ дастрас аст:</p><p>— тавассути барномаи Alif ба кортҳои «Корти миллӣ», Visa ва Mastercard;</p><p>— дар хазинаҳои бонк.</p>\"},{\"id\":\"950\",\"title\":\"Агар амонат дар гарав бошад, даромад ба он меояд?\",\"description\":\"<p>Бале. Ҳатто агар амонат дар гарав бошад, даромад мисли ҳарвақта мегузарад.</p>\"}]},\"depositTypeCard\":[{\"desktopImage\":{\"documentId\":\"oujmf423pxsg5gfhgvvfzptt\",\"alternativeText\":\"Вклад Максад: до 11% в сомони, до 5% в долларах, срок 1 год, сумма от 1 сомони\",\"name\":\"максад.png\",\"width\":400,\"height\":360,\"url\":\"/uploads/maksad_b4d1f04990.png\"},\"mobileImage\":{\"documentId\":\"nvn61t4a3pdn6d3yyvqenlpz\",\"alternativeText\":\"Вклад Максад: до 11% в сомони, до 5% в долларах, срок 1 год, сумма от 1 сомони\",\"name\":\"максад моб.png\",\"width\":276,\"height\":171,\"url\":\"/uploads/maksad_mob_6c44404765.png\"},\"id\":\"31\",\"buttonAnchorLink\":\"/deposit/maqsad#consultationDeposit\",\"buttonLabel\":\"Амонат гузоштан\",\"backgroundColor\":\"#F7F8F9\",\"color\":\"#222222\",\"detailLabel\":\"Бештар\",\"detailLabelLink\":\"/deposit/maqsad\",\"detailLabelColor\":\"#00AF66\",\"depositDetailsTitlesColor\":null,\"detailsSeparatorColor\":\"#E8F7EB\",\"depositDetails\":{\"title\":\"«Мақсад»\",\"content\":[{\"id\":\"779\",\"title\":\"Даромад бо сом.\",\"description\":\"<p>то 11%</p>\"},{\"id\":\"781\",\"title\":\"Даромад бо долл.\",\"description\":\"<p>то 5%</p>\"},{\"id\":\"780\",\"title\":\"Муҳлат\",\"description\":\"<p>1 сол</p>\"},{\"id\":\"782\",\"title\":\"Маблағ\",\"description\":\"<p>аз 1 с.</p>\"}]}},{\"desktopImage\":{\"documentId\":\"ote83ucqzf6qhutrgeto9keu\",\"alternativeText\":\"Вклад Мухлатнок: до 16% в сомони, до 7% в долларах, срок 1 год, сумма от 1 сомони\",\"name\":\"мухлатнок.png\",\"width\":400,\"height\":360,\"url\":\"/uploads/muhlatnok_2e951b9fb4.png\"},\"mobileImage\":{\"documentId\":\"wl1rcgveaaf2ky8rcgairccr\",\"alternativeText\":\"Вклад Мухлатнок: до 16% в сомони, до 7% в долларах, срок 1 год, сумма от 1 сомони\",\"name\":\"мухлатнок моб.png\",\"width\":276,\"height\":171,\"url\":\"/uploads/muhlatnok_mob_dc0