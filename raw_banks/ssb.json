        "url": "https://webapi.ssb.tj/api/Talk/?language_id=1",
        "body": "{\"count\":5,\"next\":null,\"previous\":null,\"results\":[{\"id\":1,\"title\":\"Солҳои 2022-2026 «Солҳои рушди саноат»\",\"content\":\"Системаи саноатикунонии ҳар як кишвар бояд тартиби мантиқӣ дошта бошад. Афзудани маҳсулоти кишоварзӣ ва ба он мувофиқ кардани системаи фаъоли корхонаҳои саноатӣ ҷиҳати коркарди пурраи он дар дохили кишвар барои содирот, инчунин кам кардани маҳсулоти воридотӣ, қадамҳои устувори тақвият додани саноат, истеҳсолот ва рушди босамари иқтисодиёт аст.\",\"photo\":\"https://webapi.ssb.tj/media/president.png\",\"author\":\"Эмомалӣ Раҳмон\",\"created_at\":\"2022-12-26T14:07:45Z\",\"updated_at\":\"2022-12-26T14:07:45Z\",\"language_id\":1,\"container_id\":114},{\"id\":4,\"title\":\"test\",\"content\":\"test\",\"photo\":\"https://webapi.ssb.tj/media/car.jpg\",\"author\":\"test\",\"created_at\":\"2023-08-17T04:54:39.375083Z\",\"updated_at\":\"2023-08-17T04:54:39.375122Z\",\"language_id\":1,\"container_id\":1234},{\"id\":5,\"title\":\"testtest\",\"content\":\"test\",\"photo\":\"https://webapi.ssb.tj/media/test.jpg\",\"author\":\"teststse\",\"created_at\":\"2023-08-17T09:35:51.770614Z\",\"updated_at\":\"2023-08-17T09:35:51.770646Z\",\"language_id\":1,\"container_id\":1234},{\"id\":6,\"title\":\"test\",\"content\":\"test\",\"photo\":\"https://webapi.ssb.tj/media/Screenshot_from_2023-08-21_14-33-10_IR6mDX3.png\",\"author\":\"test\",\"created_at\":\"2023-08-21T10:34:36.544007Z\",\"updated_at\":\"2023-08-21T10:34:36.544092Z\",\"language_id\":1,\"container_id\":1234},{\"id\":7,\"title\":\"test\",\"content\":\"tests\",\"photo\":\"https://webapi.ssb.tj/media/ASFAFASFA.jpeg\",\"author\":\"setse\",\"created_at\":\"2023-08-21T12:38:09.153534Z\",\"updated_at\":\"2023-08-21T12:38:09.153562Z\",\"language_id\":1,\"container_id\":1234}]}"
